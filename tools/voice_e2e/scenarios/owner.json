{
 "group": "owner",
 "about": "The owner's song scenario (docs/design/TOUCHLESS_BROWSING.md §2), with \"Hey Molt\" and in always-listening mode, and its variant that plays the fourth result by number.",
 "scenarios": [
  {
   "id": "owner-song",
   "title": "Open YouTube, search, play the live one by Queen, then louder, pause, skip, full screen, back",
   "task": "owner",
   "modes": ["wake", "always"],
   "start": {"url": "about:blank"},
   "steps": [
    {"say": "open YouTube", "needs": ["open_site"],
     "expect": [{"host": "www.youtube.com"}, {"path": "/"}, {"said": "YouTube is open."}]},
    {"say": "search for Bohemian Rhapsody", "needs": ["search"],
     "expect": [{"path": "/results"}, {"query": {"search_query": ["Bohemian Rhapsody", "Bohemian rapsody", "Bohemium repsidy"]}},
                {"said_re": "^20 results\\."}]},
    {"say": "play the live one by Queen", "needs": ["choose"],
     "expect": [{"path": "/results"}, {"said_has": "Did you mean"}]},
    {"say": "the Live Aid one", "answer": true,
     "expect": [{"query": {"v": "video4"}}, {"media": {"paused": false, "muted": false}},
                {"said": "Playing Queen - Bohemian Rhapsody (Live Aid 1985)."}]},
    {"say": "louder", "needs": ["volume_up"], "expect": [{"media": {"volume": [0.72, 1.0]}}]},
    {"say": "pause", "needs": ["pause"], "expect": [{"media": {"paused": true}}]},
    {"say": "skip ahead one minute", "needs": ["skip_forward"],
     "expect": [{"media": {"time_min": 55}}]},
    {"say": "full screen", "needs": ["full_screen"], "expect": [{"media": {"fullscreen": true}}]},
    {"say": "exit full screen", "needs": ["exit_full_screen"],
     "expect": [{"media": {"fullscreen": false}}]},
    {"say": "go back", "needs": ["back"], "expect": [{"path": "/results"}]}
   ]
  },
  {
   "id": "owner-song-fourth",
   "title": "Open YouTube, search, play the fourth one by number",
   "task": "owner",
   "start": {"url": "about:blank"},
   "steps": [
    {"say": "open YouTube", "needs": ["open_site"], "expect": [{"host": "www.youtube.com"}]},
    {"say": "search for Bohemian Rhapsody", "needs": ["search"],
     "expect": [{"path": "/results"}, {"said_re": "^20 results\\."}]},
    {"say": "play the fourth one", "needs": ["choose"],
     "expect": [{"query": {"v": "video4"}}, {"media": {"paused": false, "muted": false}}]},
    {"say": "pause", "needs": ["pause"], "expect": [{"media": {"paused": true}}]}
   ]
  }
 ]
}
