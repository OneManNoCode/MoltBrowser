#
# MoltBrowser fingerprinting protection, Blink side (see
# molt_fingerprinting.h and docs/FINGERPRINTING.md).
#
#   :farbling   - the pure math (key derivation, PRF, pixel/audio noise,
#                 letterbox buckets) and the font allow-lists and matcher
#                 (fonts.h). Depends only on //base and //crypto, so it is
#                 linked into Blink core *and* tested standalone.
#   build.gni   - the Blink glue (molt_fingerprinting.{h,cc}), compiled into
#                 the core component like every other core subdirectory.

import("//testing/libfuzzer/fuzzer_test.gni")

source_set("farbling") {
  sources = [
    "farbling.cc",
    "farbling.h",
    "webgl_uniform.cc",
    "webgl_uniform.h",
    "font_allowlists.cc",
    "font_allowlists.h",
    "fonts.cc",
    "fonts.h",
    "moltnet_values.cc",
    "moltnet_values.h",
    "moltnet_device_values.cc",
    "moltnet_device_values.h",
    "moltnet_text_values.cc",
    "moltnet_text_values.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//crypto" ]
  visibility = [
    ":*",
    "//chrome/browser/molt_ai/test:*",
    "//third_party/blink/renderer/core:*",

    # Its test checks the browser's letterbox steps against Blink's.
    "//chrome/browser/molt_ai/fingerprinting:unit_tests",

    # Its test checks MoltNet's default fonts against the allow-lists.
    "//chrome/browser/molt_ai/tor:unit_tests",
  ]
}

# Pure-logic tests. Linked into blink_unittests (through
# //third_party/blink/renderer/core:unit_tests) and into the lightweight
# molt_ai_unittests binary (//chrome/browser/molt_ai/test).
source_set("unit_tests") {
  testonly = true
  sources = [
    "farbling_unittest.cc",
    "webgl_uniform_unittest.cc",
    "fonts_unittest.cc",
    "moltnet_values_unittest.cc",
    "moltnet_device_values_unittest.cc",
    "moltnet_text_values_unittest.cc",
  ]
  deps = [
    ":farbling",
    "//base",
    "//testing/gtest",
  ]
}

# The pixel, audio and font-name rules on what a page reads back and asks
# for (docs/FUZZING.md). Reached from //chrome/browser/molt_ai/fuzzers.
fuzzer_test("molt_farbling_fuzzer") {
  sources = [ "molt_farbling_fuzzer.cc" ]
  deps = [
    ":farbling",
    "//base",
  ]
  seed_corpus = "corpus/molt_farbling_fuzzer"
  libfuzzer_options = [ "max_len=8192" ]
}
