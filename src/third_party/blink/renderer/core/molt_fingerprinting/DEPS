include_rules = [
    "+base/check.h",
    "+base/compiler_specific.h",
    "+base/containers/span.h",
    "+base/no_destructor.h",
    "+base/numerics/checked_math.h",
    "+base/numerics/safe_conversions.h",
    "+base/synchronization/lock.h",
    "+build/build_config.h",
    "+crypto/hmac.h",
    "+crypto/random.h",
    # WebGL2 readPixels into a PIXEL_PACK buffer: read back, farble, write
    # back. The interface reaches core through platform's public deps.
    "+gpu/command_buffer/client/gles2_interface.h",
    "+ui/gfx/skia_span_util.h",
    # MoltNet's encoders (moltnet_encoders.h).
    "+media/base/media_types.h",
    "+media/base/supported_types.h",
    "+media/base/video_codecs.h",
    "+media/base/video_encoder.h",
    # MoltNet's media pixels and encoded bytes (moltnet_pixels.h).
    "+media/base/molt_portable_media.h",
    # measureUserAgentSpecificMemory()'s entries (moltnet_memory.h).
    "+base/byte_size.h",
    "+components/performance_manager/public/mojom/web_memory.mojom-blink.h",
    "+components/performance_manager/public/mojom/web_memory.mojom-blink-forward.h",
]

specific_include_rules = {
  # MoltNet's bundled fonts, mapped from the read-only files the browser
  # sends (moltnet_fonts.h).
  "moltnet_fonts(_test)?\.(cc|h)": [
    "+base/files/memory_mapped_file.h",
    "+base/files/scoped_temp_dir.h",
    "+base/files/file_util.h",
    # Font caches of every thread that looked a font up before the files
    # came are invalidated on that thread.
    "+base/functional/callback.h",
  ],
  # The machine V8 and skcms run as in MoltNet, set before V8 starts
  # (moltnet_cpu.h), as bindings/core/v8 and the image decoders reach them.
  "moltnet_cpu(_test)?\.cc": [
    "+gin/public/isolate_holder.h",
    "+third_party/skia/include/core/SkGraphics.h",
    "+third_party/skia/modules/skcms/skcms.h",
  ],
  # MoltNet's audio clock (moltnet_audio_*): the media sinks, clock and
  # resampler Web Audio and media playback render through, as
  # platform/audio and modules/media/audio use them.
  "moltnet_audio_(device|output|sink)(_test)?\.(cc|h)": [
    "+base/functional/callback.h",
    "+base/memory/raw_ptr.h",
    "+media/audio/audio_device_description.h",
    "+media/base/audio_bus.h",
    "+media/base/audio_glitch_info.h",
    "+media/base/audio_latency.h",
    "+media/base/audio_parameters.h",
    "+media/base/audio_renderer_sink.h",
    "+media/base/audio_timestamp_helper.h",
    "+media/base/channel_layout.h",
    "+media/base/fake_audio_worker.h",
    "+media/base/multi_channel_resampler.h",
    "+media/base/output_device_info.h",
    "+media/base/sinc_resampler.h",
  ],
}
