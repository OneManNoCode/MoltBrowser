# BUILD.gn wrapper for llama.cpp (MIT License)
# Source: https://github.com/ggerganov/llama.cpp
#
# This wraps the llama.cpp C/C++ sources into Chromium's GN build system.
# llama.cpp provides the core LLM inference engine for MoltBrowser.
#
# Note: Some source files share the same basename (e.g. ggml.c / ggml.cpp,
# ggml-cpu.c / ggml-cpu.cpp, multiple quants.c). These are split into
# separate source_sets to avoid GN duplicate .o file errors.

import("//third_party/llama_cpp/llama_cpp.gni")

config("llama_cpp_config") {
  include_dirs = [
    ".",
    "include",
    "ggml/include",
    "ggml/src",
    "ggml/src/ggml-cpu",
    "common",
    "src",
  ]

  defines = [
    "GGML_USE_CPU",
    "NDEBUG",
  ]

  if (is_mac) {
    defines += [
      "GGML_USE_METAL",
      "GGML_METAL_NDEBUG",
    ]
    frameworks = [
      "Foundation.framework",
      "Metal.framework",
      "MetalKit.framework",
      "Accelerate.framework",
    ]
  }
}

# ggml/src/ggml.c includes "ggml-version.h" and src/llama.cpp includes
# "llama-version.h"; upstream CMake generates both from the *.h.in templates
# next to those files. chromium/ holds checked-in equivalents with the values
# for the vendored tag; update them (and README.chromium) with every llama.cpp
# update. Private to this file so the version macros don't leak to dependents.
config("llama_cpp_version_headers") {
  visibility = [ ":*" ]
  include_dirs = [ "chromium" ]
}

# CFI: Chromium's official Linux x64 build (configs/linux-x64.gn sets
# is_official_build) turns on Control Flow Integrity with indirect-call checks
# (use_cfi_icall). ggml calls its per-type kernels through generic function
# pointer types (ggml_vec_dot_t, ggml_from_float_t, ...) that do not match the
# kernels' own types (e.g. ggml_vec_dot_f16 takes non-const ggml_fp16_t *,
# ggml_vec_dot_t passes const void *), so the first matmul on F16 data traps
# and takes the (inference) process down. Pointer generalization
# (cfi_icall_generalize_pointers) is not enough because the mismatch includes
# const. Exempt the whole library: a function defined in an exempt TU carries
# no CFI type info, so llama.cpp's own indirect calls into ggml (e.g. functions
# fetched with ggml_backend_reg_get_proc_address) must be exempt too. Every
# source_set below adds it; it is a no-op where CFI is off (mac, Windows,
# non-official builds).
_llama_cpp_cfi_configs = [ "//build/config/sanitizers:cfi_icall_disable" ]

# llama.cpp uses C++ exceptions which Chromium disables by default.
# Remove the global no_exceptions config and enable exceptions.
# NOTE: on Windows the toolchain is clang-cl (MSVC-compatible driver),
# where "-fexceptions" is NOT enough - clang still reports "cannot use
# 'throw' with exceptions disabled". clang-cl needs the MSVC-style /EHsc
# flag (which clang maps to -fcxx-exceptions internally). POSIX clang
# uses -fexceptions as before.
config("llama_exceptions") {
  if (is_win) {
    cflags_cc = [ "/EHsc" ]
  } else {
    cflags_cc = [ "-fexceptions" ]
    cflags_objcc = [ "-fexceptions" ]
  }
}

# MoltBrowser: llama.cpp runs only in the sandboxed on-device inference
# service (//chrome/services/molt_ai/inference, a utility process launched with
# the kOnDeviceModelExecution sandbox). Every target that compiles llama.cpp
# or ggml code is visible only to that directory (its tests live there too)
# and to this file, so browser code can't link it or include llama.h again: a
# GGUF, tokenizer or kernel bug stays inside the sandbox. See
# docs/design/SANDBOXED_INFERENCE.md.
_llama_cpp_visibility = [
  ":*",
  "//chrome/services/molt_ai/inference/*",
]

# MoltBrowser: build for Chrome's seccomp-bpf sandbox. src/llama-mmap.cpp
# doesn't pass MAP_POPULATE, which the sandbox answers with SIGSYS. See
# README.chromium.
config("llama_sandboxed") {
  defines = [ "LLAMA_MOLTBROWSER_SANDBOXED" ]
}

# MoltBrowser: compile out ggml's crash backtrace (fork + PR_SET_PTRACER +
# exec of gdb/lldb from PATH; the sandbox would also kill the process for
# it) and its process-wide std::set_terminate static initializer. See
# README.chromium.
config("ggml_no_backtrace") {
  defines = [ "GGML_MOLTBROWSER_NO_BACKTRACE" ]
}

