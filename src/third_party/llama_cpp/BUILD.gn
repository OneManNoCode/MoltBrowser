# Architecture-specific CPU sources — x86_64 (Linux/Windows desktop).
# Without these, the linker fails at the final stage with:
#   undefined symbol: quantize_row_q8_0
#   undefined symbol: ggml_vec_dot_q4_0_q8_0
# etc., because the quantized matrix-multiply implementations live in
# the architecture-specific TU.
#
# These TUs are compiled with -mavx2 -mfma -mf16c, so they raise SIGILL on
# x64 CPUs without AVX2/FMA (pre-2013 Intel, some VMs). They contain no
# static initializers (checked: no .init_array in the objects), so nothing
# runs at startup; BrowserAIRuntime::Initialize() checks base::CPU and
# refuses local models (pointing users to cloud models) before any
# llama/ggml call. TODO: real runtime dispatch — build one CPU-backend
# variant per ISA level (like ggml's GGML_CPU_ALL_VARIANTS/backend-dl) and
# pick at runtime — so older CPUs can run models too.
source_set("ggml_cpu_arch_x86") {
  sources = [
    "ggml/src/ggml-cpu/arch/x86/cpu-feats.cpp",
    "ggml/src/ggml-cpu/arch/x86/repack.cpp",
  ]

  public_configs = [ ":llama_cpp_config" ]

  cflags_cc = [
    "-std=c++17",
    "-w",
    # x86 SIMD intrinsics — match what ggml's CMakeLists enables by
    # default for x86_64 desktop CPUs.
    "-mavx2",
    "-mfma",
    "-mf16c",
    "-msse4.2",
  ]
}

# x86 C sources (quants.c would conflict with cpu quants.c)
source_set("ggml_cpu_arch_x86_c") {
  sources = [
    "ggml/src/ggml-cpu/arch/x86/quants.c",
  ]

  public_configs = [ ":llama_cpp_config" ]

  cflags_c = [
    "-std=c11",
    "-w",
    "-mavx2",
    "-mfma",
    "-mf16c",
    "-msse4.2",
  ]
}

# Metal targets — only exist on Apple platforms. The `enable_arc` config
# removal and the .m source files are macOS-specific, so the whole block
# is guarded by is_mac to keep gn-gen valid on Linux/Windows builds.
if (is_mac) {
  # Metal shader sources, bundled into the framework's Resources/. At runtime
  # ggml_metal_library_init() loads Resources/default.metallib (built from
  # these same files by scripts/release.sh and scripts/dev-install-mac.sh; the
  # shipped app needs it, run-time compilation fails under the hardened
  # runtime). Without a metallib it compiles Resources/kernels/<kind>.metal,
  # resolving includes from kernels/ and its parent directory, so keep this
  # layout: kernels/ holds the kernel sources and the headers they include,
  # ggml-common.h and ggml-metal-impl.h sit one level up.
  bundle_data("llama_cpp_metal_kernel_resources") {
    sources = [
      "ggml/src/ggml-metal/kernels/argsort.metal",
      "ggml/src/ggml-metal/kernels/binbcast.metal",
      "ggml/src/ggml-metal/kernels/common.h",
      "ggml/src/ggml-metal/kernels/conv.metal",
      "ggml/src/ggml-metal/kernels/dequantize.h",
      "ggml/src/ggml-metal/kernels/fa_aux.metal",
      "ggml/src/ggml-metal/kernels/fa_common.metal",
      "ggml/src/ggml-metal/kernels/fa_f16.metal",
      "ggml/src/ggml-metal/kernels/fa_f32.metal",
      "ggml/src/ggml-metal/kernels/fa_q4_0.metal",
      "ggml/src/ggml-metal/kernels/fa_q4_1.metal",
      "ggml/src/ggml-metal/kernels/fa_q5_0.metal",
      "ggml/src/ggml-metal/kernels/fa_q5_1.metal",
      "ggml/src/ggml-metal/kernels/fa_q8_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_common.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_f16.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_f32.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q4_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q4_1.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q5_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q5_1.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q8_0.metal",
      "ggml/src/ggml-metal/kernels/gated_delta_net.metal",
      "ggml/src/ggml-metal/kernels/misc.metal",
      "ggml/src/ggml-metal/kernels/mul_mm.metal",
      "ggml/src/ggml-metal/kernels/mul_mv.metal",
      "ggml/src/ggml-metal/kernels/mul_mv_mma.metal",
      "ggml/src/ggml-metal/kernels/norm.metal",
      "ggml/src/ggml-metal/kernels/pool.metal",
      "ggml/src/ggml-metal/kernels/quantize.h",
      "ggml/src/ggml-metal/kernels/quantize.metal",
      "ggml/src/ggml-metal/kernels/reduce.metal",
      "ggml/src/ggml-metal/kernels/rope.metal",
      "ggml/src/ggml-metal/kernels/softmax.metal",
      "ggml/src/ggml-metal/kernels/solve_tri.metal",
      "ggml/src/ggml-metal/kernels/ssm.metal",
      "ggml/src/ggml-metal/kernels/tri.metal",
      "ggml/src/ggml-metal/kernels/unary.metal",
      "ggml/src/ggml-metal/kernels/upscale.metal",
      "ggml/src/ggml-metal/kernels/wkv.metal",
    ]
    outputs = [ "{{bundle_resources_dir}}/kernels/{{source_file_part}}" ]
  }

  bundle_data("llama_cpp_metal_header_resources") {
    sources = [
      "ggml/src/ggml-common.h",
      "ggml/src/ggml-metal/ggml-metal-impl.h",
    ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }

  # Referenced from //chrome:chrome_framework (bundle_deps).
  group("llama_cpp_metal_resources") {
    public_deps = [
      ":llama_cpp_metal_header_resources",
      ":llama_cpp_metal_kernel_resources",
    ]
  }

  # Metal backend C++ sources.
  # Note: -fno-modules is needed because ggml-metal-ops.cpp uses std::swap
  # on a custom struct, and Chromium's C++ modules don't instantiate it
  # correctly across translation units.
  source_set("ggml_metal") {
    sources = [
      "ggml/src/ggml-metal/ggml-metal.cpp",
      "ggml/src/ggml-metal/ggml-metal-common.cpp",
      "ggml/src/ggml-metal/ggml-metal-device.cpp",
      "ggml/src/ggml-metal/ggml-metal-fusion.cpp",
      "ggml/src/ggml-metal/ggml-metal-ops.cpp",
      "ggml/src/ggml-metal/ggml-metal-tuning.cpp",
    ]

    public_configs = [ ":llama_cpp_config" ]

    cflags_cc = [
      "-std=c++17",
      "-w",
      "-fno-modules",
    ]
  }

  # Metal Objective-C sources (separated due to different compiler flags).
  # llama.cpp uses manual retain/release — disable Chromium's default ARC.
  source_set("ggml_metal_objc") {
    sources = [
      "ggml/src/ggml-metal/ggml-metal-device.m",
      "ggml/src/ggml-metal/ggml-metal-context.m",
    ]

    public_configs = [ ":llama_cpp_config" ]

    # Disable ARC for this third-party code that uses manual retain/release
    configs -= [ "//build/config/compiler:enable_arc" ]

    cflags_objc = [
      "-w",
      "-fno-objc-arc",
    ]
  }
}

# Combined GGML target
group("ggml") {
  public_deps = [
    ":ggml_c",
    ":ggml_cpp",
    ":ggml_cpu_c",
    ":ggml_cpu_cpp",
  ]

  if (current_cpu == "arm64") {
    public_deps += [
      ":ggml_cpu_arch_arm",
      ":ggml_cpu_arch_arm_c",
    ]
  }

  if (current_cpu == "x64") {
    public_deps += [
      ":ggml_cpu_arch_x86",
      ":ggml_cpu_arch_x86_c",
    ]
  }

  if (is_mac) {
    public_deps += [
      ":ggml_metal",
      ":ggml_metal_objc",
    ]
  }
}

