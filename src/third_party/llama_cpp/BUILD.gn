  ]

  public_deps = [
    ":ggml",
    ":llama_models",
  ]
  public_configs = [ ":llama_cpp_config" ]
  configs += _llama_cpp_cfi_configs
  configs += [
    ":llama_cpp_version_headers",
    ":llama_sandboxed",
  ]

  # Remove Chromium's global no_exceptions config and enable exceptions
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ ":llama_exceptions" ]

  cflags_cc = [
    "-std=c++17",
    "-w",
  ]
}

# MoltBrowser: the exception boundary between llama.cpp (built with
# exceptions) and the inference service (built without): every llama.cpp
# call that can reach a GPU after the model is loaded goes through
# chromium/llama_guard.h, which catches everything. With molt_llama_vulkan it
# also brings up the Vulkan backend for the service. See
# docs/design/SANDBOXED_INFERENCE.md section 11.6.
source_set("llama_guard") {
  visibility = _llama_cpp_visibility

  sources = [
    "chromium/llama_guard.cc",
    "chromium/llama_guard.h",
  ]

  public_deps = [ ":llama_cpp" ]
  configs += _llama_cpp_cfi_configs
  configs -= [ "//build/config/compiler:no_exceptions" ]
  configs += [ ":llama_exceptions" ]

  if (molt_llama_vulkan) {
    defines = [ "MOLT_LLAMA_VULKAN" ]
    deps = [ ":ggml_vulkan" ]
  }
}

# MoltBrowser: image input (docs/design/SANDBOXED_INFERENCE.md section 10).
# llama.cpp's multimodal library, tools/mtmd at the same tag: the vision
# projector loader (clip), image preprocessing (resize, normalize, tiling)
# and the projectors' graph builders. Only the library's own sources:
# mtmd-helper.cpp is NOT vendored (it decodes compressed images with
# stb_image and audio with miniaudio, and runs ffmpeg for video), so nothing
# here decodes a PNG or JPEG. Images reach the inference service as raw RGB
# pixels that the browser decoded (Chromium's sandboxed decoders) and
# checked; the service checks them again. Visible only to the inference
# service, like the rest of llama.cpp. Every mtmd_* call the service makes
# is listed, with how it handles exceptions, at the top of
