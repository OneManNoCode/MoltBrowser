# BUILD.gn wrapper for llama.cpp (MIT License)
# Source: https://github.com/ggerganov/llama.cpp
#
# This wraps the llama.cpp C/C++ sources into Chromium's GN build system.
# llama.cpp provides the core LLM inference engine for MoltBrowser.
#
# Note: Some source files share the same basename (e.g. ggml.c / ggml.cpp,
# ggml-cpu.c / ggml-cpu.cpp, multiple quants.c). These are split into
# separate source_sets to avoid GN duplicate .o file errors.

config("llama_cpp_config") {
  include_dirs = [
    ".",
    "include",
    "ggml/include",
    "ggml/src",
    "ggml/src/ggml-cpu",
    "common",
    "src",
  ]

  defines = [
    "GGML_USE_CPU",
    "NDEBUG",
  ]

  if (is_mac) {
    defines += [
      "GGML_USE_METAL",
      "GGML_METAL_NDEBUG",
    ]
    frameworks = [
      "Foundation.framework",
      "Metal.framework",
      "MetalKit.framework",
      "Accelerate.framework",
    ]
  }
}

# ggml/src/ggml.c includes "ggml-version.h" and src/llama.cpp includes
# "llama-version.h"; upstream CMake generates both from the *.h.in templates
# next to those files. chromium/ holds checked-in equivalents with the values
# for the vendored tag; update them (and README.chromium) with every llama.cpp
# update. Private to this file so the version macros don't leak to dependents.
config("llama_cpp_version_headers") {
  visibility = [ ":*" ]
  include_dirs = [ "chromium" ]
}

# llama.cpp uses C++ exceptions which Chromium disables by default.
# Remove the global no_exceptions config and enable exceptions.
# NOTE: on Windows the toolchain is clang-cl (MSVC-compatible driver),
# where "-fexceptions" is NOT enough - clang still reports "cannot use
# 'throw' with exceptions disabled". clang-cl needs the MSVC-style /EHsc
# flag (which clang maps to -fcxx-exceptions internally). POSIX clang
# uses -fexceptions as before.
config("llama_exceptions") {
  if (is_win) {
    cflags_cc = [ "/EHsc" ]
  } else {
    cflags_cc = [ "-fexceptions" ]
    cflags_objcc = [ "-fexceptions" ]
  }
}

