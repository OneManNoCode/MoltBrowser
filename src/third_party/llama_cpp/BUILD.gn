# Architecture-specific CPU sources — x86_64 (Linux/Windows desktop, and the
# x64 half of a universal macOS build). Without these, the linker fails with
#   undefined symbol: quantize_row_q8_0
#   undefined symbol: ggml_vec_dot_q4_0_q8_0
# etc., because the quantized matrix-multiply implementations live in the
# architecture-specific files.
#
# MoltBrowser: they are the only ggml-cpu files built with instruction-set
# flags (everything else gets Chromium's x64 baseline, -msse3), so they are
# built once per level, and the inference service picks the best level this
# CPU supports at run time (docs/design/SANDBOXED_INFERENCE.md section 12):
#   v2    x86-64-v2: SSE4.2 + POPCNT, no AVX (the minimum for on-device AI)
#   avx   + AVX (Sandy Bridge, Bulldozer)
#   avx2  + AVX2, FMA, F16C: the flags every x64 CPU used before
# chromium/ggml-cpu-x86-variants.h, force-included, renames the 40
# functions the two files define with a per-level prefix;
# chromium/ggml-cpu-x86-dispatch.cpp defines the original names as thunks
# into the chosen level, so ggml's callers are unchanged. The files contain
# no static initializers and no weak (COMDAT) symbols, so no code built for
# a higher level runs before the choice or is shared with a lower level.
# arch/x86/cpu-feats.cpp (upstream's score for GGML_BACKEND_DL) isn't built:
# it compiles to nothing without GGML_BACKEND_DL, and the service's choice
# (//chrome/services/molt_ai/inference/engine/cpu_kernels.h) scores the same
# way.
if (current_cpu == "x64") {
  _ggml_x86_levels = [
    {
      name = "v2"
      flags = [
        "-msse4.2",
        "-mpopcnt",
      ]
    },
    {
      name = "avx"
      flags = [
        "-mavx",
        "-msse4.2",
        "-mpopcnt",
      ]
    },
    {
      # Unchanged from the single x64 build: AVX2 machines run the same code.
      name = "avx2"
      flags = [
        "-mavx2",
        "-mfma",
        "-mf16c",
        "-msse4.2",
      ]
    },
  ]
  _ggml_x86_names =
      rebase_path("chromium/ggml-cpu-x86-variants.h", root_build_dir)
  if (is_win) {
    _ggml_x86_force_include = [ "/FI$_ggml_x86_names" ]
  } else {
    _ggml_x86_force_include = [
      "-include",
      _ggml_x86_names,
    ]
  }

  _ggml_x86_level_targets = []
  foreach(level, _ggml_x86_levels) {
    _ggml_x86_level_targets += [ ":ggml_cpu_x86_${level.name}" ]

    source_set("ggml_cpu_x86_${level.name}") {
      visibility = [ ":ggml_cpu_x86_dispatch" ]

      sources = [
        "ggml/src/ggml-cpu/arch/x86/quants.c",
        "ggml/src/ggml-cpu/arch/x86/repack.cpp",
      ]
      inputs = [ "chromium/ggml-cpu-x86-variants.h" ]

      # Renames what the two files define to molt_x86_<level>_<name>.
      defines = [ "GGML_CPU_X86_VARIANT_PREFIX=molt_x86_${level.name}_" ]

      public_configs = [ ":llama_cpp_config" ]
      configs += _llama_cpp_cfi_configs

      cflags = level.flags + _ggml_x86_force_include
      cflags_c = [
        "-std=c11",
        "-w",
      ]
      cflags_cc = [
        "-std=c++17",
        "-w",
      ]
    }
  }

  config("ggml_cpu_x86_dispatch_config") {
    defines = [ "GGML_MOLTBROWSER_X86_CPU_KERNELS" ]
  }

  # The thunks and the choice (molt_llama::UseX86CpuKernels), built with the
  # baseline flags.
  source_set("ggml_cpu_x86_dispatch") {
    visibility = _llama_cpp_visibility

    sources = [
      "chromium/ggml-cpu-x86-dispatch.cpp",
      "chromium/ggml-cpu-x86-dispatch.h",
      "chromium/ggml-cpu-x86-variants.h",
    ]

    public_configs = [
      ":llama_cpp_config",
      ":ggml_cpu_x86_dispatch_config",
    ]

    # Its indirect calls land in the level files, which carry no CFI type
    # information (like every llama.cpp file).
    configs += _llama_cpp_cfi_configs
    deps = _ggml_x86_level_targets

    # It includes ggml-cpu's internal headers (for upstream's declarations
    # of the 40 functions), which aren't written for Chromium's warnings.
    # The file itself builds clean with -Wall -Wextra.
    cflags_cc = [ "-w" ]
  }
}

# Metal targets — only exist on Apple platforms. The `enable_arc` config
# removal and the .m source files are macOS-specific, so the whole block
# is guarded by is_mac to keep gn-gen valid on Linux/Windows builds.
if (is_mac) {
  # Metal shader sources, bundled into the framework's Resources/. At runtime
  # ggml_metal_library_init() loads Resources/default.metallib (built from
  # these same files by scripts/release.sh and scripts/dev-install-mac.sh; the
  # shipped app needs it, run-time compilation fails under the hardened
  # runtime). Without a metallib it compiles Resources/kernels/<kind>.metal,
  # resolving includes from kernels/ and its parent directory, so keep this
  # layout: kernels/ holds the kernel sources and the headers they include,
  # ggml-common.h and ggml-metal-impl.h sit one level up.
  bundle_data("llama_cpp_metal_kernel_resources") {
    sources = [
      "ggml/src/ggml-metal/kernels/argsort.metal",
      "ggml/src/ggml-metal/kernels/binbcast.metal",
      "ggml/src/ggml-metal/kernels/common.h",
      "ggml/src/ggml-metal/kernels/conv.metal",
      "ggml/src/ggml-metal/kernels/dequantize.h",
      "ggml/src/ggml-metal/kernels/fa_aux.metal",
      "ggml/src/ggml-metal/kernels/fa_common.metal",
      "ggml/src/ggml-metal/kernels/fa_f16.metal",
      "ggml/src/ggml-metal/kernels/fa_f32.metal",
      "ggml/src/ggml-metal/kernels/fa_q4_0.metal",
      "ggml/src/ggml-metal/kernels/fa_q4_1.metal",
      "ggml/src/ggml-metal/kernels/fa_q5_0.metal",
      "ggml/src/ggml-metal/kernels/fa_q5_1.metal",
      "ggml/src/ggml-metal/kernels/fa_q8_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_common.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_f16.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_f32.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q4_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q4_1.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q5_0.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q5_1.metal",
      "ggml/src/ggml-metal/kernels/fa_vec_q8_0.metal",
      "ggml/src/ggml-metal/kernels/gated_delta_net.metal",
      "ggml/src/ggml-metal/kernels/misc.metal",
      "ggml/src/ggml-metal/kernels/mul_mm.metal",
      "ggml/src/ggml-metal/kernels/mul_mv.metal",
      "ggml/src/ggml-metal/kernels/mul_mv_mma.metal",
      "ggml/src/ggml-metal/kernels/norm.metal",
      "ggml/src/ggml-metal/kernels/pool.metal",
      "ggml/src/ggml-metal/kernels/quantize.h",
      "ggml/src/ggml-metal/kernels/quantize.metal",
      "ggml/src/ggml-metal/kernels/reduce.metal",
      "ggml/src/ggml-metal/kernels/rope.metal",
      "ggml/src/ggml-metal/kernels/softmax.metal",
      "ggml/src/ggml-metal/kernels/solve_tri.metal",
      "ggml/src/ggml-metal/kernels/ssm.metal",
      "ggml/src/ggml-metal/kernels/tri.metal",
      "ggml/src/ggml-metal/kernels/unary.metal",
      "ggml/src/ggml-metal/kernels/upscale.metal",
      "ggml/src/ggml-metal/kernels/wkv.metal",
    ]
    outputs = [ "{{bundle_resources_dir}}/kernels/{{source_file_part}}" ]
  }

  bundle_data("llama_cpp_metal_header_resources") {
    sources = [
      "ggml/src/ggml-common.h",
      "ggml/src/ggml-metal/ggml-metal-impl.h",
    ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }

  # Referenced from //chrome:chrome_framework (bundle_deps).
  group("llama_cpp_metal_resources") {
    public_deps = [
      ":llama_cpp_metal_header_resources",
      ":llama_cpp_metal_kernel_resources",
    ]
  }

  # Metal backend C++ sources.
  # Note: -fno-modules is needed because ggml-metal-ops.cpp uses std::swap
  # on a custom struct, and Chromium's C++ modules don't instantiate it
  # correctly across translation units.
  source_set("ggml_metal") {
    visibility = _llama_cpp_visibility

    sources = [
      "ggml/src/ggml-metal/ggml-metal.cpp",
      "ggml/src/ggml-metal/ggml-metal-common.cpp",
      "ggml/src/ggml-metal/ggml-metal-device.cpp",
      "ggml/src/ggml-metal/ggml-metal-fusion.cpp",
      "ggml/src/ggml-metal/ggml-metal-ops.cpp",
      "ggml/src/ggml-metal/ggml-metal-tuning.cpp",
    ]

    public_configs = [ ":llama_cpp_config" ]
    configs += _llama_cpp_cfi_configs

    cflags_cc = [
      "-std=c++17",
      "-w",
      "-fno-modules",
    ]
  }

  # Metal Objective-C sources (separated due to different compiler flags).
  # llama.cpp uses manual retain/release — disable Chromium's default ARC.
  source_set("ggml_metal_objc") {
    visibility = _llama_cpp_visibility

    sources = [
      "ggml/src/ggml-metal/ggml-metal-device.m",
      "ggml/src/ggml-metal/ggml-metal-context.m",
    ]

    public_configs = [ ":llama_cpp_config" ]
    configs += _llama_cpp_cfi_configs

    # Disable ARC for this third-party code that uses manual retain/release
    configs -= [ "//build/config/compiler:enable_arc" ]

    cflags_objc = [
      "-w",
      "-fno-objc-arc",
    ]
  }
}

# MoltBrowser: llama.cpp's Vulkan backend (ggml-vulkan), GN switch
# molt_llama_vulkan (llama_cpp.gni, off by default). GPU inference on Linux
# and Windows, with the CPU as the fallback. Design, sandbox, status:
# docs/design/SANDBOXED_INFERENCE.md section 11.
#
# - Shaders are compiled from the GLSL sources at build time, with the
#   glslang and SPIRV-Tools Chromium pins (no SPIR-V is checked in):
#   llama.cpp's own generator (vulkan-shaders-gen) runs, per shader file,
#   ggml_vk_glslc, a glslc-compatible host tool on those libraries
#   (chromium/ggml_vk_glslc.cc; Chromium has no shaderc).
# - ggml-vulkan is built with VK_NO_PROTOTYPES: the browser binary has no
#   link-time dependency on the Vulkan loader, which the inference service
#   opens at run time, and only when the browser asks for the GPU
#   (chromium/ggml-vulkan-moltbrowser.cpp; local patch in ggml-vulkan.cpp).
# - The backend is never added to ggml's registry (no GGML_USE_VULKAN): the
#   CPU path doesn't touch Vulkan at all. The service passes the chosen
#   device explicitly (chromium/llama_guard.h).
if (molt_llama_vulkan) {
  assert(is_linux || is_win,
         "molt_llama_vulkan is for Linux and Windows (macOS uses Metal)")

  _ggml_vk_dir = "ggml/src/ggml-vulkan"
  _ggml_vk_shader_dir = "$_ggml_vk_dir/vulkan-shaders"
  _ggml_vk_gen_dir = "$target_gen_dir/ggml-vulkan"

  # Every .comp file in vulkan-shaders/ (GN has no globbing;
  # :ggml_vulkan_checks fails the build if this list and the directory
  # disagree). Update with llama.cpp.
