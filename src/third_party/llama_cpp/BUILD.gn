    "opt_step_sgd.comp",
    "out_prod.comp",
    "pad.comp",
    "pad_reflect_1d.comp",
    "pool1d.comp",
    "pool2d.comp",
    "quantize_q8_1.comp",
    "reglu.comp",
    "repeat.comp",
    "repeat_back.comp",
    "rms_norm.comp",
    "rms_norm_back.comp",
    "rms_norm_partials.comp",
    "roll.comp",
    "rope_multi.comp",
    "rope_neox.comp",
    "rope_norm.comp",
    "rope_vision.comp",
    "scale.comp",
    "silu_back.comp",
    "snake.comp",
    "soft_max.comp",
    "soft_max_back.comp",
    "soft_max_large1.comp",
    "soft_max_large2.comp",
    "soft_max_large3.comp",
    "solve_tri.comp",
    "ssm_conv.comp",
    "ssm_scan.comp",
    "sub.comp",
    "sum_rows.comp",
    "swiglu.comp",
    "swiglu_clamp.comp",
    "swiglu_oai.comp",
    "timestep_embedding.comp",
    "topk_argsort.comp",
    "topk_moe.comp",
    "topk_nary_search.comp",
    "topk_radix_select.comp",
    "tri.comp",
    "unary.comp",
    "upscale.comp",
    "wkv6.comp",
    "wkv7.comp",
  ]
  _ggml_vk_shader_sources = []
  foreach(s, _ggml_vk_shaders) {
    _ggml_vk_shader_sources += [ "$_ggml_vk_shader_dir/$s" ]
  }

  # Shader families the pinned glslang can compile; what upstream's CMake
  # would detect with the same compiler (test_shader_extension_support).
  # Passed to the generator and to ggml-vulkan.cpp, which must agree.
  # :ggml_vulkan_checks fails the build if one stops compiling.
  _ggml_vk_features = [
    "GGML_VULKAN_COOPMAT_GLSLC_SUPPORT",
    "GGML_VULKAN_COOPMAT2_GLSLC_SUPPORT",
    "GGML_VULKAN_COOPMAT2_DECODE_VECTOR_GLSLC_SUPPORT",
    "GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT",
    "GGML_VULKAN_BFLOAT16_GLSLC_SUPPORT",
    "GGML_VULKAN_FLOAT_E2M1_GLSLC_SUPPORT",
    "GGML_VULKAN_FLOAT_E4M3_GLSLC_SUPPORT",
  ]

  # Weight types whose shader variants the binary leaves out (as ggml names
  # them, lower case): none of the catalogue's models uses them
  # (docs/design/SANDBOXED_INFERENCE.md section 11.14). The chat models are
  # Q4_K_M (Q4_K, Q5_K, Q6_K, Q8_0, and Q5_0 / Q5_1 / F16 where a row isn't
  # a multiple of 256: src/llama-quant.cpp), gpt-oss is MXFP4, the embedding
  # model and the vision projector Q8_0, F16 and F32; KV caches are F16.
  # ggml_backend_vk_device_supports_op() keeps every op on these types on
  # the CPU (chromium/ggml-vulkan-moltbrowser.cpp), so a GGUF that has them
  # still runs, those ops on the CPU. Before pinning a model with another
  # type, take the type out of this list (tools/models/gguf_types.py).
  # About 20 MB of the 40 MB of SPIR-V.
  _ggml_vk_dropped_types = [
    "q1_0",
    "q2_0",
    "q4_0",
    "q4_1",
    "q2_k",
    "q3_k",
    "iq1_s",
    "iq1_m",
    "iq2_xxs",
    "iq2_xs",
    "iq2_s",
    "iq3_xxs",
    "iq3_s",
    "iq4_xs",
    "iq4_nl",
    "nvfp4",
    "tq1_0",
    "tq2_0",
  ]

  # Every cooperative-matrix family stays: KHR_cooperative_matrix (_cm1)
  # runs on NVIDIA (Turing and later), AMD (RDNA3 and later, RADV and AMD's
  # driver) and Intel (Arc and Xe2, ANV and Intel's driver);
  # NV_cooperative_matrix2 (_cm2) on NVIDIA's driver, which is one of the
  # drivers this backend is for (section 11.4). ggml-vulkan picks per device.

  # Host tools, run by the actions below.
  if (current_toolchain == host_toolchain) {
    # glslc's command line (the subset vulkan-shaders-gen uses) on
    # Chromium's glslang and SPIRV-Tools optimizer.
    executable("ggml_vk_glslc") {
      visibility = [ ":*" ]
      sources = [ "chromium/ggml_vk_glslc.cc" ]
      deps = [
        "//third_party/glslang/src:glslang_default_resource_limits_sources",
        "//third_party/glslang/src:glslang_sources",
        "//third_party/spirv-tools/src:spvtools_opt",
      ]
    }

    # Packs the generator's output: brotli blocks per shader file, a
    # descriptor per variant, the dropped types' variants left out
    # (chromium/ggml-vulkan-shader-pack.h).
    executable("ggml_vk_shader_pack") {
      visibility = [ ":*" ]
      sources = [
        "chromium/ggml-vulkan-shader-pack.h",
        "chromium/ggml_vk_shader_pack.cc",
      ]
      deps = [
        "//third_party/brotli:dec",
        "//third_party/brotli:enc",
      ]
    }

    # llama.cpp's shader generator, unmodified.
    executable("vulkan_shaders_gen") {
      visibility = [ ":*" ]
      sources = [ "$_ggml_vk_shader_dir/vulkan-shaders-gen.cpp" ]
      defines = _ggml_vk_features

      # It uses try/catch.
      configs -= [ "//build/config/compiler:no_exceptions" ]
      configs += [ ":llama_exceptions" ]
      cflags_cc = [
        "-std=c++17",
        "-w",
      ]
    }
  }

  _ggml_vk_host_out = get_label_info(":ggml_vk_glslc($host_toolchain)",
                                     "root_out_dir")
  _ggml_vk_exe = ""
  if (host_os == "win") {
    _ggml_vk_exe = ".exe"
  }
  _ggml_vk_glslc = "$_ggml_vk_host_out/ggml_vk_glslc$_ggml_vk_exe"
  _ggml_vk_shaders_gen = "$_ggml_vk_host_out/vulkan_shaders_gen$_ggml_vk_exe"
  _ggml_vk_shader_pack = "$_ggml_vk_host_out/ggml_vk_shader_pack$_ggml_vk_exe"
  _ggml_vk_pack_lists = []
  foreach(s, _ggml_vk_shaders) {
    _ggml_vk_pack_lists += [
      "--families",
      s,
    ]
  }
  foreach(t, _ggml_vk_dropped_types) {
    _ggml_vk_pack_lists += [
      "--drop-type",
      t,
    ]
  }

  action("ggml_vulkan_checks") {
    visibility = [ ":*" ]
    script = "chromium/ggml_vulkan_checks.py"
    inputs = [
      _ggml_vk_glslc,
      "$_ggml_vk_shader_dir/feature-tests/bfloat16.comp",
      "$_ggml_vk_shader_dir/feature-tests/coopmat.comp",
      "$_ggml_vk_shader_dir/feature-tests/coopmat2.comp",
      "$_ggml_vk_shader_dir/feature-tests/coopmat2_decode_vector.comp",
      "$_ggml_vk_shader_dir/feature-tests/float_e2m1.comp",
      "$_ggml_vk_shader_dir/feature-tests/float_e4m3.comp",
      "$_ggml_vk_shader_dir/feature-tests/integer_dot.comp",
    ]
    outputs = [ "$_ggml_vk_gen_dir/checks.stamp" ]
    deps = [ ":ggml_vk_glslc($host_toolchain)" ]
    args = [
      "--glslc",
      rebase_path(_ggml_vk_glslc, root_build_dir),
      "--shader-dir",
      rebase_path(_ggml_vk_shader_dir, root_build_dir),
      "--stamp",
      rebase_path(outputs[0], root_build_dir),
    ]
    foreach(f, _ggml_vk_features) {
      args += [ "--feature=$f" ]
    }
    foreach(s, _ggml_vk_shaders) {
      args += [ "--listed=$s" ]
    }
    foreach(t, _ggml_vk_dropped_types) {
      args += [ "--dropped=$t" ]
    }
  }

  # The declarations of every shader variant (ggml-vulkan-shaders.hpp).
  action("ggml_vulkan_shaders_hpp") {
    visibility = [ ":*" ]
    script = "//build/gn_run_binary.py"
    inputs = [ _ggml_vk_shaders_gen ]
    outputs = [ "$_ggml_vk_gen_dir/ggml-vulkan-shaders.hpp" ]
    deps = [ ":vulkan_shaders_gen($host_toolchain)" ]
    args = [
      rebase_path(_ggml_vk_shaders_gen, root_build_dir),
      "--output-dir",
      rebase_path("$_ggml_vk_gen_dir/spv", root_build_dir),
      "--target-hpp",
      rebase_path(outputs[0], root_build_dir),
    ]
  }

  # One .cpp per shader file, embedding the SPIR-V of all its variants (an
  # intermediate in raw/, packed below). The depfile (written by
  # ggml_vk_glslc, through the generator) lists the .glsl files it
  # includes. The .spv files are intermediates in spv/.
  action_foreach("ggml_vulkan_shaders_cpp") {
    visibility = [ ":*" ]
    script = "//build/gn_run_binary.py"
    sources = _ggml_vk_shader_sources
    inputs = [
      _ggml_vk_glslc,
      _ggml_vk_shaders_gen,
    ]
    outputs = [ "$_ggml_vk_gen_dir/raw/{{source_file_part}}.cpp" ]
    depfile = "$_ggml_vk_gen_dir/raw/{{source_file_part}}.cpp.d"
    deps = [
      ":ggml_vk_glslc($host_toolchain)",
      ":ggml_vulkan_checks",
      ":vulkan_shaders_gen($host_toolchain)",
    ]
    args = [
      rebase_path(_ggml_vk_shaders_gen, root_build_dir),
      # The generator execvp()s it: "./" so a bare name (a native build's
      # host tools are in the root of the build directory) isn't looked up
      # in PATH.
      "--glslc",
      "./" + rebase_path(_ggml_vk_glslc, root_build_dir),
      "--source",
      "{{source}}",
      "--output-dir",
      rebase_path("$_ggml_vk_gen_dir/spv", root_build_dir),
      "--target-hpp",
      rebase_path("$_ggml_vk_gen_dir/ggml-vulkan-shaders.hpp", root_build_dir),
      "--target-cpp",
      rebase_path("$_ggml_vk_gen_dir/raw/{{source_file_part}}.cpp",
                  root_build_dir),
    ]
  }

  # The generator's .cpp files packed (chromium/ggml-vulkan-shader-pack.h):
  # each shader file's variants in brotli blocks, a descriptor per variant,
  # the dropped types' variants left out. These are what gets compiled.
  action_foreach("ggml_vulkan_shaders_packed") {
    visibility = [ ":*" ]
    script = "//build/gn_run_binary.py"
    sources = get_target_outputs(":ggml_vulkan_shaders_cpp")
    inputs = [ _ggml_vk_shader_pack ]
    outputs = [ "$_ggml_vk_gen_dir/{{source_name_part}}.cpp" ]
    deps = [
      ":ggml_vk_shader_pack($host_toolchain)",
      ":ggml_vulkan_shaders_cpp",
    ]
    args = [
             rebase_path(_ggml_vk_shader_pack, root_build_dir),
             "--in",
             "{{source}}",
             "--out",
             rebase_path("$_ggml_vk_gen_dir/{{source_name_part}}.cpp",
                         root_build_dir),
             "--family",
             "{{source_name_part}}",
           ] + _ggml_vk_pack_lists
  }

  # The table of packed shader files and the list of dropped types.
  action("ggml_vulkan_shader_registry") {
    visibility = [ ":*" ]
    script = "//build/gn_run_binary.py"
    inputs = [ _ggml_vk_shader_pack ]
    outputs = [ "$_ggml_vk_gen_dir/ggml-vulkan-shader-registry.cpp" ]
    deps = [ ":ggml_vk_shader_pack($host_toolchain)" ]
    args = [
             rebase_path(_ggml_vk_shader_pack, root_build_dir),
             "--registry",
             rebase_path(outputs[0], root_build_dir),
           ] + _ggml_vk_pack_lists
  }

  source_set("ggml_vulkan") {
    visibility = _llama_cpp_visibility

    sources = [
      "$_ggml_vk_dir/ggml-vulkan-buffers.cpp",
      "$_ggml_vk_dir/ggml-vulkan-common.h",
      "$_ggml_vk_dir/ggml-vulkan-debug.cpp",
      "$_ggml_vk_dir/ggml-vulkan-push-constants.h",
      "$_ggml_vk_dir/ggml-vulkan-types.h",
      "$_ggml_vk_dir/ggml-vulkan.cpp",
      "chromium/ggml-vulkan-moltbrowser.cpp",
      "chromium/ggml-vulkan-moltbrowser.h",
      "chromium/ggml-vulkan-shader-pack.h",
    ]

    # ggml/include/ggml-vulkan.h is deliberately not listed: listing it makes
    # gn check flag ggml-backend-reg.cpp's #include of it, which is under
    # #ifdef GGML_USE_VULKAN and never compiled here (the backend isn't
    # registered with ggml).
    sources += get_target_outputs(":ggml_vulkan_shaders_packed")
    sources += get_target_outputs(":ggml_vulkan_shader_registry")
    sources += get_target_outputs(":ggml_vulkan_shaders_hpp")
    include_dirs = [ _ggml_vk_gen_dir ]
    defines = _ggml_vk_features + [
                # chromium/ggml-vulkan-moltbrowser.cpp opens the loader.
                "GGML_VULKAN_MOLTBROWSER",
                "VK_NO_PROTOTYPES",
              ]

    public_deps = [ ":ggml" ]
    deps = [
      ":ggml_vulkan_shader_registry",
      ":ggml_vulkan_shaders_hpp",
      ":ggml_vulkan_shaders_packed",

      # The packed shaders are inflated with it
      # (chromium/ggml-vulkan-moltbrowser.cpp).
      "//third_party/brotli:dec",
      "//third_party/spirv-headers/src:spv_headers",
      "//third_party/vulkan-headers/src:vulkan_headers",
    ]
    public_configs = [ ":llama_cpp_config" ]
    configs += _llama_cpp_cfi_configs

    # vulkan.hpp's throwing API; ggml-vulkan catches some of its own errors.
    # What can escape to the service is caught by :llama_guard.
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ ":llama_exceptions" ]

    cflags_cc = [
      "-std=c++17",
      "-w",
    ]

    # :vulkan_headers' config turns on window-system platforms (X11, Wayland,
    # Win32), whose headers ggml doesn't need and whose macros (None, Bool,
    # min, max, ...) clash with C++ code.
    if (is_win) {
      cflags_cc += [ "/UVK_USE_PLATFORM_WIN32_KHR" ]
    } else {
      cflags_cc += [
        "-UVK_USE_PLATFORM_XCB_KHR",
        "-UVK_USE_PLATFORM_XLIB_KHR",
        "-UVK_USE_PLATFORM_WAYLAND_KHR",
      ]
    }
  }
}

# Combined GGML target
group("ggml") {
  visibility = _llama_cpp_visibility

  public_deps = [
    ":ggml_c",
    ":ggml_cpp",
    ":ggml_cpu_c",
    ":ggml_cpu_cpp",
  ]

  if (current_cpu == "arm64") {
    public_deps += [
      ":ggml_cpu_arch_arm",
      ":ggml_cpu_arch_arm_c",
    ]
  }

  if (current_cpu == "x64") {
    public_deps += [ ":ggml_cpu_x86_dispatch" ]
  }

  if (is_mac) {
    public_deps += [
      ":ggml_metal",
      ":ggml_metal_objc",
    ]
  }
}

