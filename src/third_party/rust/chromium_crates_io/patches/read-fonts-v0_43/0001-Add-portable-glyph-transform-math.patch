From: MoltBrowser <noreply@geneye.ai>
Subject: [PATCH] Add portable glyph-transform math

The rotations and skews of variable composites (VARC) use f32's sin_cos and
tan, which with the std feature are the platform's C library functions,
whose last bits differ between operating systems and CPUs. They now go
through moltbrowser_math, which is those functions by default and the libm
crate's (plain Rust ports of musl's functions, the same on every CPU and OS)
after moltbrowser_math::set_portable(true). skrifa's colour-glyph rotations
and skews and composite offsets use it too; Skia's Fontations backend turns
it on in MoltNet's renderers.
---
diff --git a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/Cargo.toml b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/Cargo.toml
index 76e0beb..bf77568 100644
--- a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/Cargo.toml
+++ b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/Cargo.toml
@@ -98,6 +98,10 @@ optional = true
 version = "0.12.4"
 features = ["bytemuck"]
 
+# MoltBrowser: the portable functions of moltbrowser_math.
+[dependencies.libm]
+version = "0.2.16"
+
 [dependencies.once_cell]
 version = "1.21.4"
 features = [
diff --git a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/lib.rs b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/lib.rs
index bdb4662..a3fc671 100644
--- a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/lib.rs
+++ b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/lib.rs
@@ -84,6 +84,8 @@ mod read;
 mod table_provider;
 mod table_ref;
 pub mod tables;
+// MoltBrowser: portable glyph-transform math (see the module).
+pub mod moltbrowser_math;
 #[cfg(feature = "experimental_traverse")]
 pub mod traversal;
 
diff --git a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/moltbrowser_math.rs b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/moltbrowser_math.rs
new file mode 100644
index 0000000..8d719f2
--- /dev/null
+++ b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/moltbrowser_math.rs
@@ -0,0 +1,77 @@
+//! MoltBrowser: the floating-point functions of glyph transforms, with one
+//! process-wide choice of implementation.
+//!
+//! read-fonts and skrifa compute the rotations and skews of colour glyphs
+//! (COLRv1 `PaintRotate` and `PaintSkew`), the rotations and skews of
+//! variable composites (`VARC`) and the scale of composite glyphs' offsets
+//! with `sin`, `cos`, `tan` and `hypot`. With the `std` feature those are the
+//! platform's C library functions, whose last bits differ between operating
+//! systems and CPUs. By default these functions are exactly what the call
+//! sites called before; after `set_portable(true)` they are the `libm`
+//! crate's, plain Rust ports of musl's functions that give the same result on
+//! every CPU and OS. Skia's Fontations backend turns it on in MoltNet's
+//! renderers.
+
+use core::sync::atomic::{AtomicBool, Ordering};
+
+#[cfg(feature = "libm")]
+#[allow(unused_imports)]
+use core_maths::*;
+
+static PORTABLE: AtomicBool = AtomicBool::new(false);
+
+/// Whether this process uses the portable functions. Set once, before any
+/// glyph is loaded; any thread.
+pub fn set_portable(portable: bool) {
+    PORTABLE.store(portable, Ordering::Relaxed);
+}
+
+/// See [`set_portable`].
+pub fn is_portable() -> bool {
+    PORTABLE.load(Ordering::Relaxed)
+}
+
+/// `x.sin()`, or the portable sine.
+pub fn sin(x: f32) -> f32 {
+    if is_portable() {
+        libm::sinf(x)
+    } else {
+        x.sin()
+    }
+}
+
+/// `x.cos()`, or the portable cosine.
+pub fn cos(x: f32) -> f32 {
+    if is_portable() {
+        libm::cosf(x)
+    } else {
+        x.cos()
+    }
+}
+
+/// `x.sin_cos()`, or the portable sine and cosine.
+pub fn sin_cos(x: f32) -> (f32, f32) {
+    if is_portable() {
+        (libm::sinf(x), libm::cosf(x))
+    } else {
+        x.sin_cos()
+    }
+}
+
+/// `x.tan()`, or the portable tangent.
+pub fn tan(x: f32) -> f32 {
+    if is_portable() {
+        libm::tanf(x)
+    } else {
+        x.tan()
+    }
+}
+
+/// `x.hypot(y)`, or the portable hypotenuse.
+pub fn hypot(x: f32, y: f32) -> f32 {
+    if is_portable() {
+        libm::hypotf(x, y)
+    } else {
+        x.hypot(y)
+    }
+}
diff --git a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/tables/varc.rs b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/tables/varc.rs
index e6aa279..c9b4063 100644
--- a/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/tables/varc.rs
+++ b/third_party/rust/chromium_crates_io/vendor/read-fonts-v0_43/src/tables/varc.rs
@@ -409,7 +409,9 @@ impl DecomposedTransform {
 
         // Python: t = t.rotate(self.rotation * math.pi)
         if self.rotation != 0.0 {
-            let (s, c) = (self.rotation * core::f32::consts::PI).sin_cos();
+            // MoltBrowser: portable in MoltNet (crate::moltbrowser_math).
+            let (s, c) =
+                crate::moltbrowser_math::sin_cos(self.rotation * core::f32::consts::PI);
             transform *= Matrix::from_elements([c, s, -s, c, 0.0, 0.0]);
         }
 
@@ -422,8 +424,9 @@ impl DecomposedTransform {
         if (self.skew_x, self.skew_y) != (0.0, 0.0) {
             transform *= Matrix::from_elements([
                 1.0,
-                (self.skew_y * core::f32::consts::PI).tan(),
-                (-self.skew_x * core::f32::consts::PI).tan(),
+                // MoltBrowser: portable in MoltNet (crate::moltbrowser_math).
+                crate::moltbrowser_math::tan(self.skew_y * core::f32::consts::PI),
+                crate::moltbrowser_math::tan(-self.skew_x * core::f32::consts::PI),
                 1.0,
                 0.0,
                 0.0,
