From: MoltBrowser <noreply@geneye.ai>
Subject: [PATCH] Add a portable scalar mode

Every function made with simd_function! picks AVX-512, AVX2 + FMA +
F16C, SSE4.2 or NEON code for the CPU it runs on, and they fuse
multiply-adds or not, look tables up in bf16 and convert half floats
differently, so decoded pixels depend on the CPU.
moltbrowser_set_portable(true) makes every such function run the
scalar descriptor, which gives the same results on every CPU.
jxl's moltbrowser_set_portable() sets it.
---
diff --git a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/lib.rs b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/lib.rs
--- a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/lib.rs
+++ b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/lib.rs
@@ -22,6 +22,31 @@
 
 pub mod float16;
 pub mod scalar;
+
+// MoltBrowser: a process-wide switch to the scalar code.
+//
+// Every function made with `simd_function!` picks the widest instruction set
+// the CPU has (AVX-512, AVX2 + FMA + F16C, SSE4.2, NEON) and falls back to
+// the scalar descriptor. The vector ones fuse multiply-adds or not, look up
+// tables in bf16 and convert half floats in hardware, so a decoded image's
+// pixels depend on the CPU. Once `moltbrowser_set_portable(true)` has been
+// called, every such function runs the scalar descriptor on every CPU and
+// architecture, which gives the same values everywhere. MoltBrowser's
+// MoltNet renderers set it before they decode any image; nothing else does.
+static MOLTBROWSER_PORTABLE: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+/// MoltBrowser: runs every `simd_function!` on the scalar descriptor from
+/// now on (`true`), or picks by CPU again (`false`, the default).
+pub fn moltbrowser_set_portable(portable: bool) {
+    MOLTBROWSER_PORTABLE.store(portable, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// MoltBrowser: whether `moltbrowser_set_portable(true)` is in effect.
+#[inline(always)]
+pub fn moltbrowser_portable() -> bool {
+    MOLTBROWSER_PORTABLE.load(std::sync::atomic::Ordering::Relaxed)
+}
 
 #[cfg(all(target_arch = "aarch64", feature = "neon"))]
 pub use aarch64::neon::NeonDescriptor;
diff --git a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/x86_64/mod.rs b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/x86_64/mod.rs
--- a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/x86_64/mod.rs
+++ b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/x86_64/mod.rs
@@ -29,6 +29,10 @@
         $pub fn $dname($($arg: $ty),*) $(-> $ret)? {
             #[allow(unused)]
             use $crate::SimdDescriptor;
+            // MoltBrowser: the scalar code on every CPU when portable.
+            if $crate::moltbrowser_portable() {
+                return $name($crate::ScalarDescriptor::new().unwrap(), $($arg),*);
+            }
             $crate::simd_function_body_avx512!($name($($arg: $ty),*) $(-> $ret)?; ($($arg),*));
             $crate::simd_function_body_avx!($name($($arg: $ty),*) $(-> $ret)?; ($($arg),*));
             $crate::simd_function_body_sse42!($name($($arg: $ty),*) $(-> $ret)?; ($($arg),*));
diff --git a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/aarch64/mod.rs b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/aarch64/mod.rs
--- a/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/aarch64/mod.rs
+++ b/third_party/rust/chromium_crates_io/vendor/jxl_simd-v0_7/src/aarch64/mod.rs
@@ -25,6 +25,10 @@
         $pub fn $dname($($arg: $ty),*) $(-> $ret)? {
             #[allow(unused)]
             use $crate::SimdDescriptor;
+            // MoltBrowser: the scalar code on every CPU when portable.
+            if $crate::moltbrowser_portable() {
+                return $name($crate::ScalarDescriptor::new().unwrap(), $($arg),*);
+            }
             $crate::simd_function_body_neon!($name($($arg: $ty),*) $(-> $ret)?; ($($arg),*));
             $name($crate::ScalarDescriptor::new().unwrap(), $($arg),*)
         }
