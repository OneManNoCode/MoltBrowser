#
# Shared by the browser half (//chrome/browser/molt_ai/fingerprinting, which
# puts the mode switch on renderer command lines and sends the session seed
# and per-document Shields decisions over :mojom) and the renderer half
# (//chrome/renderer/molt_ai/fingerprinting, which hands them to Blink) of
# MoltBrowser's fingerprinting protection.

import("//mojo/public/tools/bindings/mojom.gni")

source_set("fingerprinting") {
  sources = [
    "molt_fingerprinting_features.cc",
    "molt_fingerprinting_features.h",
    "molt_fingerprinting_switches.cc",
    "molt_fingerprinting_switches.h",
  ]
  public_deps = [ "//base" ]
}

# Browser -> renderer configuration that stays off the command line (the
# session seed) or is per document (the Shields decision).
mojom("mojom") {
  sources = [ "molt_fingerprinting.mojom" ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [ "molt_fingerprinting_switches_unittest.cc" ]
  deps = [
    ":fingerprinting",
    "//testing/gtest",
  ]
}
