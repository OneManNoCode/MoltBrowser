// MoltBrowser fingerprinting protection: browser -> renderer configuration
// that must not go on the renderer's command line.
module molt_ai.fingerprinting.mojom;

import "mojo/public/mojom/base/file.mojom";

// Renderer side, one per renderer process, channel-associated: messages are
// ordered with the rest of the renderer's channel traffic, so what the
// browser sends at RenderProcessWillLaunch arrives before any navigation
// commit for that process. (Service and shared workers are started over
// other pipes; they need the seed only at their first farbled read.) Only
// bound when the renderer's --molt-fingerprinting-mode is farble or uniform.
interface FingerprintingConfiguration {
  // The BrowserContext's 32-byte session seed, sent once per renderer
  // launch. Anything but 32 bytes is ignored, and only the first seed
  // counts. Until it arrives, contexts that need a key get a random one.
  SetSessionSeed(array<uint8> seed);

  // MoltNet's bundled fonts, sent once per launch right after the seed, and
  // only to renderers launched with --molt-net-fonts: every file of the set,
  // opened read-only by the browser, in the order of the generated table
  // (molt_net_fonts_table.h, moltnet_font_set_table.cc). The renderer never
  // opens a font file itself. A list of the wrong length, or a file of the
  // wrong size, is refused and the renderer keeps finding no fonts.
  SetMoltNetFonts(array<mojo_base.mojom.ReadOnlyFile> files);
};

// Renderer side, one per frame (RenderFrame), frame-associated: the browser
// gets it through the RenderFrameHost's remote associated interfaces, the
// same provider its NavigationClient comes from, so a message sent from
// ReadyToCommitNavigation is dispatched before the commit it precedes. Only
// bound in renderers whose mode is farble (MoltNet ignores Shields).
interface ShieldsDecision {
  // MoltShield's per-site decision for the document the browser is about to
  // commit in this frame: whether the user turned MoltShield off
  // (`shields_down`) for `top_level_site`, the site of the top frame of the
  // frame's tree ("https://example.com", as net::SchemefulSite serializes
  // it; a sandboxed top-level document's precursor's), as the profile's
  // content settings say at commit time. Applies to that document and the
  // documents the renderer later creates in the frame by itself
  // (javascript: URLs, XSLT); it only counts for a document whose own
  // top-level site is `top_level_site`. Without one, a document inherits
  // its parent's or opener's decision, or is farbled.
  SetForNextDocument(bool shields_down, string top_level_site);
};
