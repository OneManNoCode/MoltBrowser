#
# On-device document -> Markdown extraction for MoltBrowser AI chat, backed by
# the pure-Rust `anydoc` crate (Office/PDF/e-book/CSV -> clean GFM Markdown).
# Fully local: no network, no cloud. Exposed to C++ via a small cxx bridge.
# Parses untrusted files, so only the sandboxed document parser utility
# process links it (../document_parser_impl.h).

import("//build/rust/rust_static_library.gni")

rust_static_library("anydoc_ffi") {
  allow_unsafe = true  # The cxx-generated bridge glue uses `unsafe`.
  crate_root = "anydoc_ffi.rs"
  sources = [ "anydoc_ffi.rs" ]
  cxx_bindings = [ "anydoc_ffi.rs" ]
  deps = [ "//third_party/rust/anydoc/v0_1:lib" ]
  visibility = [ "//chrome/services/molt_ai/document_parser:*" ]
}
