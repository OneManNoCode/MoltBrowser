#
# PDF text extraction for MoltBrowser's AI chat (/pdf and PDF attachments),
# without the full PDFium renderer. Parses untrusted bytes, so it runs only in
# the sandboxed document parser utility process (../document_parser_impl.h).

source_set("pdf") {
  sources = [
    "pdf_text_scraper.cc",
    "pdf_text_scraper.h",
  ]

  deps = [
    "//base",
    "//third_party/zlib",
  ]

  visibility = [
    ":unit_tests",
    "//chrome/services/molt_ai/document_parser:*",
  ]
}

# Unit tests for the PDF text scraper. Picked up by the
# //chrome/browser/molt_ai/test:molt_ai_unittests binary so the
# standalone test target builds independently of //chrome/test:unit_tests
# (which is a 13000-line GN file we don't want to keep mirroring on
# every Chromium upgrade). Run with:
#   autoninja -C out/MoltBrowser molt_ai_unittests
#   ./out/MoltBrowser/molt_ai_unittests
source_set("unit_tests") {
  testonly = true
  sources = [
    "pdf_text_scraper_unittest.cc",
  ]
  deps = [
    ":pdf",
    "//base",
    "//testing/gtest",
    "//third_party/zlib",
  ]
}
