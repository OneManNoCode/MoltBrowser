#
# Std-only building blocks of the on-device inference engine: context
# budgeting, prompt helpers and the streaming output filters. No llama.cpp,
# no //base, so they are unit-tested standalone too.

# Output filters. Also linked by the browser
# (//chrome/browser/molt_ai/runtime:stream_validator), which re-applies
# StopSequenceFilter and checks UTF-8 on what the service sends.
source_set("stream_filters") {
  sources = [
    "stream_filters.cc",
    "stream_filters.h",
  ]
}

# MOLT_RAW_PTR_EXCLUSION, for std-only code that holds a pointer field
# without //base's raw_ptr (header-only).
source_set("raw_ptr_exclusion") {
  sources = [ "raw_ptr_exclusion.h" ]
}

# Everything the engine (//chrome/services/molt_ai/inference) uses.
source_set("inference_utils") {
  sources = [
    "context_budget.cc",
    "context_budget.h",
    "prompt_utils.cc",
    "prompt_utils.h",
  ]
  public_deps = [ ":stream_filters" ]
}

# Constrained decoding (docs/design/SANDBOXED_INFERENCE.md section 9): the
# bounded JSON reader, JSON Schema -> GBNF, and the token rules the grammar
# sampler (//chrome/services/molt_ai/inference:grammar_sampler.cc) applies.
source_set("constrained_decoding") {
  sources = [
    "bounded_json.cc",
    "bounded_json.h",
    "grammar_tokens.cc",
    "grammar_tokens.h",
    "json_schema_grammar.cc",
    "json_schema_grammar.h",
  ]
  deps = [ ":inference_utils" ]
}

# Image input (docs/design/SANDBOXED_INFERENCE.md section 10): the bounds a
# model image must meet and how a decoded image is brought within them.
# Also linked by the browser (//chrome/browser/molt_ai/runtime:model_image),
# which prepares images; the service checks them again.
source_set("image_input") {
  sources = [
    "image_input.cc",
    "image_input.h",
  ]
}

# Audio input (docs/design/SANDBOXED_INFERENCE.md section 13): the bounds a
# model audio clip must meet and how a page's decoded audio is brought
# within them. Also linked by the browser
# (//chrome/browser/molt_ai/runtime), which prepares the clips; the service
# checks them again.
source_set("audio_input") {
  sources = [
    "audio_input.cc",
    "audio_input.h",
  ]
}

# Token fitting and vector normalization for the embedding engine
# (llama_embedding_engine.cc; docs/design/SEMANTIC_SEARCH.md).
source_set("embedding_utils") {
  sources = [
    "embedding_utils.cc",
    "embedding_utils.h",
  ]
}

# GPU inference on Linux and Windows (llama.cpp's Vulkan backend; GN switch
# molt_llama_vulkan, docs/design/SANDBOXED_INFERENCE.md section 11.5): which
# GPU to use and how many layers fit on it. Built whatever the switch says,
# so its tests always run.
source_set("gpu_offload") {
  sources = [
    "gpu_offload.cc",
    "gpu_offload.h",
  ]
}

# The Vulkan pipeline cache's header check (docs/design/SANDBOXED_INFERENCE.md
# section 11.12). Also linked by the browser
# (//chrome/browser/molt_ai:molt_ai_runtime), which stores the cache files
# the service sends; both sides check the header against the device.
source_set("gpu_pipeline_cache") {
  sources = [
    "gpu_pipeline_cache.cc",
    "gpu_pipeline_cache.h",
  ]
}

# Which of llama.cpp's x86-64 CPU kernel sets this CPU runs
# (docs/design/SANDBOXED_INFERENCE.md section 12): CPUID and XCR0 in, a
# level out. Built on every platform, so its tests always run.
source_set("cpu_kernels") {
  sources = [
    "cpu_kernels.cc",
    "cpu_kernels.h",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "audio_input_unittest.cc",
    "bounded_json_unittest.cc",
    "context_budget_unittest.cc",
    "cpu_kernels_unittest.cc",
    "embedding_utils_unittest.cc",
    "gpu_offload_unittest.cc",
    "gpu_pipeline_cache_unittest.cc",
    "grammar_tokens_unittest.cc",
    "image_input_unittest.cc",
    "json_schema_grammar_unittest.cc",
    "prompt_utils_unittest.cc",
    "stream_filters_unittest.cc",
  ]
  deps = [
    ":audio_input",
    ":constrained_decoding",
    ":cpu_kernels",
    ":embedding_utils",
    ":gpu_offload",
    ":gpu_pipeline_cache",
    ":image_input",
    ":inference_utils",
    "//testing/gtest",
  ]
}
