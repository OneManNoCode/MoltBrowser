#
# libFuzzer targets for the sandboxed inference service's parsers of
# untrusted input: the JSON Schemas web pages pass (and the grammars made
# of them, checked in llama.cpp's own grammar engine), model output, and
# what a model file says about itself. See docs/FUZZING.md.
#
# Built with a fuzzing engine (use_libfuzzer / use_centipede, as ClusterFuzz
# builds Chromium); a no-op group otherwise. The same sources build
# standalone with tools/fuzz/molt_fuzz.py.

import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("molt_bounded_json_fuzzer") {
  sources = [ "molt_bounded_json_fuzzer.cc" ]
  deps = [
    "//base",
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
  ]
  dict = "dicts/json.dict"
  seed_corpuses = [
    "corpus/molt_bounded_json_fuzzer",
    "corpus/molt_json_schema_grammar_fuzzer",
  ]
  libfuzzer_options = [ "max_len=8192" ]
}

fuzzer_test("molt_json_schema_grammar_fuzzer") {
  sources = [ "molt_json_schema_grammar_fuzzer.cc" ]
  deps = [
    "//base",
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
  ]
  dict = "dicts/json.dict"
  seed_corpus = "corpus/molt_json_schema_grammar_fuzzer"
  libfuzzer_options = [ "max_len=8192" ]
}

# Every grammar the converter accepts goes through llama.cpp's GBNF parser
# and a walk of its accept path (only this directory may link llama.cpp).
fuzzer_test("molt_json_schema_grammar_llama_fuzzer") {
  sources = [ "molt_json_schema_grammar_llama_fuzzer.cc" ]
  deps = [
    "//base",
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//third_party/llama_cpp",
  ]
  dict = "dicts/json.dict"
  seed_corpus = "corpus/molt_json_schema_grammar_llama_fuzzer"
  libfuzzer_options = [ "max_len=8192" ]
}

