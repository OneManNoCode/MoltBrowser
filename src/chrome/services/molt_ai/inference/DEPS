include_rules = [
  "+chrome/services/molt_ai/inference",
  # Only this directory may use llama.cpp (GN visibility enforces it too).
  "+third_party/llama_cpp/include",
  # The exception guard around llama.cpp calls that can reach a GPU
  # (docs/design/SANDBOXED_INFERENCE.md section 11.6).
  "+third_party/llama_cpp/chromium/llama_guard.h",
  # Image input: llama.cpp's multimodal library (its public header only).
  "+third_party/llama_cpp/tools/mtmd/mtmd.h",
  # Which x86-64 CPU kernel level ggml runs
  # (docs/design/SANDBOXED_INFERENCE.md section 12).
  "+third_party/llama_cpp/chromium/ggml-cpu-x86-dispatch.h",
]

specific_include_rules = {
  # Runs each level's kernels through ggml's type traits.
  "x86_cpu_kernels_unittest\.cc": [
    "+third_party/llama_cpp/ggml/include/ggml.h",
    "+third_party/llama_cpp/ggml/include/ggml-cpu.h",
  ],
  # ggml-vulkan's packed shaders: inflates them as ggml-vulkan does and
  # checks the weight types left out.
  "vulkan_shader_pack_unittest\.cc": [
    "+third_party/brotli/include/brotli/decode.h",
    "+third_party/llama_cpp/chromium/ggml-vulkan-shader-pack.h",
    "+third_party/llama_cpp/ggml/include/ggml.h",
  ],
}
