#
# The on-device inference service (molt_ai.mojom.MoltInferenceService): the
# only code that links llama.cpp. It runs in a utility process sandboxed with
# kOnDeviceModelExecution; chrome/utility/services.cc registers it with
#   services.Add(molt_ai::RunMoltInferenceService);
# Design: docs/design/SANDBOXED_INFERENCE.md.

assert(!is_android && !is_ios,
       "On-device inference isn't built for Android or iOS (not registered)")

source_set("inference") {
  sources = [
    "grammar_sampler.cc",
    "grammar_sampler.h",
    "llama_embedding_engine.cc",
    "llama_embedding_engine.h",
    "llama_engine.cc",
    "llama_engine.h",
    "molt_embedding_model_impl.cc",
    "molt_embedding_model_impl.h",
    "molt_inference_service.cc",
    "molt_inference_service.h",
    "molt_model_impl.cc",
    "molt_model_impl.h",
  ]

  public_deps = [
    "//base",
    "//chrome/services/molt_ai/inference/public/mojom",
    "//mojo/public/cpp/bindings",
  ]

  deps = [
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//chrome/services/molt_ai/inference/engine:cpu_kernels",
    "//chrome/services/molt_ai/inference/engine:embedding_utils",
    "//chrome/services/molt_ai/inference/engine:gpu_offload",
    "//chrome/services/molt_ai/inference/engine:gpu_pipeline_cache",
    "//chrome/services/molt_ai/inference/engine:image_input",
    "//chrome/services/molt_ai/inference/engine:inference_utils",
    "//mojo/public/cpp/base",
    "//third_party/llama_cpp",

    # The exception boundary for llama.cpp calls that can reach a GPU, and
    # the Vulkan backend with molt_llama_vulkan
    # (docs/design/SANDBOXED_INFERENCE.md section 11).
    "//third_party/llama_cpp:llama_guard",

    # Image input (docs/design/SANDBOXED_INFERENCE.md section 10).
    "//third_party/llama_cpp:mtmd",
  ]
}

# llama.cpp's x86-64 CPU kernel levels agree with each other
# (docs/design/SANDBOXED_INFERENCE.md section 12). Picked up by
# //chrome/browser/molt_ai/test:molt_ai_unittests on x64.
if (current_cpu == "x64") {
  source_set("x86_cpu_kernels_unittests") {
    testonly = true
    sources = [ "x86_cpu_kernels_unittest.cc" ]
    deps = [
      "//chrome/services/molt_ai/inference/engine:cpu_kernels",
      "//testing/gtest",
      "//third_party/llama_cpp:ggml",
    ]
  }
}
