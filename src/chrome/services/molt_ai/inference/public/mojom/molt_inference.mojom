// On-device LLM inference (llama.cpp) in a sandboxed utility process.
// Design and threat model: docs/design/SANDBOXED_INFERENCE.md.
//
// Trust: the browser is the client and treats everything the service sends as
// hostile (chrome/browser/molt_ai/runtime/stream_validator.h). The service
// trusts the browser but still enforces the caps below, as a second line of
// defence.
module molt_ai.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";
import "mojo/public/mojom/base/big_string.mojom";
import "mojo/public/mojom/base/file.mojom";
import "sandbox/policy/mojom/context.mojom";
import "sandbox/policy/mojom/sandbox.mojom";

// Caps on what the browser sends. A request over a cap is a bad message.
const uint32 kMaxHistoryTurns = 512;
const uint32 kMaxConversationKeyBytes = 128;
const uint32 kMaxStopSequences = 8;
const uint32 kMaxStopSequenceBytes = 64;
// Per text field of a request (system prompt, context, a turn, the message).
const uint32 kMaxRequestTextBytes = 33554432;  // 32 MiB
const uint32 kMaxTokenizeTextBytes = 4194304;  // 4 MiB
// OutputConstraint.json_schema. Matches the converter's own cap
// (engine/json_schema_grammar.h kMaxSchemaBytes).
const uint32 kMaxConstraintSchemaBytes = 32768;  // 32 KiB

// Caps on what the service sends.
const uint32 kMaxChunkBytes = 4096;
const uint32 kMaxArchitectureBytes = 64;
// Smallest context the browser accepts in a ModelDescription.
const uint32 kMinDescribedContextTokens = 256;
// Most layers a ModelDescription may report on the GPU (the service reads at
// most 4096 repeating layers from a model, plus the output layer).
const uint32 kMaxGpuLayers = 4097;
// GpuDeviceIdentity.name (VkPhysicalDeviceProperties::deviceName is 256
// bytes with its NUL).
const uint32 kMaxGpuNameBytes = 255;
// ModelLoadParams.skip_gpu_drivers.
const uint32 kMaxSkippedGpuDrivers = 8;
// A pipeline cache, either way (engine/gpu_pipeline_cache.h
// kMaxPipelineCacheBytes).
const uint32 kMaxPipelineCacheBytes = 33554432;  // 32 MiB

// Image input (docs/design/SANDBOXED_INFERENCE.md section 10). The same
// bounds as chrome/services/molt_ai/inference/engine/image_input.h; an image
// outside them is a bad message.
const uint32 kMaxImageSide = 1024;
const uint32 kMinImageSide = 32;
// The long side is at most this many times the short side.
const uint32 kMaxImageAspectRatio = 8;
// Images in one request: the new message's and the history's together.
const uint32 kMaxImagesPerRequest = 4;

// An image for the model: already decoded, scaled and padded by the browser
// (Chromium's sandboxed image decoders; nothing in the service decodes a
// compressed image), 8-bit RGB, row-major, no row padding. Untrusted
// content, like page text: it may come from a web page.
struct ImageInput {
  // In [kMinImageSide, kMaxImageSide]; the long side at most
  // kMaxImageAspectRatio times the short one.
  uint32 width;
  uint32 height;
  // Exactly width * height * 3 bytes.
  mojo_base.mojom.BigBuffer rgb;
};

// What identifies a GPU's driver (docs/design/SANDBOXED_INFERENCE.md section
// 11.10): the browser keeps its GPU failure record under it.
struct GpuDriverKey {
  // VkPhysicalDeviceProperties::vendorID and deviceID.
  uint32 vendor_id;
  uint32 device_id;
  // VkDriverId; 0 when the driver doesn't report one.
  uint32 driver_id;
  // VkPhysicalDeviceProperties::driverVersion (the vendor's encoding).
  uint32 driver_version;
  // VkPhysicalDeviceIDProperties::driverUUID: the driver build.
  array<uint8, 16> driver_uuid;
};

// The GPU the service chose for a load, before anything is loaded on it.
// Untrusted, like everything the service sends: the browser sanitizes the
// name and turns nothing here into a path.
struct GpuDeviceIdentity {
  GpuDriverKey key;
  // VkPhysicalDeviceProperties::apiVersion.
  uint32 api_version;
  // VkPhysicalDeviceProperties::pipelineCacheUUID: what the device's
  // pipeline caches are valid for (section 11.12).
  array<uint8, 16> pipeline_cache_uuid;
  // VkPhysicalDeviceProperties::deviceName; at most kMaxGpuNameBytes.
  string name;
};

// Implemented by the browser for a load with use_gpu
// (docs/design/SANDBOXED_INFERENCE.md section 11.10).
interface GpuLoadClient {
  // The service listed the Vulkan devices and chose |device|, and waits for
  // the answer before it creates the device or loads anything on it, so a
  // driver that crashes the process from here on is known to the browser.
  // use_gpu false: load on the CPU (the browser's record turned this
  // driver off; GpuStatus kTurnedOff). With use_gpu, the pipeline cache the
  // browser kept for this device (section 11.12), read-only, not async;
  // null for none. At most once per load.
  OnGpuChosen(GpuDeviceIdentity device)
      => (bool use_gpu, mojo_base.mojom.ReadOnlyFile? pipeline_cache);
};

struct ModelLoadParams {
  // Opened read-only by the browser (never a path). Must not be async
  // (overlapped on Windows): llama.cpp reads it synchronously.
  mojo_base.mojom.ReadOnlyFile weights;
  // The size the browser saw; the service refuses a file of another size.
  uint64 file_size;
  // For sizing the context (ComputeContextSizing).
  uint64 total_ram_bytes;
  // n_threads / n_threads_batch. Clamped to [1, 256] by the service.
  uint32 cpu_threads;
  // Upper bound on the context; the service picks min(sizing, cap).
  uint32 max_context_tokens;
  // CPU weight repacking (use_extra_bufts). The service turns it off when
  // its sandbox memory limit is too small for it (cpu_repack_used says).
  bool allow_cpu_repack = true;
  // The model's vision projector (a second GGUF, llama.cpp's "mmproj"), for
  // image input; opened read-only like |weights|, not async. Null for a
  // text-only model.
  mojo_base.mojom.ReadOnlyFile? vision_projector;
  // Its size as the browser saw it (0 without one); the service refuses a
  // file of another size.
  uint64 vision_projector_size = 0;
  // Try the GPU with llama.cpp's Vulkan backend (Linux and Windows builds
  // with the GN switch molt_llama_vulkan; docs/design/SANDBOXED_INFERENCE.md
  // section 11). The service falls back to the CPU on its own; the browser
  // sends false again after a GPU failure. Ignored on macOS (Metal).
  bool use_gpu = false;
  // With use_gpu: asked about the chosen device before anything is loaded
  // on it. Without one the service doesn't use the GPU (kTurnedOff).
  pending_remote<GpuLoadClient>? gpu_client;
  // Drivers the browser's GPU record turned off: a device with one of these
  // keys is never chosen. At most kMaxSkippedGpuDrivers.
  array<GpuDriverKey> skip_gpu_drivers;
};

// What became of the GPU (Vulkan) for a load. The model runs on the CPU in
// every case but kOn.
enum GpuStatus {
  // Not requested (and on macOS, where Metal is used: backend "metal").
  kNotRequested,
  // Requested, but this build has no Vulkan backend.
  kNotBuilt,
  // No Vulkan loader, no instance, or no GPU the backend accepts.
  kNoDevice,
  // The device policy refused every GPU (software, layered or virtual
  // drivers, Vulkan below 1.2, under 2 GiB, a blocklisted driver).
  kNoUsableDevice,
  // Too little of the model fits in the GPU's free memory.
  kTooLittleMemory,
  // The model, its projector or its context failed on the GPU; it was loaded
  // on the CPU instead.
  kLoadFailed,
  // On the GPU, wholly or partly (gpu_layers); backend is "vulkan".
  kOn,
  // The browser's GPU record turned the chosen GPU's driver off (or every
  // usable GPU's), or there was no GpuLoadClient to ask.
  kTurnedOff,
  // The GPU was lost while the model was loaded on it; it was loaded on the
  // CPU instead. A GPU failure for the browser's record, unlike kLoadFailed.
  kDeviceLost,
};

enum LoadModelStatus {
  kOk,
  // The CPU lacks the instruction set the build needs (on x64, x86-64-v2:
  // SSE4.2 and POPCNT; better CPUs run AVX or AVX2 kernels).
  kUnsupportedCpu,
  // Not a GGUF llama.cpp can load, wrong size, or unreadable.
  kInvalidModelFile,
  // The context (KV cache, compute buffers) couldn't be allocated.
  kOutOfMemory,
  // No usable compute backend.
  kBackendUnavailable,
  // The vision projector isn't one llama.cpp can load for this model (not a
  // projector, made for another model, wrong size, or unreadable).
  kInvalidVisionProjector,
};

struct ModelDescription {
  // GGUF general.architecture, [a-z0-9_.-], at most kMaxArchitectureBytes.
  string architecture;
  // "metal" | "cpu" | "vulkan".
  string backend;
  // n_ctx allocated, in [kMinDescribedContextTokens, max_context_tokens].
  uint32 context_tokens;
  uint32 train_context_tokens;
  uint32 vocab_size;
  bool cpu_repack_used;
  // A vision projector is loaded: chat requests may carry images.
  bool vision = false;
  // kOn exactly when backend is "vulkan", which requires use_gpu.
  GpuStatus gpu_status = kNotRequested;
  // Layers on the GPU, the output layer counting as one: in
  // [1, kMaxGpuLayers] with kOn, else 0.
  uint32 gpu_layers = 0;
};

// The model service. One process per loaded model.
[ServiceSandbox=sandbox.mojom.Sandbox.kOnDeviceModelExecution,
 RequireContext=sandbox.mojom.Context.kBrowser]
interface MoltInferenceService {
  // At most once per process (a second call is a bad message). The model
  // lives while `model` is connected; the browser drops both pipes to unload,
  // which ends the process. `description` is set exactly when status is kOk.
  LoadModel(ModelLoadParams params, pending_receiver<Model> model)
      => (LoadModelStatus status, ModelDescription? description);

  // A text-embedding model instead of a chat model (semantic memory search,
  // docs/design/SEMANTIC_SEARCH.md). It counts as this process's one load:
  // calling it after LoadModel, or LoadModel after it, is a bad message.
  // `description` is set exactly when status is kOk.
  LoadEmbeddingModel(EmbeddingModelLoadParams params,
                     pending_receiver<EmbeddingModel> model)
      => (LoadModelStatus status, EmbeddingModelDescription? description);
};

// Whether a reasoning-capable model should think before answering (hidden
// from the user either way).
enum ReasoningMode {
  kOff,
  kOn,
};

enum ChatRole {
  kUser,
  kAssistant,
};

// A structure the visible answer must follow (constrained decoding,
// docs/design/SANDBOXED_INFERENCE.md section 9). Untrusted: it may come from
// a web page (LanguageModel.prompt()'s responseConstraint). The service
// converts it to a grammar for llama.cpp's grammar sampler; anything outside
// the supported subset completes the request with kConstraintUnsupported
// before it is queued.
union OutputConstraint {
  // A JSON Schema as JSON text, at most kMaxConstraintSchemaBytes (more is a
  // bad message). The answer is then JSON matching it, nothing else (no
  // reasoning, no surrounding text). The subset:
  // chrome/services/molt_ai/inference/engine/json_schema_grammar.h.
  string json_schema;
};

struct GenerationParams {
  // Visible-answer token budget; 0 = adaptive (AdaptiveReplyTokens).
  uint32 max_visible_tokens = 0;
  // Hidden reasoning budget; 0 = adaptive.
  uint32 max_reasoning_tokens = 0;
  ReasoningMode reasoning = ReasoningMode.kOff;
  float temperature = 0.7;
  float top_p = 0.9;
  uint32 top_k = 40;
  // KV-prefix reuse across turns of one conversation; "" = none. At most
  // kMaxConversationKeyBytes.
  string conversation_key;
  // Visible-text stops (applied after the reasoning filters; the stop text is
  // not emitted). At most kMaxStopSequences, each 1..kMaxStopSequenceBytes
  // bytes of UTF-8.
  array<string> stop_sequences;
  // Null = free text. With a constraint, `reasoning` is ignored (off).
  OutputConstraint? constraint;
};

struct ChatTurn {
  ChatRole role;
  mojo_base.mojom.BigString content;
  // A user turn's images, shown to the model before its text. On an
  // assistant turn they are a bad message.
  array<ImageInput> images;
};

// Mirrors molt_ai::ChatPrompt. The trust labels are the field names:
// system_prompt and context_preamble are browser-authored; context, history
// and user_message are untrusted and are neutralized before
// parse_special=true tokenization. The browser never concatenates untrusted
// text into system_prompt. Images (user_images and the history's) are
// untrusted too; a request with images needs a model with vision
// (ModelDescription.vision), else it completes with kImagesUnsupported
// before it is queued. At most kMaxImagesPerRequest images in all.
struct ChatRequest {
  string system_prompt;
  string context_preamble;
  mojo_base.mojom.BigString context;
  // Oldest first; at most kMaxHistoryTurns.
  array<ChatTurn> history;
  mojo_base.mojom.BigString user_message;
  // The new message's images, shown before its text.
  array<ImageInput> user_images;
};

// Agents and automation (BrowserAIRuntime::StreamPrompt / RunPrompt): no chat
// template; both parts are neutralized and tokenized with
// parse_special=false.
struct RawPromptRequest {
  string system_prompt;
  mojo_base.mojom.BigString prompt;
};

enum GenerationStatus {
  // The model emitted an end-of-generation token.
  kEndOfGeneration,
  // The visible or reasoning budget ran out.
  kMaxTokens,
  // A stop sequence matched.
  kStopSequence,
  // The context window is full.
  kContextFull,
  // Only seen by the service: the browser closed the streamer.
  kCancelled,
  // The request doesn't fit the context window even after trimming.
  kPromptTooLong,
  // The system prompt alone leaves no room (raw prompts).
  kSystemPromptTooLong,
  kTokenizeFailed,
  kDecodeFailed,
  // The OutputConstraint is outside the supported subset (an unsupported
  // keyword, invalid JSON, over a size, depth or ambiguity cap, or matching
  // nothing). Nothing was generated.
  kConstraintUnsupported,
  // The constraint couldn't be followed: llama.cpp refused the grammar, or
  // no token of this model's vocabulary continues it. The text so far is
  // incomplete.
  kConstraintFailed,
  // The request has images and the model has no vision projector. Nothing
  // was generated.
  kImagesUnsupported,
  // The GPU failed under the model (device lost, a driver error). The model
  // can't be used in this process any more: the browser ends it and loads
  // the model on the CPU next time.
  kBackendFailed,
};

struct GenerationSummary {
  GenerationStatus status;
  uint32 prompt_tokens;
  // Prompt tokens served from the KV cache of the previous turn.
  uint32 reused_tokens;
  // Visible + hidden.
  uint32 generated_tokens;
  // Whole history turns dropped to fit the window.
  uint32 history_dropped;
  bool context_trimmed;
  bool user_message_trimmed;
};

// Implemented by the browser. Closing it cancels the request, queued or
// running.
interface GenerationStreamer {
  // Liveness (and progress for the UI) while nothing visible is produced:
  // once when the request starts running (it may have waited behind
  // another), then at most every 500 ms during prompt evaluation (prompt
  // tokens evaluated / total) and while the model reasons (reasoning tokens /
  // budget). The browser kills a process that sends nothing for two minutes
  // while a request runs.
  OnProgress(uint32 done_tokens, uint32 total_tokens);
  // Visible text since the last chunk: complete, valid UTF-8, reasoning and
  // channel markers removed, stop sequences applied, never empty, at most
  // kMaxChunkBytes.
  OnChunk(string text);
  // Exactly once, last. The service drops the pipe afterwards.
  OnComplete(GenerationSummary summary);
};

interface Model {
  // Served one at a time, in arrival order; a request whose streamer is
  // closed when its turn comes is skipped.
  StreamChat(ChatRequest request, GenerationParams params,
             pending_remote<GenerationStreamer> streamer);
  StreamPrompt(RawPromptRequest request, GenerationParams params,
               pending_remote<GenerationStreamer> streamer);

  // Plain-text tokenization with this vocab (no BOS, parse_special=false).
  // Null on failure or if `text` is over kMaxTokenizeTextBytes. For tests, a
  // future context meter and memory chunking; no current browser caller
  // needs token ids, and they are never used for a security decision.
  Tokenize(mojo_base.mojom.BigString text) => (array<int32>? tokens);
  CountTokens(mojo_base.mojom.BigString text) => (uint32? count);

  // Drops a cached KV prefix (conversation deleted or cleared).
  ForgetConversation(string conversation_key);

  // The GPU's Vulkan pipeline cache (docs/design/SANDBOXED_INFERENCE.md
  // section 11.12), served after the requests before it. Pipelines compile on
  // first use, so the browser asks after a generation on the GPU. Null when
  // the model isn't on the GPU or nothing was compiled since the load or the
  // last cache sent; empty when the cache grew over kMaxPipelineCacheBytes
  // (the browser drops its copy); else at most kMaxPipelineCacheBytes,
  // starting with a version-one header for the reported device. Untrusted:
  // the browser checks the size and the header and parses nothing else.
  GetPipelineCache() => (mojo_base.mojom.BigBuffer? cache);
};

// ---- Text embeddings ---------------------------------------------------------
// Semantic search over AI memory (docs/design/SEMANTIC_SEARCH.md). The model
// is loaded with MoltInferenceService.LoadEmbeddingModel, in a process of its
// own; everything it returns is checked by the browser
// (chrome/browser/molt_ai/runtime/embedding_validator.h).

// Caps on what the browser sends. A request over a cap is a bad message.
const uint32 kMaxEmbedTexts = 16;              // texts per Embed() call
const uint32 kMaxEmbedTextBytes = 32768;       // per text, UTF-8, not empty
const uint32 kMinEmbedTokensPerText = 8;
const uint32 kMaxEmbedTokensPerText = 2048;
const uint32 kMaxEmbedTerminatorBytes = 64;
// Longest vector the browser asks for (and accepts).
const uint32 kMaxEmbeddingDimensions = 4096;

// How the model's per-token states become one vector per text. Set by the
// browser from its model registry (a GGUF doesn't always say).
enum EmbeddingPooling {
  kMean,
  kCls,
  kLast,
};

struct EmbeddingModelLoadParams {
  // Opened read-only by the browser (never a path); not async.
  mojo_base.mojom.ReadOnlyFile weights;
  // The size the browser saw; the service refuses a file of another size.
  uint64 file_size;
  // n_threads / n_threads_batch. Clamped to [1, 256] by the service.
  uint32 cpu_threads;
  EmbeddingPooling pooling;
  // Longer texts keep their first tokens (and the model's end marker). In
  // [kMinEmbedTokensPerText, kMaxEmbedTokensPerText].
  uint32 max_tokens_per_text;
  // A special token of the vocab, given by its text (e.g. "<|endoftext|>"),
  // that ends every text (models that pool the last token need it). "" =
  // none. At most kMaxEmbedTerminatorBytes; a vocab without it fails the
  // load with kInvalidModelFile.
  string terminator;
  // Length of the vectors Embed() returns: the first `dimensions` components
  // of the model's vector (Matryoshka truncation), then L2-normalized. In
  // [1, kMaxEmbeddingDimensions] and at most the model's own width.
  uint32 dimensions;
};

struct EmbeddingModelDescription {
  // GGUF general.architecture, [a-z0-9_.-], at most kMaxArchitectureBytes.
  string architecture;
  // "metal" | "cpu" | "vulkan".
  string backend;
  // The model's own vector width (n_embd_out).
  uint32 native_dimensions;
  // As requested.
  uint32 dimensions;
  // As requested, or less if the model's context is smaller.
  uint32 max_tokens_per_text;
  uint32 vocab_size;
};

// Served one call at a time, in arrival order.
interface EmbeddingModel {
  // One vector per text, concatenated in order: texts.size() * dimensions
  // floats. Each vector has an L2 norm of 1, or is all zeros for a text with
  // no tokens. Null if the model failed (the browser treats the whole call
  // as failed). 1..kMaxEmbedTexts texts, each 1..kMaxEmbedTextBytes bytes of
  // UTF-8; untrusted page text is fine (it is tokenized as plain text).
  Embed(array<string> texts) => (array<float>? vectors);
};
