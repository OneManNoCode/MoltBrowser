#
# Shared utilities for MoltBrowser features that don't belong in any
# specific subsystem.

source_set("common") {
  sources = [
    "molt_blocking_scope.h",

    # One click allows one thing (MoltBrowser's own pages).
    "molt_user_click.h",
  ]
  public_deps = [
    "//base",
  ]
}

# Which helper executables (tor, tesseract, whisper-cli) MoltBrowser may run
# (audit S18). trusted_binary.* is the pure POSIX policy (no //base) that
# molt_ai_unittests tests against a fake filesystem; helper_binary.* is the
# base::FilePath front end every caller uses.
source_set("trusted_binary") {
  sources = []
  if (is_posix) {
    sources += [
      "trusted_binary.cc",
      "trusted_binary.h",
    ]
  }
}

# Untrusted text from helper programs, made valid UTF-8 and cut safely.
source_set("helper_output") {
  sources = [
    "helper_output.cc",
    "helper_output.h",
  ]
  deps = [ "//base" ]
}

source_set("helper_binary") {
  sources = [
    "helper_binary.cc",
    "helper_binary.h",
  ]
  deps = [
    ":common",
    ":trusted_binary",
    "//base",
  ]
}

# The Linux confinement for OCR and voice helpers (Landlock + seccomp-bpf,
# applied between fork and exec). Pure Linux code without //base, so a
# standalone harness can run the same code against the kernel.
source_set("helper_sandbox_linux") {
  sources = []
  if (is_linux) {
    sources += [
      "helper_sandbox_linux.cc",
      "helper_sandbox_linux.h",
    ]
  }
}

# The macOS Seatbelt profile and sandbox-exec command line. Pure C++,
# built everywhere so its tests run everywhere.
source_set("seatbelt_profile") {
  sources = [
    "seatbelt_profile.cc",
    "seatbelt_profile.h",
  ]
}

# The Windows confinement for OCR and voice helpers, as data: the LPAC
# AppContainer, its attribute list, job, security descriptors and
# environment. Pure C++, built everywhere so its tests run everywhere;
# helper_sandbox_win.cc applies it.
source_set("helper_sandbox_win_policy") {
  sources = [
    "helper_sandbox_win_policy.cc",
    "helper_sandbox_win_policy.h",
  ]
}

# RunSandboxedHelper(): tesseract and whisper-cli with OS-level confinement
# and a deadline.
source_set("helper_sandbox") {
  sources = [
    "helper_sandbox.cc",
    "helper_sandbox.h",
  ]
  if (is_posix) {
    sources += [ "helper_sandbox_posix.cc" ]
  }
  public_deps = [ "//base" ]
  deps = [
    ":helper_output",
    ":helper_sandbox_linux",
    ":seatbelt_profile",
  ]
  if (is_win) {
    sources += [ "helper_sandbox_win.cc" ]

    # The sandbox library's AppContainer (and its LPAC access check),
    # attribute-list builder and job levels.
    deps += [
      ":helper_sandbox_win_policy",
      "//sandbox/win:sandbox",
    ]
  }
}

# A stand-in helper for the Windows tests: one action per command line
# (print, read, write, connect, start a process, allocate, spin), reporting
# what the sandbox let it do. Only system libraries.
if (is_win) {
  executable("molt_helper_sandbox_test_helper") {
    testonly = true
    sources = [ "helper_sandbox_test_helper_win.cc" ]
    libs = [ "ws2_32.lib" ]
  }
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "helper_output_unittest.cc",
    "helper_sandbox_unittest.cc",
    "helper_sandbox_win_policy_unittest.cc",
    "molt_user_click_unittest.cc",
  ]
  deps = [
    ":common",
    ":helper_output",
    ":helper_sandbox",
    ":helper_sandbox_linux",
    ":helper_sandbox_win_policy",
    ":seatbelt_profile",
    "//base",
    "//crypto",
    "//testing/gtest",
  ]
  if (is_posix) {
    sources += [ "trusted_binary_unittest.cc" ]
    deps += [ ":trusted_binary" ]
  }
  if (is_win) {
    # HelperSandboxWinTest runs it under the real confinement, and listens
    # on loopback for it.
    data_deps = [ ":molt_helper_sandbox_test_helper" ]
    libs = [ "ws2_32.lib" ]
  }
}
