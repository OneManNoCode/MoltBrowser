# BUILD.gn for MoltBrowser AI modules
# This file defines the build targets for all AI components
# that integrate into the Chromium browser build.

# The on-device model registry and the client of the sandboxed inference
# service. No llama.cpp: the model runs in a utility process
# (//chrome/services/molt_ai/inference, kOnDeviceModelExecution sandbox).
source_set("molt_ai_runtime") {
  sources = [
    "runtime/browser_ai_runtime.cc",
    "runtime/browser_ai_runtime.h",
    "runtime/inference_process_host.cc",
    "runtime/inference_process_host.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/molt_ai/runtime:model_image",
    "//chrome/browser/molt_ai/runtime:stream_validator",
    "//chrome/services/molt_ai/inference/public/mojom",
    "//content/public/browser",
  ]

  deps = [
    "//chrome/browser/lifetime:termination_notification",

    # When a model's files count as downloaded (std-only).
    "//chrome/browser/molt_ai/models:download_policy",
    "//chrome/services/molt_ai/inference/engine:image_input",
    "//chrome/services/molt_ai/inference/engine:stream_filters",

    # BUILDFLAG(MOLT_LLAMA_VULKAN): ask the service for the GPU
    # (docs/design/SANDBOXED_INFERENCE.md section 11).
    "//chrome/services/molt_ai/inference/public:buildflags",
    "//content/public/common",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
  ]
}

# HTML -> StructuredPage, linear time (no std::regex). Std-only, so the
# standalone unit-test binary links it.
source_set("molt_ai_dom_interpreter") {
  sources = [
    "dom/dom_interpreter.cc",
    "dom/dom_interpreter.h",
  ]
}

source_set("molt_ai_dom") {
  sources = [
    "dom/dom_content_bridge.cc",
    "dom/dom_content_bridge.h",
  ]

  public_deps = [ ":molt_ai_dom_interpreter" ]

  deps = [
    "//base",
    "//content/public/browser",
    "//url",
  ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("molt_ai_dom_unit_tests") {
  testonly = true
  sources = [ "dom/dom_interpreter_unittest.cc" ]
  deps = [
    ":molt_ai_dom_interpreter",
    "//testing/gtest",
  ]
}

# WebAgent — autonomous ReAct-loop browsing agent (it replaced the old
# AgentEngine, whose sources are gone). All JS in this agent is built
# through base::JSONWriter / JSQ().
source_set("molt_ai_agents") {
  sources = [
    "agents/agent_screenshot.cc",
    "agents/agent_screenshot.h",
    "agents/web_agent.cc",
    "agents/web_agent.h",
  ]

  deps = [
    ":molt_ai_dom",
    ":molt_ai_runtime",
    "//base",

    # chrome://flags/#molt-agent-screenshots, #molt-agent-site-tools and
    # #molt-agent-planner.
    "//chrome/browser/molt_ai/agents:features",

    # The screenshot scaled for the model on a worker (Skia).
    "//chrome/browser/molt_ai/runtime:model_image_prep",

    # molt_net_profile_id.h (header-only IsMoltNetProfile()).
    "//chrome/browser/molt_ai/tor",
    "//chrome/browser/profiles:profile",
    "//chrome/services/molt_ai/inference/engine:image_input",

    # The compositor's copy of the tab's view.
    "//components/viz/common",
    "//content/public/browser",
    "//content/public/common",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/base",
    "//ui/gfx/geometry",
    "//url",
  ]

  # web_agent.h exposes agent_safety types (navigation allowlist, element
  # probe, prompt fencing), the action format (agents/agent_actions.h), the
  # planner (agents/agent_plan.h), the prompt (agents/agent_prompt.h) and
  # the screenshot logic (agents/agent_vision.h, runtime/model_image.h).
  public_deps = [
    "//chrome/browser/molt_ai/agents:agent_actions",
    "//chrome/browser/molt_ai/agents:agent_plan",
    "//chrome/browser/molt_ai/agents:agent_prompt",
    "//chrome/browser/molt_ai/agents:agent_vision",
    "//chrome/browser/molt_ai/runtime:model_image",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]
}

# AI Omnibox provider is in //components/omnibox/browser/ai_prompt_provider.*
# (registered directly in autocomplete_controller.cc)

# Browser profile importer — read/parse/decrypt CORE for the "Import from
# another browser" migration feature (bookmarks + passwords) across the
# Chromium family (Chrome, Chromium, Edge, Brave, Opera, Vivaldi) plus Firefox
# and Safari. Pure data layer, no UI, no writes. Password import is supported on
# mac/win/linux (per-vendor os_crypt scheme); Firefox/Safari are bookmarks-only.
# chrome_importer.h is a header-only back-compat shim over BrowserImporter.
source_set("molt_ai_import") {
  sources = [
    "import/browser_importer.cc",
    "import/browser_importer.h",
    "import/chrome_importer.h",
    "import/firefox_safari_reader.cc",
  ]

  deps = [
    "//base",
    "//crypto",
    "//sql",
    "//url",
  ]

  if (is_mac) {
    frameworks = [
      "CoreFoundation.framework",
      "Foundation.framework",
      "Security.framework",
    ]
  }

  if (is_win) {
    libs = [ "crypt32.lib" ]
  }

  if (is_linux) {
    # libsecret is dlopen()'d at runtime (see ReadLibsecretPassword); libdl is
    # needed for dlopen/dlsym.
    libs = [ "dl" ]
  }
}

# AI Side Panel — chat interface in the browser sidebar
source_set("molt_ai_side_panel") {
  sources = [
    "side_panel/agent_side_panel_web_view.cc",
    "side_panel/agent_side_panel_web_view.h",
    "side_panel/ai_chat_side_panel_coordinator.cc",
    "side_panel/ai_chat_side_panel_coordinator.h",
    "side_panel/ai_chat_side_panel_web_view.cc",
    "side_panel/ai_chat_side_panel_web_view.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/pdf/common:constants",
    "//content/public/browser",
    "//content/public/common",
    "//ui/accessibility",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}

# MoltShield — ad/tracker blocker on Brave's adblock-rust. Targets live in
# shield/BUILD.gn; this alias keeps the ":molt_shield" name used below.
group("molt_shield") {
  public_deps = [ "shield" ]
}

# In-app updater. GitHub Releases is the transport; trust comes from a
# release manifest signed by an offline Ed25519 key (update/release_manifest.h).
source_set("molt_update") {
  sources = [
    "update/release_manifest.cc",
    "update/release_manifest.h",
    "update/update_manager.cc",
    "update/update_manager.h",
    "update/update_signing_keys.cc",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/common",
    "//chrome/common",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/boringssl",
    "//url",
  ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("molt_update_unit_tests") {
  testonly = true
  sources = [ "update/release_manifest_unittest.cc" ]
  deps = [
    ":molt_update",
    "//base",
    "//testing/gtest",
  ]
}

# Combined target for all AI modules
group("molt_ai") {
  deps = [
    ":molt_ai_runtime",
    ":molt_ai_dom",
    ":molt_ai_agents",
    ":molt_ai_import",
    ":molt_shield",
    ":molt_update",
    "automation:automation",
    "common:common",
    # chrome_content_browser_client.cc registers OnionNavigationThrottle.
    "tor:onion",
    # ssl/https_upgrades_interceptor.cc exempts .onion (onion_util.h).
    "tor:protocol",
    # Keeps the regular profile's extensions and services out of MoltNet
    # windows; called from the extensions, profiles and ssl hooks.
    "tor:isolation",
    # No WebRTC networking in MoltNet windows; called from
    # chrome_content_browser_client{,_receiver_bindings}.cc.
    "tor:webrtc",

    # Fingerprinting protection: session seed + renderer switches (the engine
    # is in Blink, //third_party/blink/renderer/core/molt_fingerprinting).
    "fingerprinting",

    # The web agent's screenshots switch; about_flags.cc lists it.
    "agents:features",

    # MoltNet's touch / pointer / hover preferences and CPU tier; called
    # from chrome_content_browser_client.cc.
    "fingerprinting:device",

    # S19: keeps web pages from opening chrome:// / molt:// pages; used by
    # chrome_content_browser_client.cc.
    "security:webui_navigation_throttle",

    # The web's built-in AI APIs (LanguageModel, Summarizer, Writer,
    # Rewriter) on the on-device model; chrome_content_browser_client.cc
    # binds blink.mojom.AIManager to it.
    "web_ai",

    # Page translation on the on-device model: chrome_translate_client.cc
    # creates its driver, translate_service.cc installs its languages.
    "translate",
  ]

  # Desktop-only UI targets (side panel requires views framework)
  if (!is_android && !is_ios) {
    deps += [
      ":molt_ai_side_panel",

      # The Translate bubble's on-device footnote (translate_bubble_view.cc).
      "translate:footnote_view",

      # MoltNet letterboxing in the window (ContentsWebView's hooks).
      "fingerprinting:letterbox_view",
    ]
  }
}

# Reachable handle for the standalone test binary. GN only enumerates
# BUILD.gn files for targets in the active build graph, so without
# this referencing edge the test() target in molt_ai/test/ would be
# invisible to `autoninja molt_ai_unittests`. data_deps doesn't
# propagate testonly, so this lives in its own group.
group("molt_ai_tests") {
  testonly = true
  deps = [
    # libFuzzer targets (no-op groups without a fuzzing engine).
    "fuzzers:molt_fuzzers",
    "test:molt_ai_unittests",
  ]
}
