# BUILD.gn for MoltBrowser AI modules
# This file defines the build targets for all AI components
# that integrate into the Chromium browser build.

source_set("molt_ai_runtime") {
  sources = [
    "runtime/browser_ai_runtime.cc",
    "runtime/browser_ai_runtime.h",
    "runtime/prompt_router.cc",
    "runtime/prompt_router.h",
  ]

  deps = [
    "//base",
    "//third_party/llama_cpp",
  ]
}

source_set("molt_ai_dom") {
  sources = [
    "dom/dom_interpreter.cc",
    "dom/dom_interpreter.h",
    "dom/dom_content_bridge.cc",
    "dom/dom_content_bridge.h",
  ]

  deps = [
    "//base",
    "//content/public/browser",
    "//url",
  ]
}

source_set("molt_ai_agents") {
  sources = [
    "agents/agent_engine.cc",
    "agents/agent_engine.h",
  ]

  deps = [
    ":molt_ai_dom",
    ":molt_ai_runtime",
    ":molt_ai_security",
    "//base",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}

source_set("molt_ai_security") {
  sources = [
    "security/action_validator.cc",
    "security/action_validator.h",
  ]

  deps = [
    "//base",
  ]
}

source_set("molt_ai_embeddings") {
  sources = [
    "embeddings/minilm_embedder.cc",
    "embeddings/minilm_embedder.h",
  ]

  deps = [
    "//base",
  ]
}

source_set("molt_ai_memory") {
  sources = [
    "memory/memory_engine.cc",
    "memory/memory_engine.h",
  ]

  deps = [
    ":molt_ai_embeddings",
    "//base",
  ]
}

source_set("molt_ai_personas") {
  sources = [
    "personas/persona_system.cc",
    "personas/persona_system.h",
  ]

  deps = [
    "//base",
  ]
}

source_set("molt_ai_models") {
  sources = [
    "models/model_manager.cc",
    "models/model_manager.h",
    "models/model_downloader.cc",
    "models/model_downloader.h",
  ]

  deps = [
    ":molt_ai_runtime",
    "//base",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}

source_set("molt_ai_api") {
  sources = [
    "api/browser_ai_api.cc",
    "api/browser_ai_api.h",
  ]

  deps = [
    ":molt_ai_runtime",
    "//base",
  ]
}

# AI Omnibox provider is in //components/omnibox/browser/ai_prompt_provider.*
# (registered directly in autocomplete_controller.cc)

# AI Side Panel — chat interface in the browser sidebar
source_set("molt_ai_side_panel") {
  sources = [
    "side_panel/ai_chat_side_panel_coordinator.cc",
    "side_panel/ai_chat_side_panel_coordinator.h",
    "side_panel/ai_chat_side_panel_web_view.cc",
    "side_panel/ai_chat_side_panel_web_view.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/pdf/common:constants",
    "//content/public/browser",
    "//ui/accessibility",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}

# MoltShield — Ad blocker + privacy engine (ABP filter syntax, EasyList/uBlock)
source_set("molt_shield") {
  sources = [
    "shield/molt_shield.cc",
    "shield/molt_shield.h",
    "shield/filter_list_manager.cc",
    "shield/filter_list_manager.h",
    "shield/molt_shield_service.cc",
    "shield/molt_shield_service.h",
    "shield/molt_shield_throttle.cc",
    "shield/molt_shield_throttle.h",
  ]

  deps = [
    "//base",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# Auto-update — platform-specific implementations
if (is_mac) {
  source_set("molt_update_mac") {
    sources = [
      "update/sparkle_integration.h",
      "update/sparkle_integration.mm",
    ]

    configs -= [ "//build/config/compiler:enable_arc" ]
    configs += [ "//build/config/compiler:enable_arc" ]

    deps = [
      "//base",
    ]

    frameworks = [
      "Foundation.framework",
    ]
  }
}

if (is_win) {
  source_set("molt_update_win") {
    sources = [
      "update/winsparkle_integration.h",
      "update/winsparkle_integration.cc",
    ]

    deps = [
      "//base",
    ]
  }
}

if (is_linux) {
  source_set("molt_update_linux") {
    sources = [
      "update/linux_update_integration.h",
      "update/linux_update_integration.cc",
    ]

    deps = [
      "//base",
    ]
  }
}

# Cross-platform update manager facade
source_set("molt_update") {
  sources = [
    "update/update_manager.h",
    "update/update_manager.cc",
  ]

  deps = [
    "//base",
  ]

  if (is_mac) {
    deps += [ ":molt_update_mac" ]
  }
  if (is_win) {
    deps += [ ":molt_update_win" ]
  }
  if (is_linux) {
    deps += [ ":molt_update_linux" ]
  }
}

# Combined target for all AI modules
group("molt_ai") {
  deps = [
    ":molt_ai_runtime",
    ":molt_ai_dom",
    ":molt_ai_agents",
    ":molt_ai_security",
    ":molt_ai_memory",
    ":molt_ai_personas",
    ":molt_ai_models",
    ":molt_ai_api",
    ":molt_ai_embeddings",
    ":molt_shield",
    ":molt_update",
    "automation:automation",
    "common:common",
  ]

  # Desktop-only UI targets (side panel requires views framework)
  if (!is_android && !is_ios) {
    deps += [
      ":molt_ai_side_panel",
    ]
  }
}
