# AI Omnibox provider is in //components/omnibox/browser/ai_prompt_provider.*
# (registered directly in autocomplete_controller.cc)

# Browser profile importer — read/parse/decrypt CORE for the "Import from
# another browser" migration feature (bookmarks + passwords) across the
# Chromium family (Chrome, Chromium, Edge, Brave, Opera, Vivaldi) plus Firefox
# and Safari. Pure data layer, no UI, no writes. Password import is supported on
# mac/win/linux (per-vendor os_crypt scheme); Firefox/Safari are bookmarks-only.
# chrome_importer.h is a header-only back-compat shim over BrowserImporter.
source_set("molt_ai_import") {
  sources = [
    "import/browser_importer.cc",
    "import/browser_importer.h",
    "import/chrome_importer.h",
    "import/firefox_safari_reader.cc",
  ]

  deps = [
    "//base",
    "//crypto",
    "//sql",
    "//url",
  ]

  if (is_mac) {
    frameworks = [
      "CoreFoundation.framework",
      "Foundation.framework",
      "Security.framework",
    ]
  }

  if (is_win) {
    libs = [ "crypt32.lib" ]
  }

  if (is_linux) {
    # libsecret is dlopen()'d at runtime (see ReadLibsecretPassword); libdl is
    # needed for dlopen/dlsym.
    libs = [ "dl" ]
  }
}

# AI Side Panel — chat interface in the browser sidebar
source_set("molt_ai_side_panel") {
  sources = [
    "side_panel/agent_side_panel_web_view.cc",
    "side_panel/agent_side_panel_web_view.h",
    "side_panel/ai_chat_side_panel_coordinator.cc",
    "side_panel/ai_chat_side_panel_coordinator.h",
    "side_panel/ai_chat_side_panel_web_view.cc",
    "side_panel/ai_chat_side_panel_web_view.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//components/pdf/common:constants",
    "//content/public/browser",
    "//content/public/common",
    "//ui/accessibility",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}

# MoltShield — ad/tracker blocker on Brave's adblock-rust. Targets live in
# shield/BUILD.gn; this alias keeps the ":molt_shield" name used below.
group("molt_shield") {
  public_deps = [ "shield" ]
}

# In-app updater. GitHub Releases is the transport; trust comes from a
# release manifest signed by an offline Ed25519 key (update/release_manifest.h).
source_set("molt_update") {
  sources = [
    "update/release_manifest.cc",
    "update/release_manifest.h",
    "update/update_manager.cc",
    "update/update_manager.h",
    "update/update_signing_keys.cc",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/common",
    "//chrome/common",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/boringssl",
    "//url",
  ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("molt_update_unit_tests") {
  testonly = true
  sources = [ "update/release_manifest_unittest.cc" ]
  deps = [
    ":molt_update",
    "//base",
    "//testing/gtest",
  ]
}

# Combined target for all AI modules
group("molt_ai") {
  deps = [
    ":molt_ai_runtime",
    ":molt_ai_dom",
    ":molt_ai_agents",
    ":molt_ai_security",
    ":molt_ai_memory",
    ":molt_ai_personas",
    ":molt_ai_models",
    ":molt_ai_api",
    ":molt_ai_embeddings",
    ":molt_ai_import",
    ":molt_shield",
    ":molt_update",
    "automation:automation",
    "common:common",
    # chrome_content_browser_client.cc registers OnionNavigationThrottle.
    "tor:onion",
  ]

  # Desktop-only UI targets (side panel requires views framework)
  if (!is_android && !is_ios) {
    deps += [
      ":molt_ai_side_panel",
    ]
  }
}

# Reachable handle for the standalone test binary. GN only enumerates
# BUILD.gn files for targets in the active build graph, so without
# this referencing edge the test() target in molt_ai/test/ would be
# invisible to `autoninja molt_ai_unittests`. data_deps doesn't
# propagate testonly, so this lives in its own group.
group("molt_ai_tests") {
  testonly = true
  deps = [
    "test:molt_ai_unittests",
  ]
}
