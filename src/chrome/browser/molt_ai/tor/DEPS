specific_include_rules = {
  # MoltNet's address normalizer and region loader: libaddressinput with no
  # source and no cache of rules (molt_net_autofill.h).
  "molt_net_autofill\.cc": [
    "+third_party/libaddressinput/src/cpp/include/libaddressinput/null_storage.h",
    "+third_party/libaddressinput/src/cpp/include/libaddressinput/source.h",
  ],
  # MoltNet's default fonts must be ones every machine of the OS has: the
  # test checks them against Blink's allow-lists (std + //base only).
  "molt_net_locale_prefs_unittest\.cc": [
    "+third_party/blink/renderer/core/molt_fingerprinting/font_allowlists.h",
    "+third_party/blink/renderer/core/molt_fingerprinting/fonts.h",
  ],
  # The registry behind MoltNet's per-site keepalive limits (std-only).
  "molt_net_keepalive_partitions_unittest\.cc": [
    "+services/network/molt_keepalive_partitions.h",
  ],
  # Which isolation MoltNet's downloads carry (std-only).
  "molt_net_download_isolation_unittest\.cc": [
    "+content/browser/download/molt_download_isolation_policy.h",
    "+content/browser/download/molt_resumed_fetch_policy.h",
  ],
  # What a deletion of one storage key reads (std-only).
  "molt_net_one_key_deletion_unittest\.cc": [
    "+content/browser/browsing_data/molt_one_key_deletion_policy.h",
  ],
  # Which renderer processes serve one BrowsingInstance (std-only).
  "molt_net_process_policy_unittest\.cc": [
    "+content/browser/renderer_host/molt_browsing_instance_processes_policy.h",
  ],
  # What MoltNet's Background Fetch requests carry (header-only).
  "molt_net_background_fetch_request_unittest\.cc": [
    "+components/download/internal/background_service/molt_registering_site_isolation.h",
  ],
  # The network key of MoltNet's certificate fetches (header-only).
  "molt_net_cert_fetch_site_unittest\.cc": [
    "+services/cert_verifier/cert_net_url_loader/molt_cert_fetch_isolation.h",
  ],
  # The credentials mode a Background Fetch request carries, through a real
  # NetworkContext (header-only policy).
  "molt_net_background_fetch_credentials_unittest\.cc": [
    "+components/download/internal/common/molt_fetch_credentials.h",
    "+components/download/internal/common/molt_resumed_fetch.h",
    "+services/network/network_context.h",
  ],
  # What a page's Background Fetch taken up in a later session carries
  # (header-only).
  "molt_net_background_fetch_restored_unittest\.cc": [
    "+components/download/internal/background_service/molt_restored_fetch.h",
  ],
  # When MoltNet's Background Fetches run and how much they may buffer
  # (std-only).
  "molt_net_background_fetch_scheduling_unittest\.cc": [
    "+components/download/internal/background_service/molt_in_memory_download_limits.h",
    "+content/browser/background_fetch/molt_background_fetch_site_policy.h",
  ],
  # MoltNet's DOM storage grouped, budgeted and scheduled per site, on its
  # own threads, with the storage service's own LocalStorageImpl and
  # SessionStorageImpl.
  "molt_net_dom_storage_site_policy_unittest\.cc": [
    "+components/services/storage/dom_storage/molt_dom_storage_fair_queue.h",
    "+components/services/storage/dom_storage/molt_dom_storage_site_policy.h",
    "+components/services/storage/dom_storage/molt_dom_storage_split_work.h",
  ],
  "molt_net_dom_storage_unittest\.cc": [
    "+components/services/storage/dom_storage/db_status.h",
    "+components/services/storage/dom_storage/dom_storage_database.h",
    "+components/services/storage/dom_storage/local_storage_impl.h",
    "+components/services/storage/dom_storage/molt_dom_storage_own_thread.h",
    "+components/services/storage/dom_storage/molt_dom_storage_site_policy.h",
    "+components/services/storage/dom_storage/session_storage_impl.h",
    "+components/services/storage/dom_storage/session_storage_namespace_impl.h",
    "+components/services/storage/dom_storage/storage_area_impl.h",
  ],
  "molt_net_storage_groups_unittest\.cc": [
    "+components/services/storage/dom_storage/molt_dom_storage_site.h",
  ],
  # What one tab's or site's sessionStorage work makes others wait for
  # (std-only).
  "molt_net_dom_storage_waits_unittest\.cc": [
    "+components/services/storage/dom_storage/molt_dom_storage_waits.h",
  ],
  # An ended identity's network context refuses everything after the end
  # (std-only policy; a real NetworkContext and ProxyConfigServiceMojo).
  "molt_net_end_ordering_unittest\.cc": [
    "+services/network/molt_ended_identity_policy.h",
  ],
  "molt_net_ended_identity_network_unittest\.cc": [
    "+services/network/molt_ended_identity_policy.h",
    "+services/network/network_context.h",
    "+services/network/molt_own_session_sockets_policy.h",
    "+services/network/proxy_config_service_mojo.h",
  ],
}
