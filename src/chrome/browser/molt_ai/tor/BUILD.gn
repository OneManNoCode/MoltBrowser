#
# Tor integration for MoltBrowser (MoltNet).
#   tor_manager.*            — runs/supervises the bundled tor (auto ports,
#                              TAKEOWNERSHIP, bridges, exit country)
#   tor_control_connection.* — SAFECOOKIE-authenticated control client
#   tor_service.*            — read-only circuit/status queries
#   molt_net_routing.*       — the isolated MoltNet (Tor) profile

# Pure, I/O-free logic: control-protocol parsing, SAFECOOKIE, torrc generation
# and bridge-line validation. Split out so molt_ai_unittests can test it
# without pulling in Profile / content.
source_set("protocol") {
  sources = [
    "tor_control_protocol.cc",
    "tor_control_protocol.h",
    "torrc_builder.cc",
    "torrc_builder.h",
  ]
  deps = [
    "//base",
    # SAFECOOKIE control-port auth (HMAC-SHA256).
    "//crypto",
  ]
}

source_set("tor") {
  sources = [
    "exit_country_names.h",
    "molt_net_routing.cc",
    "molt_net_routing.h",
    "tor_control_connection.cc",
    "tor_control_connection.h",
    "tor_manager.cc",
    "tor_manager.h",
    "tor_service.cc",
    "tor_service.h",
  ]

  public_deps = [ ":protocol" ]

  deps = [
    "//base",
    # molt_net_routing.cc applies leak-safe proxy/WebRTC/QUIC prefs to the
    # profile that opts into MoltNet.
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//components/prefs",
    "//components/proxy_config",
    # Random SAFECOOKIE client nonces (crypto/random.h).
    "//crypto",
  ]

  # tor_service.cc / tor_manager.cc talk to the Tor control port over
  # raw sockets. On Windows that means winsock2, which needs ws2_32.
  if (is_win) {
    libs = [ "ws2_32.lib" ]
  }
}

# Pure-logic tests (control protocol parsing, SAFECOOKIE HMAC vectors, torrc
# generation, bridge-line validation). Picked up by
# //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "tor_control_protocol_unittest.cc",
    "torrc_builder_unittest.cc",
  ]
  deps = [
    ":protocol",
    "//base",
    "//testing/gtest",
  ]
}
