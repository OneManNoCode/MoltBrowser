#
# Tor integration for MoltBrowser.
#   Phase B.1 — control-port reader (tor_service.*)
#   Phase B.2 — subprocess launcher + GeoIP enrichment (tor_manager.*)

source_set("tor") {
  sources = [
    "exit_country_names.h",
    "tor_manager.cc",
    "tor_manager.h",
    "tor_service.cc",
    "tor_service.h",
  ]

  deps = [
    "//base",
  ]

  # tor_service.cc / tor_manager.cc talk to the Tor control port over
  # raw sockets. On Windows that means winsock2, which needs ws2_32.
  if (is_win) {
    libs = [ "ws2_32.lib" ]
  }
}
