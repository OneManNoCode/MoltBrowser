#
# Tor integration for MoltBrowser (MoltNet).
#   tor_manager.*            — runs/supervises the bundled tor (auto ports,
#                              TAKEOWNERSHIP, bridges, exit country)
#   tor_control_connection.* — SAFECOOKIE-authenticated control client
#   tor_service.*            — read-only circuit/status queries
#   molt_net_routing.*       — the isolated MoltNet (Tor) profile
#   molt_net_pref_isolation* — MoltNet's pref service: nothing written
#                              through to the regular profile, web-visible
#                              settings pinned to MoltBrowser's defaults
#   molt_net_language_policy — MoltNet's language list, fixed above its own
#                              settings (no ForcedLanguages, --accept-lang or
#                              user list), and ReduceAcceptLanguageEnabled
#                              ignored
#   molt_net_locale_prefs*   — MoltNet's fixed fonts, minimum font size and
#                              encoding where Chromium's default follows the
#                              UI language
#   molt_net_isolation*      — keeps the regular profile's extensions and
#                              services out of MoltNet windows
#   molt_net_webrtc*         — no WebRTC networking in MoltNet windows (no
#                              P2P sockets, host-name lookups or mDNS for
#                              their frames; RTCPeerConnection throws)
#   molt_net_incognito_parity* — Chromium's Incognito-only protections for
#                              MoltNet's non-primary off-the-record profile
#   molt_net_requests_policy — what a MoltNet window may not cause outside
#                              Tor (cloud AI, Safe Browsing, image
#                              descriptions, location, Cast, phone passkeys)
#   molt_net_request_binders — no image-description or location service for
#                              MoltNet frames
#   molt_net_network_context_policy — MoltNet's per-context network
#                              settings: one-off keys for certificate
#                              fetches, no NTLM or Negotiate, a random
#                              SOCKS password for Tor, per-site network
#                              state (certificate verification, HTTP cache,
#                              HSTS, HTTP auth, Private State Tokens)
#   molt_net_partitioning_policy — the process-wide switches MoltNet needs
#                              on (connections, HTTP cache, third-party
#                              storage partitioned by site)
#   molt_net_live_policy / molt_net_live_guard — the open check run again
#                              whenever a setting it reads changes while
#                              MoltNet is open (MoltNet then ends), and only
#                              MoltNet's own proxy configuration for its
#                              network context

import("//extensions/buildflags/buildflags.gni")
import("//printing/buildflags/buildflags.gni")
import("//services/network/public/cpp/features.gni")

