    # A Background Fetch's in-memory limits and the site its registering
    # page isolates it to.
    "//components/download/internal/background_service:molt_site_isolation",

    # Background Fetch scheduling, download isolation and processes per
    # BrowsingInstance (content's std-only policies).
    "//content/browser:molt_policies",

    # A Background Fetch's buffer counts against its site's blob share
    # (BlobStorageContext).
    "//storage/browser",

    # MoltNet's localStorage caches per site, with the storage service's
    # LocalStorageImpl.
    "//components/services/storage",
    "//third_party/blink/public/common",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",

    # The site MoltNet's certificate verifications carry, across the
    # verifier service's interface.
    "//mojo/public/cpp/test_support:test_utils",
    "//net",
    "//net:test_support",
    "//net/traffic_annotation:test_support",

    # The parameters MoltNet's network-context settings are written into.
    "//services/cert_verifier/cert_net_url_loader",
    "//services/cert_verifier/public/mojom",
    "//services/device/public/mojom",
    "//services/image_annotation/public/mojom",

    # The ResourceRequest a Background Fetch request is built in.
    "//services/network/public/cpp",
    "//services/network/public/cpp:buildflags",
    # An ended identity's network context stops everything with its refusal
    # (ProxyConfigServiceMojo) and starts nothing after it (NetworkContext,
    # with the test cert verifier and URL loader client).
    "//services/network:network_service",
    "//services/network:test_support",
    "//services/network/public/mojom",
    "//testing/gtest",
    "//third_party/blink/public/mojom:mojom_platform",
    "//url",

    # MoltNet's locale-independent defaults: the fonts must be on Blink's
    # allow-lists, and the en-US column must match the paks grit builds.
    "//chrome/app/resources:platform_locale_settings",
    "//components/strings:components_locale_settings",
    "//third_party/blink/renderer/core/molt_fingerprinting:farbling",
    "//ui/base",
  ]
  data = [
    "$root_gen_dir/chrome/platform_locale_settings_en-US.pak",
    "$root_gen_dir/components/strings/components_locale_settings_en-US.pak",
  ]
  if (is_p2p_enabled) {
    deps += [ "//services/network/public/cpp:cpp_p2p" ]
  }
}
