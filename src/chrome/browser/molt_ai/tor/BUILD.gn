# bridge-line validation, which pluggable transports may run, and .onion /
# Onion-Location checks. Split out so molt_ai_unittests can test it without
# pulling in Profile / content.
source_set("protocol") {
  sources = [
    "onion_util.cc",
    "onion_util.h",
    "pluggable_transports.cc",
    "pluggable_transports.h",
    "tor_control_protocol.cc",
    "tor_control_protocol.h",
    "torrc_builder.cc",
    "torrc_builder.h",
  ]
  deps = [
    "//base",
    # SAFECOOKIE control-port auth (HMAC-SHA256).
    "//crypto",

    # The per-site socket pool policy torrc_builder.h follows (std-only).
    "//net:molt_policies",
  ]
}

