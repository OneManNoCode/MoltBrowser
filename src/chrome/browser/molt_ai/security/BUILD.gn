#
# Shared safety rules for page-driving features: the WebAgent ReAct loop,
# chat [[ACTION ...]] actions and automation replay. Pure logic (no content/
# layer), so it links into the standalone molt_ai_unittests binary.

source_set("agent_safety") {
  sources = [
    "agent_safety.cc",
    "agent_safety.h",
  ]

  deps = [
    "//base",
    "//url",
  ]
}

# What a page may do with the user activation an agent's or voice mode's
# accessibility action gave it (docs/design/TOUCHLESS_BROWSING.md §7.5): the
# tab's state and the decisions. Std-only, so molt_ai_unittests and a
# standalone harness build the same code.
source_set("activation_policy") {
  sources = [
    "activation_policy.cc",
    "activation_policy.h",
  ]
}

# Who may open chrome:// / molt:// pages (S19). Pure logic, unit-tested.
source_set("webui_navigation_policy") {
  sources = [
    "webui_navigation_policy.cc",
    "webui_navigation_policy.h",
  ]

  deps = [ "//url" ]
}

# The NavigationThrottle that applies it; added by
# ChromeContentBrowserClient::CreateThrottlesForNavigation.
source_set("webui_navigation_throttle") {
  sources = [
    "webui_navigation_throttle.cc",
    "webui_navigation_throttle.h",
  ]

  public_deps = [ "//content/public/browser" ]

  deps = [
    ":webui_navigation_policy",
    "//base",
    "//url",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "activation_policy_unittest.cc",
    "agent_safety_unittest.cc",
    "webui_navigation_policy_unittest.cc",
  ]
  deps = [
    ":activation_policy",
    ":agent_safety",
    ":webui_navigation_policy",
    "//base",
    "//testing/gtest",
    "//url",
  ]
}
