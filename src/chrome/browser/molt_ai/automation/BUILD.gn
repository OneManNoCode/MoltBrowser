#
# MoltBrowser web automation engine.
# Lets users record web workflows, save them as scripts, schedule them
# via cron, and run them with local AI augmentation.

import("//build/config/ui.gni")

source_set("automation") {
  sources = [
    "agent_inbox_registry.cc",
    "agent_inbox_registry.h",
    "automation_background_browser.cc",
    "automation_background_browser.h",
    "automation_notification.cc",
    "automation_notification.h",
    "automation_recorder.cc",
    "automation_recorder.h",
    "automation_recorder_tab_helper.cc",
    "automation_recorder_tab_helper.h",
    "automation_runner.cc",
    "automation_runner.h",
    "automation_scheduler.cc",
    "automation_scheduler.h",
    "automation_scheduler_factory.cc",
    "automation_scheduler_factory.h",
    "automation_scheduler_service.cc",
    "automation_scheduler_service.h",
    "automation_storage.cc",
    "automation_storage.h",
  ]

  # automation_notification.cc is a single cross-platform implementation
  # (Chromium's NotificationDisplayService) used on macOS, Windows, and
  # Linux. The former is_mac (.mm UNUserNotificationCenter) / stub split is
  # gone; automation_notification_mac.mm and automation_notification_stub.cc
  # are now unused.

  deps = [
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/molt_ai/common",
    "//chrome/browser/molt_ai:molt_ai_runtime",
    # Secret (password) steps are filled from the vault at replay; read-only.
    "//chrome/browser/molt_ai/vault",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/viz/common",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//ui/message_center/public/cpp",
    "//url",
  ]

  # Script model + security policy are part of this target's API (its
  # headers include them), so dependents see them too.
  public_deps = [
    ":ai_steps",
    ":automation_policy",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]
}

# The answer formats of the runner's model decisions (AI_DECIDE, AI_EXTRACT,
# selector recovery): the JSON Schemas the on-device model decodes under,
# the conversion of a step's untrusted "schema", and the strict readers of
# the replies (docs/design/AGENT_ACTIONS.md). Pure logic (base only).
source_set("ai_steps") {
  sources = [
    "automation_ai_steps.cc",
    "automation_ai_steps.h",
  ]

  public_deps = [ "//base" ]
}

# The .molt script model and the trust / whitelist policy. Pure logic (base +
# url), split out so molt_ai_unittests can cover it without pulling in the
# browser-side dependencies of :automation.
source_set("automation_policy") {
  sources = [
    "automation_script.cc",
    "automation_script.h",
    "automation_security.cc",
    "automation_security.h",
  ]

  deps = [ "//url" ]

  public_deps = [
    "//base",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "automation_ai_steps_unittest.cc",
    "automation_security_unittest.cc",
  ]
  deps = [
    ":ai_steps",
    ":automation_policy",
    "//base",

    # Every schema the runner builds must be accepted by the inference
    # service's converter; the tests run the real one (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//testing/gtest",
    "//url",
  ]
}
