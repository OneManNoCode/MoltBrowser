# Voice mode in a browser window: runs the loop's steps on the active tab
# (VoicePageController), the browser's commands, the media session and the
# tab's mute, and speaks through its own voice (the molt-voice helper,
# played through the audio service) or TtsController.
source_set("voice_controller") {
  sources = [
    "voice_controller.cc",
    "voice_controller.h",
    "voice_speech.cc",
    "voice_speech.h",
    "voice_speech_bundled.cc",
    "voice_speech_bundled.h",
  ]

  public_deps = [
    ":voice_loop",
    ":voice_planner",
    ":voice_speaking",
    "//base",

    # Voice mode asks the activation guard's questions on its tab
    # (page_request_asker.h).
    "//chrome/browser/molt_ai/security:activation_policy",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    ":features",
    ":voice_page",

    # The voice helper: the bundled copy only, under the resident sandbox.
    "//chrome/browser/molt_ai/common:helper_binary",
    "//chrome/browser/molt_ai/common:helper_resident",

    # Its audio, played through the audio service.
    "//media",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//services/audio/public/cpp",
    "//chrome/app:command_ids",

    # The tab's activation guard, which voice mode answers.
    "//chrome/browser/molt_ai/security:activation_guard",

    # The planner fallback: the web agent's on-device planner
    # (agents/voice_agent_planner.h).
    "//chrome/browser/molt_ai:molt_ai_agents",

    # Every URL is checked before it loads.
    "//chrome/browser/molt_ai/security:agent_safety",

    # The numbers, the ring and the caption bar (voice_overlay.h; no views
    # code).
    "//chrome/browser/ui/views/molt_ai/voice:layout",
    "//chrome/browser/ui/views/molt_ai/voice:overlay",

    # Also molt_net_profile_id.h (header-only IsMoltNetProfile()): voice
