# --- Touchless browsing: the voice loop (docs/design/TOUCHLESS_BROWSING.md
# §2, §5, §6.2, §6.5, §6.6) ---------------------------------------------------

# What the user said, the page map and the conversation so far become the
# steps to run and the words to say: known sites and spoken addresses, the
# page map's lists as the matcher's candidates, what the browser says, and
# the loop's decisions (confirmations, dictation, media, reading). Std-only:
# molt_ai_unittests and a standalone harness build the same code.
source_set("voice_loop") {
  sources = [
    "voice_candidates.cc",
    "voice_candidates.h",
    "voice_controller_logic.cc",
    "voice_controller_logic.h",

    # Learning (§6.8): site hints, routines' steps, personal words.
    "voice_hints.cc",
    "voice_hints.h",
    "voice_routines_logic.cc",
    "voice_routines_logic.h",
    "voice_sites.cc",
    "voice_sites.h",
    "voice_speech_text.cc",
    "voice_speech_text.h",
    "voice_vocabulary.cc",
    "voice_vocabulary.h",
  ]

  public_deps = [
    ":page_map",
    ":spoken_choice",
    ":voice_command",

    # activation::Intent in VoiceStep (std-only).
    "//chrome/browser/molt_ai/security:activation_policy",
  ]

  # MOLT_RAW_PTR_EXCLUSION (header-only).
  deps = [ "//chrome/services/molt_ai/inference/engine:raw_ptr_exclusion" ]
}

# What voice mode hands open-ended requests to (the planner fallback,
# docs/design/TOUCHLESS_BROWSING.md §6.2): the interface the web agent's
# planner implements (//chrome/browser/molt_ai:molt_ai_agents,
# agents/voice_agent_planner.h). Header-only.
source_set("voice_planner") {
  sources = [ "voice_planner.h" ]
}

# chrome://flags/#molt-voice-mode (about_flags.cc includes
# voice_controller_features.h).
source_set("features") {
  sources = [
    "voice_controller_features.cc",
    "voice_controller_features.h",
  ]

  public_deps = [ "//base" ]
}

# The browser's side of the voice helper protocol: molt-voice's frames read
