# Voice mode: local speech-to-text via bundled whisper.cpp.

import("//testing/libfuzzer/fuzzer_test.gni")

# The chat page's recording, checked and rewritten as a canonical WAV
# before whisper-cli reads it. Std-only: the unit tests, a standalone
# harness and molt_recorded_wav_fuzzer build the same code.
source_set("recorded_wav") {
  sources = [
    "recorded_wav.cc",
    "recorded_wav.h",
  ]
}

source_set("voice") {
  sources = [
    "voice_service.cc",
    "voice_service.h",
  ]

  deps = [
    ":recorded_wav",
    "//base",

    # Bundled or (Linux) root-owned system binary only; no Homebrew/PATH.
    "//chrome/browser/molt_ai/common:helper_binary",
    "//chrome/browser/molt_ai/common:helper_output",

    # whisper-cli runs confined, with a deadline.
    "//chrome/browser/molt_ai/common:helper_sandbox",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [ "recorded_wav_unittest.cc" ]
  deps = [
    ":recorded_wav",
    ":voice_intent_unit_tests",
    "//testing/gtest",
  ]
}

# --- Voice intent -------------------------------------------------------------
# What a recognized utterance asks for, without a language model
# (docs/design/TOUCHLESS_BROWSING.md sections 6.2 and 6.4,
# docs/VOICE_COMMANDS.md). Std-only (no //base): the unit tests, a standalone
# harness, the fuzzers and tools/voice/voice_commands_doc.py build the same
# code.

# The spoken-choice matcher: which item on screen "the fourth one", "number
# 12" or "the live one by Queen" means. The page map fills its
# ChoiceCandidates. With it, the text, number and sound-alike readers the
# grammar shares, and the per-language word tables.
source_set("spoken_choice") {
  sources = [
    "phonetic_key.cc",
    "phonetic_key.h",
    "spoken_choice.cc",
    "spoken_choice.h",
    "spoken_numbers.cc",
    "spoken_numbers.h",
    "spoken_phrases.cc",
    "spoken_phrases.h",
    "spoken_phrases_en.cc",
    "spoken_text.cc",
    "spoken_text.h",
  ]
}

# The direct-command grammar and its per-language patterns.
source_set("voice_command") {
  sources = [
    "voice_command.cc",
    "voice_command.h",
    "voice_command_phrases.h",
    "voice_command_phrases_en.cc",
  ]
  public_deps = [ ":spoken_choice" ]
}

source_set("voice_intent_unit_tests") {
  testonly = true
  sources = [
    "phonetic_key_unittest.cc",
    "spoken_choice_unittest.cc",
    "spoken_numbers_unittest.cc",
    "spoken_text_unittest.cc",
    "voice_command_unittest.cc",
  ]
  deps = [
    ":spoken_choice",
    ":voice_command",
    "//testing/gtest",
  ]
}

# Utterances as a recognizer (or anyone who can make the browser hear
# something) writes them. See docs/FUZZING.md.
fuzzer_test("molt_voice_command_fuzzer") {
  sources = [ "molt_voice_command_fuzzer.cc" ]
  deps = [
    ":voice_command",
    "//base",
  ]
  dict = "dicts/voice_command.dict"
  seed_corpus = "corpus/molt_voice_command_fuzzer"
  libfuzzer_options = [ "max_len=2048" ]
}

# Items a page shows (page text) and what the user said about them.
fuzzer_test("molt_spoken_choice_fuzzer") {
  sources = [ "molt_spoken_choice_fuzzer.cc" ]
  deps = [
    ":spoken_choice",
    "//base",
  ]
  dict = "dicts/voice_command.dict"
  seed_corpus = "corpus/molt_spoken_choice_fuzzer"
  libfuzzer_options = [ "max_len=16384" ]
}

# --- Touchless browsing: the page map (docs/design/TOUCHLESS_BROWSING.md
# §6.3, §6.5) -------------------------------------------------------------

# The page map: any page as numbered items, lists to choose from, headings,
# landmarks and media, from a tree of PageNodes; speech-safe text and field
# types. Std-only (with hidden_chars), so molt_ai_unittests, a standalone
# harness and molt_page_map_fuzzer build the same code.
source_set("page_map") {
  sources = [
    "page_map.cc",
    "page_map.h",
    "page_map_text.cc",
    "page_map_text.h",
  ]

  deps = [
    "//chrome/browser/molt_ai/agents:hidden_chars",

    # MOLT_RAW_PTR_EXCLUSION (header-only).
    "//chrome/services/molt_ai/inference/engine:raw_ptr_exclusion",
  ]
}

# Hand-built page trees for the page map's tests (std-only).
source_set("page_map_test_support") {
  testonly = true
  sources = [
    "page_map_test_trees.cc",
    "page_map_test_trees.h",
  ]

  public_deps = [ ":page_map" ]
}

# Chromium's accessibility trees (one per frame, joined) as the page map's
# input.
source_set("ax_page_source") {
  sources = [
    "ax_page_source.cc",
    "ax_page_source.h",
  ]

  public_deps = [
    ":page_map",
    "//base",
  ]

  deps = [
    "//ui/accessibility",
    "//ui/gfx/geometry",
  ]
}

# Voice mode's hold on a tab: the scoped accessibility mode, the frames'
# trees, the page map on request, and accessibility actions.
source_set("voice_page") {
  sources = [
    "voice_page_controller.cc",
    "voice_page_controller.h",
  ]

  public_deps = [
    ":page_map",
    "//base",
    "//content/public/browser",
    "//ui/accessibility",
  ]

  deps = [
    ":ax_page_source",

    # Actions only in http(s) documents.
    "//chrome/browser/molt_ai/security:agent_safety",

    # Submit's Enter key, sent as the keyboard sends it.
    "//components/input",
    "//third_party/blink/public/common:headers",
    "//ui/events:dom_keycode_converter",
    "//ui/events:events_base",
    "//url",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("page_map_unit_tests") {
  testonly = true
  sources = [
    "ax_page_source_unittest.cc",
    "page_map_agent_safety_unittest.cc",
    "page_map_text_unittest.cc",
    "page_map_unittest.cc",
  ]

  deps = [
    ":ax_page_source",
    ":page_map",
    ":page_map_test_support",

    # The page map marks credential fields as agent_safety does.
    "//chrome/browser/molt_ai/security:agent_safety",
    "//testing/gtest",
    "//ui/accessibility",
    "//ui/gfx/geometry",
  ]
}

# Phase 0's exit criterion without speech: the controller alone drives
# fixture pages (chrome/test/data/molt_voice/) like YouTube's, Google's, a
# sign-in form and a cross-site frame. Picked up by browser_tests
# (//chrome/browser:core_browser_tests).
source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "voice_page_controller_browsertest.cc" ]

  deps = [
    ":page_map",
    ":voice_page",

    # The voice loop's own browser test (below).
    ":voice_loop_browser_tests",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//media:media_buildflags",
    "//net:test_support",
    "//testing/gtest",
  ]
}

# --- Touchless browsing: the voice loop (docs/design/TOUCHLESS_BROWSING.md
# §2, §5, §6.2, §6.5, §6.6) ---------------------------------------------------

# What the user said, the page map and the conversation so far become the
# steps to run and the words to say: known sites and spoken addresses, the
# page map's lists as the matcher's candidates, what the browser says, and
# the loop's decisions (confirmations, dictation, media, reading). Std-only:
# molt_ai_unittests and a standalone harness build the same code.
source_set("voice_loop") {
  sources = [
    "voice_candidates.cc",
    "voice_candidates.h",
    "voice_controller_logic.cc",
    "voice_controller_logic.h",
    "voice_sites.cc",
    "voice_sites.h",
    "voice_speech_text.cc",
    "voice_speech_text.h",
  ]

  public_deps = [
    ":page_map",
    ":spoken_choice",
    ":voice_command",
  ]
}

# chrome://flags/#molt-voice-mode (about_flags.cc includes
# voice_controller_features.h).
source_set("features") {
  sources = [
    "voice_controller_features.cc",
    "voice_controller_features.h",
  ]

  public_deps = [ "//base" ]
}

# Voice mode in a browser window: runs the loop's steps on the active tab
# (VoicePageController), the browser's commands, the media session and the
# tab's mute, and speaks through TtsController.
source_set("voice_controller") {
  sources = [
    "voice_controller.cc",
    "voice_controller.h",
    "voice_speech.cc",
    "voice_speech.h",
  ]

  public_deps = [
    ":voice_loop",
    "//base",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    ":features",
    ":voice_page",
    "//chrome/app:command_ids",

    # Every URL is checked before it loads.
    "//chrome/browser/molt_ai/security:agent_safety",

    # Also molt_net_profile_id.h (header-only IsMoltNetProfile()): voice
    # mode stays off in MoltNet windows.
    "//chrome/browser/profiles:profile",

    # The default search engine, for names the browser doesn't know.
    "//chrome/browser/search_engines",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:utils",
    "//components/search_engines",
    "//content/public/browser",
    "//services/media_session/public/mojom",
    "//ui/accessibility",
    "//ui/base",
    "//url",
  ]
}

# The loop's decisions over hostile page maps (page text, through a
# renderer that may be compromised) and what anyone the browser can hear
# says. See docs/FUZZING.md.
fuzzer_test("molt_voice_controller_fuzzer") {
  sources = [ "molt_voice_controller_fuzzer.cc" ]
  deps = [
    ":voice_loop",
    "//base",
    "//chrome/browser/molt_ai/agents:hidden_chars",
  ]
  dict = "dicts/voice_command.dict"
  seed_corpus = "corpus/molt_voice_controller_fuzzer"
  libfuzzer_options = [ "max_len=16384" ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("voice_loop_unit_tests") {
  testonly = true
  sources = [
    "voice_candidates_unittest.cc",
    "voice_controller_logic_unittest.cc",
    "voice_sites_agent_safety_unittest.cc",
    "voice_sites_unittest.cc",
    "voice_speech_text_unittest.cc",
  ]

  deps = [
    ":page_map_test_support",
    ":voice_loop",

    # Every URL the loop builds passes agent_safety's navigation check.
    "//chrome/browser/molt_ai/security:agent_safety",
    "//testing/gtest",
    "//url",
  ]
}

# Phase 0's exit criterion through the whole loop: typed utterances drive
