# Voice mode: local speech-to-text via bundled whisper.cpp.

# The chat page's recording, checked and rewritten as a canonical WAV
# before whisper-cli reads it. Std-only: the unit tests, a standalone
# harness and molt_recorded_wav_fuzzer build the same code.
source_set("recorded_wav") {
  sources = [
    "recorded_wav.cc",
    "recorded_wav.h",
  ]
}

source_set("voice") {
  sources = [
    "voice_service.cc",
    "voice_service.h",
  ]

  deps = [
    ":recorded_wav",
    "//base",

    # Bundled or (Linux) root-owned system binary only; no Homebrew/PATH.
    "//chrome/browser/molt_ai/common:helper_binary",
    "//chrome/browser/molt_ai/common:helper_output",

    # whisper-cli runs confined, with a deadline.
    "//chrome/browser/molt_ai/common:helper_sandbox",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [ "recorded_wav_unittest.cc" ]
  deps = [
    ":recorded_wav",
    "//testing/gtest",
  ]
}

# --- Touchless browsing: the page map (docs/design/TOUCHLESS_BROWSING.md
# §6.3, §6.5) -------------------------------------------------------------

# The page map: any page as numbered items, lists to choose from, headings,
# landmarks and media, from a tree of PageNodes; speech-safe text and field
# types. Std-only (with hidden_chars), so molt_ai_unittests, a standalone
# harness and molt_page_map_fuzzer build the same code.
source_set("page_map") {
  sources = [
    "page_map.cc",
    "page_map.h",
    "page_map_text.cc",
    "page_map_text.h",
  ]

  deps = [ "//chrome/browser/molt_ai/agents:hidden_chars" ]
}

# Hand-built page trees for the page map's tests (std-only).
source_set("page_map_test_support") {
  testonly = true
  sources = [
    "page_map_test_trees.cc",
    "page_map_test_trees.h",
  ]

  public_deps = [ ":page_map" ]
}

# Chromium's accessibility trees (one per frame, joined) as the page map's
# input.
source_set("ax_page_source") {
  sources = [
    "ax_page_source.cc",
    "ax_page_source.h",
  ]

  public_deps = [
    ":page_map",
    "//base",
  ]

  deps = [
    "//ui/accessibility",
    "//ui/gfx/geometry",
  ]
}

# Voice mode's hold on a tab: the scoped accessibility mode, the frames'
# trees, the page map on request, and accessibility actions.
source_set("voice_page") {
  sources = [
    "voice_page_controller.cc",
    "voice_page_controller.h",
  ]

  public_deps = [
    ":page_map",
    "//base",
    "//content/public/browser",
    "//ui/accessibility",
  ]

  deps = [
    ":ax_page_source",

    # Actions only in http(s) documents.
    "//chrome/browser/molt_ai/security:agent_safety",

    # Submit's Enter key, sent as the keyboard sends it.
    "//components/input",
    "//services/media_session/public/mojom",
    "//third_party/blink/public/common:headers",
    "//ui/events:dom_keycode_converter",
    "//ui/events:events_base",
    "//url",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("page_map_unit_tests") {
  testonly = true
  sources = [
    "ax_page_source_unittest.cc",
    "page_map_agent_safety_unittest.cc",
    "page_map_text_unittest.cc",
    "page_map_unittest.cc",
  ]

  deps = [
    ":ax_page_source",
    ":page_map",
    ":page_map_test_support",

    # The page map marks credential fields as agent_safety does.
    "//chrome/browser/molt_ai/security:agent_safety",
    "//testing/gtest",
    "//ui/accessibility",
    "//ui/gfx/geometry",
  ]
}

# Phase 0's exit criterion without speech: the controller alone drives
# fixture pages (chrome/test/data/molt_voice/) like YouTube's, Google's, a
# sign-in form and a cross-site frame. Picked up by browser_tests
# (//chrome/browser:core_browser_tests).
source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "voice_page_controller_browsertest.cc" ]

  deps = [
    ":page_map",
    ":voice_page",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//media:media_buildflags",
    "//net:test_support",
    "//testing/gtest",
  ]
}
