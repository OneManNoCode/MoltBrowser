#
# MoltBrowser local profile — encrypted JSON blob backing the Form
# Filler Agent. Stored at ~/.moltbrowser/profile.enc via OSCrypt.

source_set("profile") {
  sources = [
    "molt_profile_store.cc",
    "molt_profile_store.h",
  ]

  deps = [
    "//base",
    "//components/os_crypt/sync",
  ]
}
