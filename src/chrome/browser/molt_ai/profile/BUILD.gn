#
# MoltBrowser local profile — encrypted JSON blob backing the Form
# Filler Agent. Stored at ~/.moltbrowser/profile.enc, encrypted through
# molt_ai/keys:os_crypt (the os_crypt_async Encryptor).

source_set("profile") {
  sources = [
    "molt_profile_store.cc",
    "molt_profile_store.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/keys",
    "//chrome/browser/molt_ai/keys:os_crypt",
  ]
}

# Never overwriting an unreadable profile.enc (keyring locked, another key,
# corrupt file). Linked into //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [ "molt_profile_store_unittest.cc" ]
  deps = [
    ":profile",
    "//base",
    "//chrome/browser/molt_ai/keys",
    "//chrome/browser/molt_ai/keys:os_crypt",
    "//chrome/browser/molt_ai/keys:test_support",
    "//testing/gtest",
  ]
}
