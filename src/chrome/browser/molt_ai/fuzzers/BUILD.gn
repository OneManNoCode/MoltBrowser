#
# libFuzzer targets for the browser's own parsers and validators of
# untrusted input: what the sandboxed inference service sends back, what
# web pages pass to the Web AI APIs, page text, model-proposed agent
# actions, imported workflows, Tor's control port and the release manifest.
# See docs/FUZZING.md.
#
# Built with a fuzzing engine (use_libfuzzer / use_centipede, as ClusterFuzz
# builds Chromium); a no-op group otherwise. The same sources build
# standalone with tools/fuzz/molt_fuzz.py.

import("//testing/libfuzzer/fuzzer_test.gni")

_model_output_dict =
    "//chrome/services/molt_ai/inference/fuzzers/dicts/model_output.dict"
_json_dict = "//chrome/services/molt_ai/inference/fuzzers/dicts/json.dict"

# --- What the inference service sends back ---------------------------------

fuzzer_test("molt_stream_validator_fuzzer") {
  sources = [ "molt_stream_validator_fuzzer.cc" ]
  deps = [
    "//base",
    "//chrome/browser/molt_ai/runtime:stream_validator",
  ]
  dict = _model_output_dict
  seed_corpus = "corpus/molt_stream_validator_fuzzer"
  libfuzzer_options = [ "max_len=16384" ]
}

fuzzer_test("molt_embedding_validator_fuzzer") {
  sources = [ "molt_embedding_validator_fuzzer.cc" ]
  deps = [
    "//base",
    "//chrome/browser/molt_ai/runtime:embedding_validator",
  ]
  seed_corpus = "corpus/molt_embedding_validator_fuzzer"
  libfuzzer_options = [ "max_len=8192" ]
}

