# Every MoltBrowser fuzzer, reached from
# //chrome/browser/molt_ai:molt_ai_tests so the targets are part of `all`.
group("molt_fuzzers") {
  testonly = true
  deps = [
    ":fuzzers",
    "//chrome/services/molt_ai/document_parser/fuzzers",
    "//chrome/services/molt_ai/inference/fuzzers",
    "//third_party/blink/renderer/core/molt_fingerprinting:molt_farbling_fuzzer",
  ]
}
