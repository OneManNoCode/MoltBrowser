#
# Browser half of MoltBrowser's fingerprinting protection: the per-profile
# session seed, the renderer mode switch (hooked from
# ChromeContentBrowserClient::AppendExtraCommandLineSwitches) and the
# channel-associated configuration sent at RenderProcessWillLaunch (session
# seed), the per-document and per-worker Shields decisions
# (molt_shields_delivery.h), MoltNet's letterboxing of the page in the
# window (:letterbox, :letterbox_view), MoltNet's input devices, CPU
# tier and client hints (:device, :client_hints), and no screen, window or
# tab capture in MoltNet (:display_capture). The engine itself lives in
# Blink: //third_party/blink/renderer/core/molt_fingerprinting.

source_set("fingerprinting") {
  sources = [
    # chrome://flags entry for the kill switch (about_flags.cc).
    "molt_fingerprinting_about_flags.h",
    "molt_fingerprinting_browser.cc",
    "molt_fingerprinting_browser.h",
    "molt_shields_delivery.cc",
    "molt_shields_delivery.h",
  ]
  public_deps = [ "//chrome/common/molt_ai/fingerprinting" ]
  deps = [
    ":net_fonts",
    ":shields_decision",
    "//base",
    "//chrome/browser/content_settings:content_settings_factory",

    # Also molt_net_profile_id.h (is this the MoltNet profile?).
    "//chrome/browser/profiles:profile",
    "//chrome/common/molt_ai/fingerprinting:mojom",
    "//content/public/browser",
    "//crypto",
    "//ipc",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# MoltNet's bundled fonts: finding, checking and opening the files, and the
# table generated from tools/fonts/moltnet_fonts.json (generate_tables.py).
source_set("net_fonts") {
  sources = [
    "molt_net_fonts.cc",
    "molt_net_fonts.h",
    "molt_net_fonts_table.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//content/public/browser" ]
}

# Whether a document or worker has Shields down, from a profile's content
# settings (no profile, so it is unit-tested in molt_ai_unittests).
source_set("shields_decision") {
  sources = [
    "molt_shields_decision.cc",
    "molt_shields_decision.h",
  ]
  public_deps = [ "//chrome/common/molt_ai/fingerprinting" ]
  deps = [
    # Which Shields-down exceptions count (molt_shield_site_exceptions.h).
    "//chrome/browser/molt_ai/shield:site_exceptions",
    "//components/content_settings/core/browser",
    "//net",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# MoltNet letterboxing: the geometry, in CSS pixels at any zoom and scale
# factor (std-only, constexpr).
source_set("letterbox") {
  sources = [ "molt_letterbox.h" ]
}

# ... and where it meets the window: the hooks in ContentsWebView
# (chrome/browser/ui/views/frame/contents_web_view.cc) call these, and
# chrome/browser/universal_web_contents_observers.cc attaches
# BackgroundTabLetterbox. Views only, so desktop only (see the molt_ai
# group).
source_set("letterbox_view") {
  sources = [
    "molt_letterbox_view.cc",
    "molt_letterbox_view.h",
  ]
  public_deps = [
    "//content/public/browser",
    "//skia",
    "//ui/gfx/geometry",
  ]
  deps = [
    ":fingerprinting",
    ":letterbox",
    "//chrome/browser/ui/color:color_headers",
    "//components/tabs:public",
    "//net",
    "//third_party/blink/public/common",
    "//ui/color",
    "//ui/compositor",
    "//ui/views",
    "//ui/views/controls/webview",
    "//url",
  ]
}

# MoltNet's uniform device, browser side: the values (std-only, constexpr;
# the client-hint rule is Blink's, compared by the unit test) ...
source_set("device_values") {
  sources = [ "molt_net_device_values.h" ]
}

# ... the touch / pointer / hover WebPreferences and the CPU performance tier
# (molt_net_device.h), called from chrome_content_browser_client.cc ...
source_set("device") {
  sources = [
    "molt_net_device.cc",
    "molt_net_device.h",
  ]
  deps = [
    ":device_values",
    ":fingerprinting",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//third_party/blink/public/mojom:mojom_platform",
    "//ui/base",
  ]
}

# MoltNet's fixed storage limits: the values (std-only, constexpr) ...
source_set("storage_values") {
  sources = [ "molt_net_storage_values.h" ]
}

# ... as the quota settings and blob limits content asks the embedder for
# (molt_net_storage.h), called from chrome_content_browser_client.cc with
# the profile's renderer mode (so unit-tested in molt_ai_unittests).
source_set("storage") {
  sources = [
    "molt_net_storage.cc",
    "molt_net_storage.h",
  ]
  public_deps = [
    # Also the reserve ChromeContentBrowserClient gives the memory valve.
    ":storage_values",
    "//chrome/common/molt_ai/fingerprinting",
    "//storage/browser",
  ]
  deps = [ "//base" ]
}

# ... and MoltNet's ClientHintsControllerDelegate (molt_net_client_hints.h),
# which ClientHintsFactory (//chrome/browser/client_hints) builds.
source_set("client_hints") {
  sources = [
    "molt_net_client_hints.cc",
    "molt_net_client_hints.h",
  ]
  public_deps = [
    "//base",
    "//components/client_hints/browser",
    "//services/network/public/mojom",
  ]
  deps = [
    ":device_values",
    ":fingerprinting",
    "//components/embedder_support:user_agent",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# No screen, window or tab capture in MoltNet: which requests and their
# answer (std + mojom enums, constexpr) ...
source_set("display_capture_policy") {
  sources = [ "molt_net_display_capture_policy.h" ]
  public_deps = [ "//third_party/blink/public/mojom:mojom_platform" ]
}

# ... and the browser's check (header-only), which
# MediaCaptureDevicesDispatcher::ProcessMediaAccessRequest
# (//chrome/browser/media/webrtc:webrtc) includes, as other upstream hooks
# include molt_net_profile_id.h.
source_set("display_capture") {
  sources = [ "molt_net_display_capture.h" ]

  # profile.h also gives molt_net_profile_id.h (is this the MoltNet
  # profile?).
  public_deps = [
    ":display_capture_policy",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
  ]
}

# Whether a profile's microphone streams are processed CPU-independently,
# which ChromeContentBrowserClient answers content with
# (molt_net_audio_capture.h; constexpr).
source_set("audio_capture") {
  sources = [ "molt_net_audio_capture.h" ]
  public_deps = [ "//chrome/common/molt_ai/fingerprinting" ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "molt_letterbox_unittest.cc",
    "molt_net_audio_capture_unittest.cc",
    "molt_net_device_values_unittest.cc",
    "molt_net_display_capture_policy_unittest.cc",
    "molt_net_blob_budget_policy_unittest.cc",
    "molt_net_fonts_unittest.cc",
    "molt_net_storage_budget_policy_unittest.cc",
    "molt_net_storage_site_usage_policy_unittest.cc",
    "molt_net_storage_site_usage_unittest.cc",
    "molt_net_storage_unittest.cc",
    "molt_net_storage_values_unittest.cc",
    "molt_shields_decision_unittest.cc",
  ]
  deps = [
    ":audio_capture",
    ":device_values",
    ":display_capture_policy",
    ":letterbox",
    ":net_fonts",
    ":shields_decision",
    ":storage",
    ":storage_values",
    "//base",
    "//base/test:test_support",

    # A site's MoltShield exception (molt_shields_decision_unittest.cc).
    "//chrome/browser/molt_ai/shield:site_exceptions",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/sync_preferences:test_support",

    # BrowserTaskEnvironment (molt_net_fonts_unittest.cc).
    "//content/test:test_support",
    "//net",
    "//testing/gtest",
    "//third_party/blink/public/common",

    # The letterbox steps and MoltNet's client-hint rule must match Blink's
    # (std + //base + //crypto only).
    "//third_party/blink/renderer/core/molt_fingerprinting:farbling",
    "//url",

    # MoltNet's storage budget with the real quota manager and a mock quota
    # client (molt_net_storage_site_usage_unittest.cc).
    "//components/services/storage/public/cpp",
    "//components/services/storage/public/cpp/buckets",
    "//mojo/public/cpp/bindings",
    "//storage/browser",
    "//storage/browser:test_support",
    "//third_party/blink/public/mojom:mojom_platform",

    # The browser's decision in a stream's processing config
    # (molt_net_audio_capture_unittest.cc; header-only).
    "//content/browser:molt_audio_capture_policy",
    "//media",
    "//media/mojo/mojom",
  ]
}
