#
# Browser half of MoltBrowser's fingerprinting protection: the per-profile
# session seed and the renderer switches (hooked from
# ChromeContentBrowserClient::AppendExtraCommandLineSwitches). The engine
# itself lives in Blink: //third_party/blink/renderer/core/molt_fingerprinting.

source_set("fingerprinting") {
  sources = [
    # chrome://flags entry for the kill switch (about_flags.cc).
    "molt_fingerprinting_about_flags.h",
    "molt_fingerprinting_browser.cc",
    "molt_fingerprinting_browser.h",
  ]
  public_deps = [ "//chrome/common/molt_ai/fingerprinting" ]
  deps = [
    "//base",

    # molt_net_profile_id.h (is this the MoltNet profile?).
    "//chrome/browser/molt_ai/tor",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//crypto",
  ]
}
