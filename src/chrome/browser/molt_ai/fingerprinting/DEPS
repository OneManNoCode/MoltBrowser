include_rules = [
  # molt_letterbox_view.cc: the page's view in the window and its colours
  # (ContentsWebView calls in from chrome/browser/ui/views/frame).
  "+chrome/browser/ui/color/chrome_color_id.h",
  "+ui/views/controls/webview/webview.h",
  # molt_net_client_hints.cc: MoltNet's ClientHintsControllerDelegate.
  "+components/client_hints/browser/client_hints.h",
  "+components/embedder_support/user_agent_utils.h",
]

specific_include_rules = {
  # The letterbox steps must match Blink's; farbling.h is std + //base only.
  "molt_letterbox_unittest\.cc": [
    "+third_party/blink/renderer/core/molt_fingerprinting/farbling.h",
  ],
  # MoltNet's client-hint rule and device values must match Blink's
  # (std-only).
  "molt_net_device_values_unittest\.cc": [
    "+third_party/blink/renderer/core/molt_fingerprinting/moltnet_device_values.h",
  ],
  # The browser's decision replaces the renderer's in a stream's processing
  # config (header-only).
  "molt_net_audio_capture_unittest\.cc": [
    "+content/browser/renderer_host/media/molt_audio_capture_processing.h",
    "+media/base/audio_processing.h",
    "+media/mojo/mojom/audio_processing.mojom.h",
  ],
  # The browser sends the bundled fonts in the order of Blink's table.
  "molt_net_fonts_unittest\.cc": [
    "+third_party/blink/renderer/core/molt_fingerprinting/moltnet_font_set.h",
  ],
}
