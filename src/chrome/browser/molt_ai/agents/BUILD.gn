#
# The web agent itself (web_agent.*) and its screenshot capture
# (agent_screenshot.*) are //chrome/browser/molt_ai:molt_ai_agents.

# The agent's action format: the element snapshot, the JSON Schema the
# model decodes under, and the strict parser of its replies
# (docs/design/AGENT_ACTIONS.md). Pure logic (no content/), so
# molt_ai_unittests links it.
source_set("agent_actions") {
  sources = [
    "agent_actions.cc",
    "agent_actions.h",
  ]

  public_deps = [ "//chrome/browser/molt_ai/security:agent_safety" ]

  deps = [ "//base" ]
}

# The AI chat's page actions: when to ask, the decision prompt, the
# proposal's description and the checks before it runs (agent_actions'
# format with a smaller action set; docs/design/AGENT_ACTIONS.md §4).
# Pure logic (no content/), so molt_ai_unittests links it. The chat
# handler (//chrome/browser/ui/webui/molt_ai) drives it.
source_set("chat_actions") {
  sources = [
    "chat_actions.cc",
    "chat_actions.h",
  ]

  public_deps = [
    ":agent_actions",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//url",
  ]

  deps = [ "//base" ]
}

# The web agent's prompt: the rules and the turn, as one raw prompt or as
# a chat with a screenshot (docs/design/AGENT_ACTIONS.md §2.6). Pure logic,
# so molt_ai_unittests links it.
source_set("agent_prompt") {
  sources = [
    "agent_prompt.cc",
    "agent_prompt.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]
}

# The web agent's screenshots, the pure part: whether to capture, the
# geometry script and its parser, masks and element tags drawn on the model
# image (docs/design/AGENT_ACTIONS.md §2.6). No content/ and no Skia, so
# molt_ai_unittests links it. The capture is AgentScreenshotter
# (//chrome/browser/molt_ai:molt_ai_agents).
source_set("agent_vision") {
  sources = [
    "agent_vision.cc",
    "agent_vision.h",
  ]

  public_deps = [
    ":agent_actions",
    "//chrome/browser/molt_ai/runtime:model_image",
  ]

  deps = [
    "//base",

    # MoltNet: cloud AI is off there (header-only, std-only).
    "//chrome/browser/molt_ai/tor:requests_policy",
    "//chrome/services/molt_ai/inference/engine:image_input",
  ]
}

# chrome://flags/#molt-agent-screenshots (about_flags.cc includes
# agent_about_flags.h).
source_set("features") {
  sources = [
    "agent_about_flags.h",
    "agent_features.cc",
    "agent_features.h",
  ]

  public_deps = [ "//base" ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "agent_actions_unittest.cc",
    "agent_prompt_unittest.cc",
    "agent_vision_unittest.cc",
    "chat_actions_unittest.cc",
  ]
  deps = [
    ":agent_actions",
    ":agent_prompt",
    ":agent_vision",
    ":chat_actions",
    "//base",
    "//chrome/browser/molt_ai/runtime:model_image",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//chrome/services/molt_ai/inference/engine:image_input",

    # Every schema the agent and the chat build must be accepted by the
    # inference service's converter; the tests run the real one (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//testing/gtest",
    "//url",
  ]
}
