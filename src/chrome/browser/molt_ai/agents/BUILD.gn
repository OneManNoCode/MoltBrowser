#
# The web agent itself (web_agent.*) and its screenshot capture
# (agent_screenshot.*) are //chrome/browser/molt_ai:molt_ai_agents.

# The agent's action format: the element snapshot, the JSON Schema the
# model decodes under, and the strict parser of its replies
# (docs/design/AGENT_ACTIONS.md). Pure logic (no content/), so
# molt_ai_unittests links it.
source_set("agent_actions") {
  sources = [
    "agent_actions.cc",
    "agent_actions.h",
  ]

  public_deps = [
    ":agent_tools",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]

  deps = [
    "//base",

    # AddSiteTools() keeps a page's tool only if the action schema with it
    # is one the inference service converts: it runs the service's own
    # converter (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
  ]
}

# Site tools (WebMCP) for the web agent: listing a page's tools, converting
# their input schemas to the grammar's subset, checking the model's
# arguments, the call scripts and when a call asks the user
# (docs/design/AGENT_ACTIONS.md §2.7). Pure logic (no content/), so
# molt_ai_unittests links it; fuzzed by molt_agent_tools_fuzzer.
source_set("agent_tools") {
  sources = [
    "agent_tools.cc",
    "agent_tools.h",
  ]

  public_deps = [ "//chrome/browser/molt_ai/security:agent_safety" ]

  deps = [
    ":hidden_chars",
    "//base",
  ]
}

# Site tools in frames of other sites: the (main origin, frame origin)
# pairs the user allowed, as a profile keeps them, the web agent's
# question, and what a call to such a frame may carry
# (docs/design/AGENT_ACTIONS.md §2.7.14). Pure logic (base), so
# molt_ai_unittests links it; fuzzed by molt_frame_tools_fuzzer. The
# profile's service is //chrome/browser/molt_ai:molt_ai_agents
# (frame_tool_permissions_service.*).
source_set("frame_tools") {
  sources = [
    "frame_tools.cc",
    "frame_tools.h",
  ]

  public_deps = [ "//base" ]

  deps = [
    ":agent_tools",
    ":hidden_chars",
    "//chrome/browser/molt_ai/security:agent_safety",

    # TextLooksSecret() and LabelSuggestsSecret(), as drafts withhold
    # secrets (pure).
    "//chrome/browser/molt_ai/automation:agent_run_draft",
  ]
}

# The characters that reorder, hide or break text, shown the same way in
# everything the agents put before the user: site-tool approvals, the
# plan, the chat's proposals and form fills. Std-only.
source_set("hidden_chars") {
  sources = [
    "hidden_chars.cc",
    "hidden_chars.h",
  ]
}

# The AI chat's page actions: when to ask, the decision prompt, the
# proposal's description and the checks before it runs (agent_actions'
# format with a smaller action set; docs/design/AGENT_ACTIONS.md §4).
# Pure logic (no content/), so molt_ai_unittests links it. The chat
# handler (//chrome/browser/ui/webui/molt_ai) drives it.
source_set("chat_actions") {
  sources = [
    "chat_actions.cc",
    "chat_actions.h",
  ]

  public_deps = [
    ":agent_actions",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//url",
  ]

  deps = [
    # No secret goes to another site's frame's tool.
    ":frame_tools",
    ":hidden_chars",
    "//base",
  ]
}

# The web agent's planner: the plan's schema and strict parser, what to do
# with a plan reply, and the run's progress through the plan (when to
# rewrite it) (docs/design/AGENT_ACTIONS.md §2.8). Pure logic (no
# content/), so molt_ai_unittests links it; fuzzed by molt_agent_plan_fuzzer.
source_set("agent_plan") {
  sources = [
    "agent_plan.cc",
    "agent_plan.h",
  ]

  # PlanSteps and ModelReply.
  public_deps = [ ":agent_actions" ]

  deps = [
    ":hidden_chars",
    "//base",
  ]
}

# The web agent's prompt: the rules and the turn, as one raw prompt or as
# a chat with a screenshot (docs/design/AGENT_ACTIONS.md §2.6), and the
# planner's request (§2.8). Pure logic, so molt_ai_unittests links it.
source_set("agent_prompt") {
  sources = [
    "agent_prompt.cc",
    "agent_prompt.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/security:agent_safety",
  ]
}

# The web agent's screenshots, the pure part: whether to capture, the
# geometry script and its parser, masks and element tags drawn on the model
# image (docs/design/AGENT_ACTIONS.md §2.6). No content/ and no Skia, so
# molt_ai_unittests links it. The capture is AgentScreenshotter
# (//chrome/browser/molt_ai:molt_ai_agents).
source_set("agent_vision") {
  sources = [
    "agent_vision.cc",
    "agent_vision.h",
  ]

  public_deps = [
    ":agent_actions",
    "//chrome/browser/molt_ai/runtime:model_image",
  ]

  deps = [
    "//base",

    # MoltNet: cloud AI is off there (header-only, std-only).
    "//chrome/browser/molt_ai/tor:requests_policy",
    "//chrome/services/molt_ai/inference/engine:image_input",
  ]
}

# chrome://flags/#molt-agent-screenshots, #molt-agent-site-tools and
# #molt-agent-planner (about_flags.cc includes agent_about_flags.h).
source_set("features") {
  sources = [
    "agent_about_flags.h",
    "agent_features.cc",
    "agent_features.h",
  ]

  public_deps = [ "//base" ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "agent_actions_unittest.cc",
    "agent_plan_unittest.cc",
    "agent_prompt_unittest.cc",
    "agent_tools_unittest.cc",
    "agent_vision_unittest.cc",
    "chat_actions_unittest.cc",
    "frame_tools_unittest.cc",
    "hidden_chars_unittest.cc",
  ]
  deps = [
    ":agent_actions",
    ":agent_plan",
    ":agent_prompt",
    ":agent_tools",
    ":agent_vision",
    ":chat_actions",
    ":frame_tools",
    ":hidden_chars",
    "//base",
    "//chrome/browser/molt_ai/runtime:model_image",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//chrome/services/molt_ai/inference/engine:image_input",

    # Every schema the agent and the chat build must be accepted by the
    # inference service's converter; the tests run the real one (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//testing/gtest",
    "//url",
  ]
}
