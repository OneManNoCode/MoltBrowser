#
# MoltBrowser cloud-provider API-key store. OSCrypt-encrypted key blob
# at ~/.moltbrowser/keys.enc. Same idiom as molt_ai/vault.

source_set("keys") {
  sources = [
    "molt_keys_store.cc",
    "molt_keys_store.h",
  ]

  deps = [
    "//base",
    "//components/os_crypt/sync",
  ]
}

# Keyring-state tests (S16): refusal without an OS-backed key; files written
# under the hard-coded key stay readable. Linked into
# //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [ "molt_keys_store_unittest.cc" ]
  deps = [
    ":keys",
    "//base",
    "//components/os_crypt/sync:test_support",
    "//testing/gtest",
  ]
}
