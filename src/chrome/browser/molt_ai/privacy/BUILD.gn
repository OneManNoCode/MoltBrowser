#
# Privacy-by-default pref values for regular profiles (third-party cookies
# blocked, WebRTC default_public_interface_only, prediction off, DNT off,
# HTTPS-First balanced, no navigation-error probes to Google, no keyless
# password leak checks). Hooked from chrome/browser/profiles/profile_impl.cc.
#
# Default feature overrides (features that only talk to Google in a keyless
# build, or download components only Google features use). Hooked from
# chrome/browser/metrics/chrome_feature_list_creator.cc.
#
# Components only Google features use, which Chromium registers at every
# start: skipped from chrome/browser/component_updater/registration.cc.
# See docs/NETWORK_TRAFFIC.md.

import("//services/on_device_model/on_device_model.gni")

source_set("privacy") {
  sources = [
    "molt_privacy_prefs.cc",
    "molt_privacy_prefs.h",
  ]

  deps = [
    "//base",
    "//chrome/common",
    "//components/content_settings/core/browser",

    # The third-party cookie default (cookie_settings.h).
    "//components/content_settings/core/browser:cookie_settings",
    "//components/content_settings/core/common",
    "//components/embedder_support",
    "//components/password_manager/core/common",
    "//components/pref_registry",
    "//components/prefs",
  ]

  # //chrome/browser depends on this target only; it reaches the feature
  # overrides through here.
  public_deps = [ ":feature_overrides" ]
}

# Kept separate (and light) so the standalone molt_ai_unittests binary can
# link it without chrome/common.
source_set("feature_overrides") {
  sources = [
    "molt_feature_overrides.cc",
    "molt_feature_overrides.h",
  ]

  deps = [
    "//chrome/browser/dictation:features",
    "//chrome/common:chrome_features",
    "//components/autofill/core/common:features",
    "//components/history_embeddings/core",
    "//components/omnibox/browser:aim_eligibility_service_features",
    "//components/omnibox/common",
    "//components/optimization_guide/core:features",
    "//components/optimization_guide/core:prediction",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/safe_browsing/core/common:features",
    "//components/translate/core/browser",
    "//media",
    "//third_party/blink/public/common",
  ]

  public_deps = [ "//base" ]
}

# Which Google-only components registration.cc skips. Depends on //base
# only, for //chrome/browser/component_updater:impl.
source_set("component_policy") {
  sources = [
    "molt_component_policy.cc",
    "molt_component_policy.h",
  ]

  public_deps = [ "//base" ]
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "molt_component_policy_unittest.cc",
    "molt_feature_overrides_unittest.cc",
  ]
  deps = [
    ":component_policy",
    ":feature_overrides",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/dictation:features",
    "//chrome/common:chrome_features",
    "//components/autofill/core/common:features",
    "//components/history_embeddings/core",
    "//components/omnibox/browser:aim_eligibility_service_features",
    "//components/omnibox/common",
    "//components/optimization_guide/core:features",
    "//components/optimization_guide/core:prediction",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/safe_browsing/core/common:features",
    "//components/translate/core/browser",
    "//media",
    "//testing/gtest",
    "//third_party/blink/public/common",
  ]
}

# The on-device model manifest is asked for on first demand, not at
# startup (the "MoltBrowser:" hooks in
# components/optimization_guide/core/model_execution/manifest_broker/).
# Built where Chrome builds the manifest broker.
if (use_on_device_model_service) {
  source_set("on_device_manifest_unit_tests") {
    testonly = true
    sources = [ "molt_on_device_manifest_unittest.cc" ]
    deps = [
      "//base",
      "//base/test:test_support",
      "//components/optimization_guide/core:features",
      "//components/optimization_guide/core:manifest_broker",

      # on_device_capability.h.
      "//components/optimization_guide/core:ondevice",
      "//components/optimization_guide/public/mojom",
      "//components/prefs:test_support",
      "//mojo/public/cpp/bindings",
      "//services/on_device_model/public/cpp",
      "//testing/gtest",
    ]
  }
}
