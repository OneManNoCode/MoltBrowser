#
# MoltBrowser password vault. Encrypted credentials store at
# ~/.moltbrowser/vault.enc, OSCrypt-backed.

source_set("vault") {
  sources = [
    "vault_host_match.cc",
    "vault_host_match.h",
    "vault_store.cc",
    "vault_store.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/molt_ai/keys",
    "//components/os_crypt/sync",
    "//net",
    "//url",
  ]
}

# Credential host-matching and keyring-state (S16) tests. Linked into
# //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "vault_host_match_unittest.cc",
    "vault_store_unittest.cc",
  ]
  deps = [
    ":vault",
    "//base",
    "//chrome/browser/molt_ai/keys",
    "//components/os_crypt/sync:test_support",
    "//testing/gtest",
    "//url",
  ]
}
