#
# The on-device runtime itself is //chrome/browser/molt_ai:molt_ai_runtime
# (BrowserAIRuntime + InferenceProcessHost, the client of the sandboxed
# //chrome/services/molt_ai/inference service).

# Checks on what the inference service sends (std-only, so the standalone
# test build links it too).
source_set("stream_validator") {
  sources = [
    "stream_validator.cc",
    "stream_validator.h",
  ]
  public_deps = [
    "//chrome/services/molt_ai/inference/engine:stream_filters",
  ]
}

# GPU inference's lasting failure record and its pipeline cache files
# (docs/design/SANDBOXED_INFERENCE.md sections 11.10 and 11.12). Std-only,
# so the standalone test build links it too.
source_set("gpu_driver_record") {
  sources = [
    "gpu_driver_record.cc",
    "gpu_driver_record.h",
    "gpu_pipeline_cache_files.cc",
    "gpu_pipeline_cache_files.h",
  ]
}

# Images for the on-device model (docs/design/SANDBOXED_INFERENCE.md
# section 10): ModelImage and how a request's images are chosen. Std-only,
# so the web AI session context (and its standalone tests) can hold images.
source_set("model_image") {
  sources = [
    "model_image.cc",
    "model_image.h",
  ]
  deps = [ "//chrome/services/molt_ai/inference/engine:image_input" ]
}

# Audio clips for the on-device model (docs/design/SANDBOXED_INFERENCE.md
# section 13): ModelAudio, how a page's decoded audio becomes one, and how a
# request's clips are chosen. Std-only, like :model_image. Nothing here or
# in the inference service decodes a compressed audio file.
source_set("model_audio") {
  sources = [
    "model_audio.cc",
    "model_audio.h",
  ]
  deps = [ "//chrome/services/molt_ai/inference/engine:audio_input" ]
}

# Making model images: Skia scales a decoded bitmap down; image files are
# decoded in Chromium's sandboxed data decoder process. Nothing here or in
# the inference service decodes a compressed image itself.
source_set("model_image_prep") {
  sources = [
    "model_image_prep.cc",
    "model_image_prep.h",
  ]
  public_deps = [
    ":model_image",
    "//base",
  ]
  deps = [
    "//chrome/services/molt_ai/inference/engine:image_input",
    "//services/data_decoder/public/cpp",
    "//skia",
    "//ui/gfx/geometry",
  ]
}

# Text embeddings for semantic memory search
# (docs/design/SEMANTIC_SEARCH.md): checks on what the embedding model sends
# (std-only, so the standalone test build links it too) ...
source_set("embedding_validator") {
  sources = [
    "embedding_validator.cc",
    "embedding_validator.h",
  ]
}

# ... and the host of its sandboxed process (UI thread).
source_set("embedding_host") {
  sources = [
    "embedding_process_host.cc",
    "embedding_process_host.h",
  ]
  public_deps = [
    ":stream_validator",
    "//base",
    "//chrome/services/molt_ai/inference/public/mojom",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
  deps = [
    ":embedding_validator",
    "//chrome/browser/lifetime:termination_notification",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "embedding_process_host_unittest.cc",
    "embedding_validator_unittest.cc",
    "gpu_driver_record_unittest.cc",
    "gpu_inference_prefs_unittest.cc",
    "inference_process_host_unittest.cc",
    "model_audio_unittest.cc",
    "model_image_prep_unittest.cc",
    "model_image_unittest.cc",
    "stream_validator_unittest.cc",
  ]
  deps = [
    ":embedding_host",
    ":embedding_validator",
    ":gpu_driver_record",
    ":model_audio",
    ":model_image",
    ":model_image_prep",
    ":stream_validator",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/molt_ai:molt_ai_runtime",
    "//chrome/services/molt_ai/inference/engine:audio_input",
    "//chrome/services/molt_ai/inference/engine:gpu_pipeline_cache",
    "//chrome/services/molt_ai/inference/engine:image_input",
    "//chrome/services/molt_ai/inference/public/mojom",
    "//components/prefs",
    "//components/prefs:test_support",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//services/data_decoder/public/cpp:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/gfx/codec",
  ]
}
