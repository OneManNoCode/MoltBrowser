#
# The web's built-in AI APIs (LanguageModel, Summarizer, Writer, Rewriter,
# Translator) served by the user's own on-device model instead of upstream's
# AIManager and TranslationManagerImpl. Hooked from
# ChromeContentBrowserClient::BindAIManager and BindTranslationManager.
# Design: docs/design/WEB_AI_APIS.md.
#
# Nothing here depends on //components/component_updater or on
# //components/on_device_translation beyond its buildflag and its pref name:
# a page's Translator can't reach TranslateKit through this code.

import("//components/on_device_translation/buildflags/features.gni")

# The decisions (availability, consent, buckets, counting, limits, which
# model), the option -> prompt mapping, the Translator's languages, pieces
# and instruction, and the per-site answers and prompt pauses with their
# stored form. Standard library only, so the standalone test build links it
# too.
source_set("logic") {
  sources = [
    "web_ai_conversation.cc",
    "web_ai_conversation.h",
    "web_ai_policy.cc",
    "web_ai_policy.h",
    "web_ai_prompts.cc",
    "web_ai_prompts.h",
    "web_ai_site_permissions.cc",
    "web_ai_site_permissions.h",
    "web_ai_translation.cc",
    "web_ai_translation.h",
  ]

  # Images and audio clips in a session's context (std-only).
  public_deps = [
    "//chrome/browser/molt_ai/runtime:model_audio",
    "//chrome/browser/molt_ai/runtime:model_image",
  ]
  deps = [
    "//chrome/services/molt_ai/inference/engine:audio_input",

    # JsonQuote() for the texts of a page-translation batch (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//chrome/services/molt_ai/inference/engine:image_input",
  ]
}

# blink.mojom.AIManager, blink.mojom.TranslationManager and the session
# interfaces, over an abstract environment (the document) and backend (the
# runtime). No //content, so molt_ai_unittests drives it over real mojo
# pipes with fakes.
source_set("manager") {
  sources = [
    "molt_ai_manager.cc",
    "molt_ai_manager.h",
    "web_ai_backend.cc",
    "web_ai_backend.h",
    "web_ai_sessions.cc",
    "web_ai_sessions.h",
    "web_ai_translator_session.cc",
    "web_ai_translator_session.h",
  ]
  public_deps = [
    ":logic",
    "//base",
    "//mojo/public/cpp/bindings",
    "//services/on_device_model/public/mojom",
    "//skia",
    "//third_party/blink/public/mojom:mojom_platform",
  ]
  deps = [
    "//chrome/services/molt_ai/inference/engine:audio_input",
    "//chrome/services/molt_ai/inference/engine:stream_filters",
  ]
}

# A profile's answers and prompt pauses over a PrefService (or in memory).
# Needs no Profile, so molt_ai_unittests tests it with a
# TestingPrefServiceSimple; the factory that creates it per profile is in
# :web_ai.
source_set("site_permissions") {
  sources = [
    "web_ai_site_permissions_service.cc",
    "web_ai_site_permissions_service.h",
  ]
  public_deps = [
    ":logic",
    "//base",
    "//components/keyed_service/core",
  ]
  deps = [
    "//components/prefs",
    "//url",
  ]
}

# The browser side: the binders ChromeContentBrowserClient calls, the
# document environment (MoltNet, policies, permissions policy, the
# top-level site), the consent infobar, the factory of the per-profile
# answers (Clear browsing data and profile reset call its hooks), the
# settings.json switch and the BrowserAIRuntime backend.
source_set("web_ai") {
  sources = [
    "molt_ai_manager_binder.cc",
    "molt_ai_manager_binder.h",
    "runtime_web_ai_backend.cc",
    "runtime_web_ai_backend.h",
    "web_ai_consent.cc",
    "web_ai_consent.h",
    "web_ai_settings_switch.cc",
    "web_ai_settings_switch.h",
    "web_ai_site_permissions_factory.cc",
    "web_ai_site_permissions_factory.h",
  ]
  public_deps = [
    ":manager",
    ":site_permissions",
  ]
  deps = [
    "//base",

    # g_browser_process (molt_ai_manager_binder.cc).
    "//chrome/browser:browser_process",

    # CreateConfirmInfoBar() (web_ai_consent.cc).
    "//chrome/browser/infobars",
    "//chrome/browser/molt_ai:molt_ai_runtime",

    # A page's images, scaled for the model on a worker.
    "//chrome/browser/molt_ai/runtime:model_image_prep",

    # Also molt_net_profile_id.h (header-only IsMoltNetProfile()).
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//components/infobars/content",
    "//components/infobars/core",
    "//components/keyed_service/core",

    # ENABLE_ON_DEVICE_TRANSLATION, for the TranslatorAPIAllowed pref name.
    "//components/on_device_translation/buildflags",
    "//components/optimization_guide/core:features",
    "//components/policy/core/common:common_constants",
    "//components/pref_registry",
    "//components/prefs",
    "//components/url_formatter",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/base",
    "//url",
  ]
  if (enable_on_device_translation) {
    # pref_names.h only (prefs::kTranslatorAPIAllowed).
    deps += [ "//components/on_device_translation:public" ]
  }
}

# Run via //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "molt_ai_manager_unittest.cc",
    "web_ai_conversation_unittest.cc",
    "web_ai_policy_unittest.cc",
    "web_ai_prompts_unittest.cc",
    "web_ai_site_permissions_service_unittest.cc",
    "web_ai_site_permissions_unittest.cc",
    "web_ai_translation_unittest.cc",
  ]
  deps = [
    ":logic",
    ":manager",
    ":site_permissions",
    "//base",
    "//base/test:test_support",

    # The Translator's response schema is checked with the converter the
    # inference service uses.
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//components/prefs:test_support",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//services/on_device_model/public/mojom",
    "//skia",
    "//testing/gtest",
    "//third_party/blink/public/mojom:mojom_platform",
    "//url",
  ]
}
