# OCR for image-only PDFs. Wraps a bundled (or system) tesseract.

source_set("ocr") {
  sources = [
    "ocr_service.cc",
    "ocr_service.h",
  ]

  # tesseract runs confined, with a deadline; ocr_service.h exposes
  # RunSandboxedTesseract() for the chat handler's image OCR.
  public_deps = [ "//chrome/browser/molt_ai/common:helper_sandbox" ]

  deps = [
    "//base",
    # Bundled or (Linux) root-owned system binary only; no Homebrew/PATH.
    "//chrome/browser/molt_ai/common:helper_binary",
    "//chrome/browser/molt_ai/common:helper_output",
  ]
}
