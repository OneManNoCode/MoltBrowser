#
# Standalone test binary for the MoltBrowser molt_ai modules.
#
# Why standalone vs. piggybacking on //chrome/test:unit_tests:
#   - chrome/test/BUILD.gn is ~13000 lines. Adding our deps there
#     means mirroring that file in src/ and merging conflicts on
#     every Chromium upgrade.
#   - The modules here are pure-CPU logic (PDF parsing, vault
#     encryption, automation step matrix). They don't need the
#     ProfileManager / RenderThread / TestingProfile setup that
#     chrome unit_tests pulls in.
#
# The runner initializes Mojo: the document parser tests talk to fakes
# over real message pipes, and BigBuffers over 64 KiB use shared memory.
# Everything else runs as it did under base's runner.
#
# Build: autoninja -C out/MoltBrowser molt_ai_unittests
# Run:   ./out/MoltBrowser/molt_ai_unittests
# Filter to one suite: ./out/MoltBrowser/molt_ai_unittests \
#                        --gtest_filter='PdfTextScraperTest.*'

import("//services/on_device_model/on_device_model.gni")
import("//testing/test.gni")
import("//third_party/llama_cpp/llama_cpp.gni")

test("molt_ai_unittests") {
  deps = [
    "//mojo/core/test:run_all_unittests",

    # Each module under molt_ai/ that has tests adds itself here.
    "//chrome/browser/molt_ai/agents:unit_tests",
    "//chrome/browser/molt_ai/automation:unit_tests",
    "//chrome/browser/molt_ai/cloud:unit_tests",
    "//chrome/browser/molt_ai/common:unit_tests",
    "//chrome/browser/molt_ai/document_parser:unit_tests",
    "//chrome/browser/molt_ai/keys:unit_tests",
    "//chrome/browser/molt_ai/memory:unit_tests",
    "//chrome/browser/molt_ai/models:unit_tests",
    "//chrome/browser/molt_ai/ocr:unit_tests",
    "//chrome/browser/molt_ai/privacy:unit_tests",
    "//chrome/browser/molt_ai/profile:unit_tests",
    "//chrome/browser/molt_ai/runtime:unit_tests",
    "//chrome/browser/molt_ai/shield:unit_tests",
    "//chrome/browser/molt_ai/vault:unit_tests",
    "//chrome/browser/molt_ai/web_ai:unit_tests",
    "//chrome/browser/molt_ai:molt_ai_dom_unit_tests",
    "//chrome/browser/molt_ai:molt_update_unit_tests",
    "//chrome/browser/molt_ai/security:unit_tests",
    "//chrome/browser/molt_ai/tor:unit_tests",
    "//chrome/browser/molt_ai/translate:unit_tests",
    "//chrome/browser/molt_ai/voice:unit_tests",
    "//chrome/browser/ui/webui/molt_ai:unit_tests",
    "//chrome/services/molt_ai/inference/engine:unit_tests",

    # The sandboxed document parser service and its PDF scraper.
    "//chrome/services/molt_ai/document_parser:unit_tests",
    "//chrome/services/molt_ai/document_parser/pdf:unit_tests",

    # MoltNet: which WebRTC networking a profile gets, and the renderer
    # switch that carries it.
    "//chrome/common/molt_ai/tor:unit_tests",

    # Fingerprinting protection: switch encoding, and the pure Blink-side
    # math (it depends only on //base and //crypto, so it runs here too).
    "//chrome/common/molt_ai/fingerprinting:unit_tests",
    "//third_party/blink/renderer/core/molt_fingerprinting:unit_tests",

    # MoltNet's portable math: the same results on every CPU and OS.
    "//skia:molt_math_unittests",
    "//third_party/llvm-libc:molt_portable_math_unittests",
    "//ui/gfx/geometry:molt_math_unittests",

    # MoltNet's microphone processing: the same samples on every CPU.
    "//media/webrtc:molt_unittests",

    # MoltNet's en-US renderer strings, checked against the en-US paks.
    "//chrome/renderer/molt_ai/fingerprinting:unit_tests",

    # MoltNet letterboxing geometry, checked against Blink's rounding.
    "//chrome/browser/molt_ai/fingerprinting:unit_tests",
  ]

  # GPU inference on Linux: what the inference service's GPU broker may
  # open.
  if (is_linux || is_chromeos) {
    deps += [ "//content/utility/on_device_model:molt_unit_tests" ]
  }

  # llama.cpp's x86-64 CPU kernel levels agree with each other (links
  # ggml's CPU backend into this test binary only).
  if (current_cpu == "x64" && !is_android && !is_ios) {
    deps += [ "//chrome/services/molt_ai/inference:x86_cpu_kernels_unittests" ]
  }

  # The GPU driver warm-up of the inference sandbox's pre-lockdown step
  # (content/utility/on_device_model/molt_gpu_driver_warmup.h).
  if (!is_android && !is_ios) {
    deps +=
        [ "//content/utility/on_device_model:molt_gpu_driver_warmup_unittests" ]
  }

  # The on-device model manifest is asked for on first demand (where Chrome
  # builds the manifest broker).
  if (use_on_device_model_service) {
    deps += [ "//chrome/browser/molt_ai/privacy:on_device_manifest_unit_tests" ]
  }

  # ggml-vulkan's packed shaders (GN switch molt_llama_vulkan).
  if (molt_llama_vulkan) {
    deps +=
        [ "//chrome/services/molt_ai/inference:vulkan_shader_pack_unittests" ]
  }
}
