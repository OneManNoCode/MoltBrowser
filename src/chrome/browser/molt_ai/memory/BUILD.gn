#
# Personal Vector Memory — opt-in on-device semantic index of pages the
# user reads. Encrypted-at-rest via OSCrypt, queryable in sub-millisecond
# time from anywhere in the browser.

# Pure, std-only logic (embedder, hot index, text chunker). Split out so the
# unit tests link without the profile / sql / OSCrypt stack.
source_set("memory_core") {
  sources = [
    "memory_embedder.cc",
    "memory_embedder.h",
    "memory_extractor.cc",
    "memory_extractor.h",
    "memory_index.cc",
    "memory_index.h",
    "memory_types.h",
  ]
}

source_set("memory") {
  sources = [
    "memory_prefs.cc",
    "memory_prefs.h",
    "memory_privacy.cc",
    "memory_privacy.h",
    "memory_recorder.cc",
    "memory_recorder.h",
    "memory_service.cc",
    "memory_service.h",
    "memory_service_factory.cc",
    "memory_service_factory.h",
    "memory_storage.cc",
    "memory_storage.h",
  ]

  public_deps = [ ":memory_core" ]

  deps = [
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/os_crypt/sync",
    "//components/pref_registry",
    "//components/prefs",
    "//content/public/browser",
    "//crypto",
    "//sql",
    "//url",
  ]
}

# Picked up by //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "memory_embedder_unittest.cc",
    "memory_index_unittest.cc",
  ]
  deps = [
    ":memory_core",
    "//testing/gtest",
  ]
}
