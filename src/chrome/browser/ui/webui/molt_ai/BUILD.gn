# MoltBrowser AI WebUI pages

source_set("molt_ai") {
  sources = [
    "molt_ai_agent_ui.cc",
    "molt_ai_agent_ui.h",
    "molt_ai_automation_ui.cc",
    "molt_ai_automation_ui.h",
    "molt_ai_chat_handler.cc",
    "molt_ai_chat_handler.h",
    "molt_ai_chat_handler_actions.cc",
    "molt_ai_chat_handler_agent_run.cc",
    "molt_ai_chat_handler_helpers.h",
    "molt_ai_chat_handler_tor.cc",
    "molt_ai_chat_handler_vault.cc",
    "molt_ai_chat_ui.cc",
    "molt_ai_chat_ui.h",
    "molt_ai_chat_ui_js.h",
    "molt_ai_memory_ui.cc",
    "molt_ai_memory_ui.h",
    "molt_ai_settings_ui.cc",
    "molt_ai_settings_ui.h",
    "molt_ai_update_ui.cc",
    "molt_ai_update_ui.h",
    "molt_ai_ui.cc",
    "molt_ai_ui.h",
    "molt_gpu_inference_handler.cc",
    "molt_gpu_inference_handler.h",
    "molt_home_ui.cc",
    "molt_home_ui.h",
    "molt_import_handler.cc",
    "molt_import_handler.h",
    "molt_import_ui.cc",
    "molt_import_ui.h",
    "molt_net_handler.cc",
    "molt_net_handler.h",
    "molt_net_ui.cc",
    "molt_net_ui.h",
    "molt_vault_handler.cc",
    "molt_vault_handler.h",
    "molt_web_ai_sites_handler.cc",
    "molt_web_ai_sites_handler.h",
    "molt_webui_csp.h",
  ]

  deps = [
    "//base",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/bookmarks",

    # The chat's per-site settings (HostContentSettingsMapFactory).
    "//chrome/browser/content_settings:content_settings_factory",

    # The vault's re-authentication on macOS and Windows.
    "//chrome/browser/device_reauth",

    # The updater's restart (application_lifetime.h).
    "//chrome/browser/lifetime",
    "//chrome/browser/molt_ai:molt_ai_agents",
    "//chrome/browser/molt_ai:molt_ai_import",
    "//chrome/browser/molt_ai:molt_ai_runtime",
    "//chrome/browser/molt_ai:molt_update",

    # The chat's page actions: one validated proposal per typed request.
    "//chrome/browser/molt_ai/agents:chat_actions",

    # ... a site tool among them only with #molt-agent-site-tools on.
    "//chrome/browser/molt_ai/agents:features",

    # /fill ai and /paste: form fills proposed the same way.
    ":chat_form_fill",
    "//chrome/browser/molt_ai/automation",
    "//chrome/browser/molt_ai/cloud",
    "//chrome/browser/molt_ai/common",
    "//chrome/browser/molt_ai/common:helper_output",
    "//chrome/browser/molt_ai/common:helper_sandbox",
    "//chrome/browser/molt_ai/document_parser",

    # Whether the installation has MoltNet's bundled fonts (molt_net_handler.cc).
    "//chrome/browser/molt_ai/fingerprinting:net_fonts",
    "//chrome/browser/molt_ai/keys",

    # The chat's saved conversations are encrypted with molt_os_crypt.
    "//chrome/browser/molt_ai/keys:os_crypt",
    "//chrome/browser/molt_ai/memory",
    "//chrome/browser/molt_ai/models:download",

    # The chat's image and voice input.
    "//chrome/browser/molt_ai/ocr",
    "//chrome/browser/molt_ai/tor",
    "//chrome/browser/molt_ai/profile",
    "//chrome/browser/molt_ai/shield:settings_handler",
    "//chrome/browser/molt_ai/vault",
    "//chrome/browser/molt_ai/voice",

    # "Sites using on-device AI" on molt://ai-settings.
    "//chrome/browser/molt_ai/web_ai",

    # The password import (ProfilePasswordStoreFactory).
    "//chrome/browser/password_manager/factories",
    "//chrome/browser/profiles:profile",

    # Tabs, windows and the side panel the chat and the agent studio open
    # and read (browser.h, browser_tabstrip.h, browser_commands.h, ...).
    "//chrome/browser/ui",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:simple_message_box_headers",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/tabs:tab_enums",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common",
    "//components/bookmarks/browser",
    "//components/device_reauth",

    # molt://memory/?q= (the @memory shortcut's query parser).
    "//components/omnibox/browser:molt_memory_query",
    "//components/password_manager/core/browser",

    # MoltNet's proxy settings (molt_ai_chat_handler.cc).
    "//components/proxy_config",
    "//components/url_formatter",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

# The AI chat's /fill ai and /paste: the prompt, the schema, the checks on
# the reply and the browser's description of a form fill
# (docs/design/AGENT_ACTIONS.md §4.7). Pure logic (no content/), so
# molt_ai_unittests links it.
source_set("chat_form_fill") {
  sources = [
    "molt_ai_chat_form_fill.cc",
    "molt_ai_chat_form_fill.h",
  ]
  public_deps = [
    "//chrome/browser/molt_ai/agents:agent_actions",
    "//chrome/browser/molt_ai/agents:chat_actions",
  ]
  deps = [
    "//base",

    # Characters that reorder or hide text, shown in the summary.
    "//chrome/browser/molt_ai/agents:hidden_chars",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//url",
  ]
}

# Pure-logic tests for the shared WebUI handler helpers (argument
# validation, the chat's window) and the chat's form fills. Linked into
# //chrome/browser/molt_ai/test:molt_ai_unittests.
source_set("unit_tests") {
  testonly = true
  sources = [
    "molt_ai_chat_form_fill_unittest.cc",
    "molt_ai_chat_handler_helpers.h",
    "molt_ai_chat_handler_helpers_unittest.cc",
  ]
  deps = [
    ":chat_form_fill",
    "//base",

    # ConsumeUserClick() (molt_ai_chat_handler_helpers.h).
    "//chrome/browser/molt_ai/common",
    "//chrome/browser/molt_ai/security:agent_safety",
    "//chrome/browser/molt_ai/tor:requests_policy",

    # Every form-fill schema must be accepted by the inference service's
    # converter; the tests run the real one (std-only).
    "//chrome/services/molt_ai/inference/engine:constrained_decoding",
    "//testing/gtest",
    "//url",
  ]
}
