#
# Renderer half of MoltShield cosmetic filtering (hide CSS + scriptlets +
# procedural filters at document start). Created per frame from
# ChromeContentRendererClient::RenderFrameCreated.
#
# procedural_filters_js.h is adapted from brave-core (MPL-2.0) and keeps its
# MPL-2.0 header.

source_set("shield") {
  sources = [
    "cosmetic_filter_agent.cc",
    "cosmetic_filter_agent.h",
    "procedural_filters_js.h",
  ]
  deps = [
    "//base",
    "//chrome/common/molt_ai/shield:features",
    "//chrome/common/molt_ai/shield:mojom",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
    "//v8",
  ]
}
