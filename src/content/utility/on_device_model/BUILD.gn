import("//build/buildflag_header.gni")
import("//services/on_device_model/on_device_model.gni")
import("//third_party/llama_cpp/llama_cpp.gni")  # MoltBrowser

source_set("on_device_model_sandbox_init") {
  sources = [
    # MoltBrowser: the switch the browser adds for a GPU launch.
    "molt_gpu_inference_switch.h",
    "on_device_model_sandbox_init.cc",
    "on_device_model_sandbox_init.h",
  ]
  deps = [
    "//base",
    "//services/on_device_model:ml_internal_buildflags",
    "//services/on_device_model:on_device_model_service",
  ]
  defines = []
  if (enable_ml_internal) {
    deps += [ "//services/on_device_model/ml" ]
  }
  if (is_linux || is_chromeos) {
    # MoltBrowser: GPU inference (docs/design/SANDBOXED_INFERENCE.md 11.4).
    sources += [
      "molt_gpu_inference_sandbox_linux.cc",
      "molt_gpu_inference_sandbox_linux.h",
    ]
    deps += [
      ":molt_gpu_inference_sandbox_policy",
      "//content/common",
      "//gpu/config",
      "//sandbox/policy",

      # MoltBrowser: the broker's permission and command types.
      "//sandbox/linux:sandbox_services",
    ]
  }
  if (is_win) {
    # MoltBrowser: GPU inference's pre-lockdown step
    # (docs/design/SANDBOXED_INFERENCE.md 11.15), called by
    # content/utility/utility_main.cc.
    sources += [
      "molt_gpu_inference_sandbox_win.cc",
      "molt_gpu_inference_sandbox_win.h",
    ]
    deps += [
      ":molt_gpu_driver_warmup",
      ":molt_gpu_inference_buildflags",
    ]
  }
  if (!is_fuchsia) {
    deps += [
      "//third_party/dawn/include/dawn:cpp_headers",
      "//third_party/dawn/src/dawn:proc",
      "//third_party/dawn/src/dawn/native",
    ]
  }
}

# MoltBrowser: whether this build has GPU inference (molt_llama_vulkan).
buildflag_header("molt_gpu_inference_buildflags") {
  header = "molt_gpu_inference_buildflags.h"
  flags = [ "MOLT_GPU_INFERENCE=$molt_llama_vulkan" ]
}

# MoltBrowser: brings each GPU's Vulkan driver up before the sandbox locks
# down (docs/design/SANDBOXED_INFERENCE.md 11.15). Standard library and the
# Vulkan headers; the loader is passed in.
source_set("molt_gpu_driver_warmup") {
  sources = [
    "molt_gpu_driver_warmup.cc",
    "molt_gpu_driver_warmup.h",
  ]
  defines = [ "VK_NO_PROTOTYPES" ]
  public_deps = [ "//third_party/vulkan-headers/src:vulkan_headers" ]
}

# MoltBrowser: part of //chrome/browser/molt_ai/test:molt_ai_unittests on
# every desktop platform.
source_set("molt_gpu_driver_warmup_unittests") {
  testonly = true
  sources = [ "molt_gpu_driver_warmup_unittest.cc" ]
  defines = [ "VK_NO_PROTOTYPES" ]
  deps = [
    ":molt_gpu_driver_warmup",
    "//testing/gtest",
  ]
}

if (is_linux || is_chromeos) {
  # MoltBrowser: what the GPU broker of the inference service may open
  # (docs/design/SANDBOXED_INFERENCE.md 11.4). Standard library only.
  source_set("molt_gpu_inference_sandbox_policy") {
    sources = [
      "molt_gpu_inference_sandbox_policy_linux.cc",
      "molt_gpu_inference_sandbox_policy_linux.h",
    ]
  }

  # MoltBrowser: part of //chrome/browser/molt_ai/test:molt_ai_unittests.
  source_set("molt_unit_tests") {
    testonly = true
    sources = [ "molt_gpu_inference_sandbox_policy_linux_unittest.cc" ]
    deps = [
      ":molt_gpu_inference_sandbox_policy",
      "//testing/gtest",
    ]
  }
}
