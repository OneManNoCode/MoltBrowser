# MoltBrowser Windows Cross-Compilation Environment
# Copyright 2025 GenEye AI Labs Inc.
#
# Cross-compiles MoltBrowser for Windows x64 from a Linux host.
# Uses Chromium's win-cross toolchain with LLVM/Clang and the Windows SDK sysroot.
#
# Build:
#   docker build -t moltbrowser-wincross -f build/docker/Dockerfile.windows-cross .
#
# Run:
#   docker run --rm -v $(pwd):/moltbrowser -w /moltbrowser moltbrowser-wincross \
#     ./scripts/configure.sh --platform windows --arch x64 && ./scripts/build.sh
#
# Note: Chromium supports cross-compiling to Windows from Linux.
# See: https://chromium.googlesource.com/chromium/src/+/main/docs/win_cross.md

FROM ubuntu:22.04

LABEL maintainer="GenEye AI Labs Inc. <build@geneye.ai>"
LABEL description="MoltBrowser Windows cross-compilation environment"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Build essentials + cross-compilation tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    lld \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    git \
    curl \
    wget \
    zip \
    unzip \
    # Wine for running Windows tests (optional)
    wine64 \
    && rm -rf /var/lib/apt/lists/*

# Install depot_tools
RUN git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools
ENV PATH="/opt/depot_tools:${PATH}"
ENV DEPOT_TOOLS_UPDATE=0
ENV DEPOT_TOOLS_WIN_TOOLCHAIN=0

# Create build user
ARG BUILD_UID=1000
ARG BUILD_GID=1000
RUN groupadd -g ${BUILD_GID} builder && \
    useradd -m -u ${BUILD_UID} -g ${BUILD_GID} builder
USER builder

WORKDIR /moltbrowser

CMD ["bash", "-c", "./scripts/configure.sh --platform windows --arch x64 && ./scripts/build.sh"]
