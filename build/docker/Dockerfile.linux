# MoltBrowser Linux Build Environment
# Copyright 2025 GenEye AI Labs Inc.
#
# Docker image for building MoltBrowser on Linux x64.
# Based on Ubuntu 22.04 LTS with all Chromium build dependencies.
#
# Build:
#   docker build -t moltbrowser-linux -f build/docker/Dockerfile.linux .
#
# Run (mount repo as volume):
#   docker run --rm -v $(pwd):/moltbrowser -w /moltbrowser moltbrowser-linux \
#     ./scripts/configure.sh --platform linux --arch x64 && ./scripts/build.sh
#
# Full release:
#   docker run --rm -v $(pwd):/moltbrowser -w /moltbrowser moltbrowser-linux \
#     ./scripts/release-linux.sh --version 0.1.0 --build 1

# Use linux/amd64 explicitly so Chromium's prebuilt x86_64 depot_tools
# binaries execute. On Apple Silicon hosts this runs via Rosetta 2.
FROM --platform=linux/amd64 ubuntu:22.04

LABEL maintainer="GenEye AI Labs Inc. <build@geneye.ai>"
LABEL description="MoltBrowser Linux build environment"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Chromium build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials
    build-essential \
    clang \
    lld \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    git \
    curl \
    wget \
    pkg-config \
    # Chromium build-time codegen tools.
    # gperf is required by //third_party/blink/renderer/platform:color_data
    # and other Blink targets that generate perfect-hash lookup tables.
    # Without it the build dies with FileNotFoundError: 'gperf' at ~step 3300.
    gperf \
    bison \
    flex \
    # Chromium library dependencies
    libgtk-3-dev \
    libglib2.0-dev \
    libnss3-dev \
    libatk1.0-dev \
    libatk-bridge2.0-dev \
    libcups2-dev \
    libdrm-dev \
    libxkbcommon-dev \
    libxcomposite-dev \
    libxdamage-dev \
    libxrandr-dev \
    libgbm-dev \
    libpango1.0-dev \
    libasound2-dev \
    libdbus-1-dev \
    libexpat1-dev \
    libfontconfig1-dev \
    libfreetype-dev \
    libnspr4-dev \
    libpulse-dev \
    libx11-xcb-dev \
    libxcb-dri3-dev \
    libxext-dev \
    libxfixes-dev \
    libxi-dev \
    libxrender-dev \
    libxtst-dev \
    # Vulkan SDK for GPU-accelerated LLM inference
    libvulkan-dev \
    vulkan-tools \
    # Packaging tools
    dpkg-dev \
    rpm \
    fakeroot \
    zip \
    # Fonts (needed for rendering tests)
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Install depot_tools (Chromium build toolchain)
RUN git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools
ENV PATH="/opt/depot_tools:${PATH}"

# Bootstrap depot_tools so Python and other prebuilt binaries get
# downloaded into /opt/depot_tools/bootstrap-*/. Without this, the
# first invocation fails with:
#   python3_bin_reldir.txt not found. need to initialize depot_tools
# We do this BEFORE freezing DEPOT_TOOLS_UPDATE so the bootstrap can
# actually run, then freeze updates so subsequent builds are reproducible.
RUN cd /opt/depot_tools && \
    ./update_depot_tools && \
    # Touch any depot_tools command so vpython/python3 wrappers populate
    # the python3_bin_reldir.txt sentinel
    ./gclient --version > /dev/null 2>&1 || true

# Disable depot_tools auto-update for builds from this image
ENV DEPOT_TOOLS_UPDATE=0

# Create build user (matching host UID/GID so volume-mounted files
# from the host are owned correctly inside the container).
#
# Caveat: on macOS the default user's primary GID is 20 (= staff),
# which collides with Ubuntu's "dialout" group. Same with a few other
# low IDs. Before creating the builder group/user, evict whatever
# preexisting Ubuntu group/user happens to own the host's GID/UID.
ARG BUILD_UID=1000
ARG BUILD_GID=1000
RUN if getent group ${BUILD_GID} >/dev/null; then \
        groupdel "$(getent group ${BUILD_GID} | cut -d: -f1)"; \
    fi && \
    if getent passwd ${BUILD_UID} >/dev/null; then \
        userdel -r "$(getent passwd ${BUILD_UID} | cut -d: -f1)" 2>/dev/null || true; \
    fi && \
    groupadd -g ${BUILD_GID} builder && \
    useradd -m -u ${BUILD_UID} -g ${BUILD_GID} builder && \
    # Give the builder user ownership of depot_tools so CIPD's selfupdate
    # and gclient's bootstrap scratch files can write into it. Without
    # this, "CIPD selfupdate failed... mktemp: Permission denied".
    chown -R builder:builder /opt/depot_tools
USER builder

WORKDIR /moltbrowser

# Default: run the build
CMD ["bash", "-c", "./scripts/configure.sh --platform linux --arch x64 && ./scripts/build.sh"]
