# MoltBrowser Build Configuration — macOS x64 (Intel)
# Copyright 2025 GenEye AI Labs Inc.
#
# Usage (repository root): ./scripts/configure.sh --platform macos --arch x64
# Or, in chromium/src:    gn gen out/MoltBrowser --args="$(cat ../../configs/macos-x64.gn)"

# Target platform
target_os = "mac"
target_cpu = "x64"

# Build type
is_official_build = true
is_debug = false

# De-Google: Remove Google API dependencies
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Disable Google-specific features
safe_browsing_mode = 1   # basic; mode=0 trips client_side_detection deps. matches macos-arm64/linux/windows
enable_reporting = false
enable_supervised_users = true   # Chromium asserts this in //chrome/test/BUILD.gn; cannot be false

# Branding
is_chrome_branded = false

# Performance
is_component_build = false
symbol_level = 0
enable_nacl = false

# Chrome extension compatibility
enable_extensions = true

# macOS-specific
use_system_xcode = true

# Metal GPU acceleration (Intel Macs with Metal support)
# (configured in llama.cpp BUILD.gn via is_mac checks)

# PGO disabled for dev builds
chrome_pgo_phase = 0
treat_warnings_as_errors = false
