# MoltBrowser Build Configuration — Linux x64
# Copyright 2025 GenEye AI Labs Inc.
#
# Usage (repository root): ./scripts/configure.sh --platform linux --arch x64
# Or, in chromium/src:    gn gen out/MoltBrowser-linux --args="$(cat ../../configs/linux-x64.gn)"
#
# Prerequisites:
#   sudo apt install libgtk-3-dev libglib2.0-dev libnss3-dev \
#     libatk1.0-dev libatk-bridge2.0-dev libcups2-dev libdrm-dev \
#     libxkbcommon-dev libxcomposite-dev libxdamage-dev libxrandr-dev \
#     libgbm-dev libpango1.0-dev libasound2-dev

# Target platform
target_os = "linux"
target_cpu = "x64"

# Build type
is_official_build = true
is_debug = false

# De-Google: Remove Google API dependencies
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Disable Google-specific features.
# Note: safe_browsing_mode and enable_supervised_users are kept at
# Chromium's defaults below because turning them off disrupts the GN
# dependency graph at gen time even though we don't ship the UI. The
# actual SafeBrowsing/reporting/supervised-user runtime behavior is
# governed by other prefs we control.
safe_browsing_mode = 1   # basic; mode=2 pulls in Android targets we don't build
enable_reporting = false
# NOTE: enable_supervised_users must stay true on Linux because
# //chrome/test:browser_tests asserts it at gn-gen time and GN evaluates
# all reachable targets even when we only build :chrome. The flag itself
# is a feature-availability switch; the actual supervised-user controls
# are governed at runtime by other flags and we don't surface any UI
# for them in MoltBrowser. Disabling here triggers:
#   ERROR at //chrome/test/BUILD.gn:60:1: Assertion failed.
enable_supervised_users = true

# Branding
is_chrome_branded = false

# Performance
is_component_build = false
symbol_level = 0
enable_nacl = false

# Chrome extension compatibility
enable_extensions = true

# Linux-specific: Ozone platform abstraction (Wayland + X11)
use_ozone = true
ozone_auto_platforms = true

# Use system libraries where available
use_sysroot = true
is_clang = true
use_lld = true

# GPU inference for on-device AI (llama.cpp's Vulkan backend, the CPU as
# fallback) is the GN switch molt_llama_vulkan, off by default until it has
# been tested on real GPUs. To try it, add:
#   molt_llama_vulkan = true
# It adds about 2.6 MB of compressed SPIR-V to the binary and a host build
# of glslang and SPIRV-Tools (shaders are compiled at build time). Mesa
# drivers (Intel, AMD) reach the GPU from the model's sandbox only through
# the render-node hook it enables. See docs/design/SANDBOXED_INFERENCE.md
# section 11.

# PGO disabled for dev builds
chrome_pgo_phase = 0
treat_warnings_as_errors = false
