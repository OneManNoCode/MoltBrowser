# MoltBrowser Build Configuration — macOS arm64 (Apple Silicon)
# Copyright 2025 GenEye AI Labs Inc.
#
# Usage: gn gen out/MoltBrowser --args="import(\"//configs/macos-arm64.gn\")"
# Or:    ./scripts/configure.sh --platform macos --arch arm64

# Target platform
target_os = "mac"
target_cpu = "arm64"

# Build type
is_official_build = true
is_debug = false

# De-Google: Remove Google API dependencies
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Disable Google-specific features
safe_browsing_mode = 0
enable_reporting = false
enable_supervised_users = false

# Branding
is_chrome_branded = false

# Performance
is_component_build = false
symbol_level = 0
enable_nacl = false

# Chrome extension compatibility
enable_extensions = true

# macOS-specific
use_system_xcode = true

# Metal GPU acceleration for LLM inference (Apple Silicon)
# (configured in llama.cpp BUILD.gn via is_mac checks)

# PGO disabled for dev builds
chrome_pgo_phase = 0
treat_warnings_as_errors = false
