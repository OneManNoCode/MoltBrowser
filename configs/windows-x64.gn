# MoltBrowser Build Configuration — Windows x64
# Copyright 2025 GenEye AI Labs Inc.
#
# Usage: gn gen out/MoltBrowser --args="import(\"//configs/windows-x64.gn\")"
# Or:    ./scripts/configure.sh --platform windows --arch x64

# Target platform
target_os = "win"
target_cpu = "x64"

# Build type
# IMPORTANT: is_official_build = false on Windows to fit in GitHub
# Actions' 6-hour per-job hard cap. Official build (with PGO + ThinLTO)
# took ~6h 15m on windows-latest and got killed at the timeout. Without
# PGO/LTO the compile drops ~30-40% to ~4 hours. Trade-off: the Windows
# binary is larger and slightly slower at runtime than the macOS/Linux
# versions — acceptable for a v0.2.1 preview release.
is_official_build = false
is_debug = false

# De-Google: Remove Google API dependencies
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# Disable Google-specific features (values mirror the proven linux-x64.gn)
safe_browsing_mode = 1   # basic; mode=0 breaks deps (report_unsafe_site needs client_side_detection), mode=2 pulls Android targets
enable_reporting = false
enable_supervised_users = true   # Chromium asserts this (//chrome/test/BUILD.gn); cannot be false

# Branding
is_chrome_branded = false

# Performance — minimal flags to fit CI time budget
is_component_build = false
symbol_level = 0
enable_nacl = false
enable_swiftshader = false   # we don't ship the software renderer fallback
blink_symbol_level = 0

# Chrome extension compatibility
enable_extensions = true

# Windows-specific
is_clang = true
use_lld = true

# Visual Studio toolchain (auto-detected)
# Set DEPOT_TOOLS_WIN_TOOLCHAIN=0 to use locally installed VS

# Vulkan GPU acceleration for LLM inference
# DirectML available as alternative on Windows
# (configured in llama.cpp BUILD.gn via is_win checks)

# PGO disabled (also implicit with is_official_build=false)
chrome_pgo_phase = 0
treat_warnings_as_errors = false
