+int64_t UsageTracker::MoltTotalUsage() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  int64_t usage = 0;
+  for (const auto& [client_type, client_tracker] : client_tracker_map_) {
+    usage += client_tracker->MoltCachedUsage();
+  }
+  return usage;
+}
