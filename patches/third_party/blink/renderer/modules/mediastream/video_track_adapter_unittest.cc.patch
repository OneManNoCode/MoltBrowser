+  EXPECT_THAT(reader->frames_read(), ElementsAre(first));
+  ReadBackMoltCameraFrames();
+  ReadBackMoltCameraFrames();
+  EXPECT_THAT(reader->frames_read(), ElementsAre(first, third));
