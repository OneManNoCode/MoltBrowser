+# MoltBrowser: MoltShield's ad/tracker blocking engine (Brave's adblock-rust,
+# MPL-2.0), used by //chrome/browser/molt_ai/shield/adblock. Pinned exactly:
+# the serialized-engine cache format is only stable within one version (see
+# ADBLOCK_CRATE_VERSION in shield/adblock/engine.rs). Default features off:
+#  - no `embedded-domain-resolver`: Chromium's registry_controlled_domains is
+#    installed via adblock::url_parser::set_domain_resolver instead of the
+#    crate's own public-suffix list;
+#  - no `single-thread`: keeps `Engine: Send + Sync` so it can be compiled on
+#    a worker thread and moved to MoltShield's engine sequence.
+# No feature pulls in networking. Vendor with scripts/vendor-rust-crates.sh.
+[dependencies.adblock]
+version = "=0.13.3"
+default-features = false
+features = ["full-regex-handling"]
