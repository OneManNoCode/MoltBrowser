+<!-- MoltBrowser: one-click browser-migration CTA. Only shown on the
+     top-level landing page (not during search, not on subpages, not on
+     the About page). Opens MoltBrowser's detected-browser import flow in a
+     new tab via the registered molt:// scheme, exactly like the sidebar
+     #importBookmarksLink. Lives in the always-visible scrolling content
+     pane so users can't miss it even in the narrow side-panel layout. -->
+<template is="dom-if" if="[[showImportCta_(inSearchMode_, lastRoute_)]]"
+    restamp>
+  <div class="import-cta-container">
+    <div id="importCta">
+      <cr-icon class="import-cta-icon" icon="cr:file-download"></cr-icon>
+      <div class="import-cta-text">
+        <div class="import-cta-title">Bring your stuff over</div>
+        <div class="import-cta-subtext">
+          Import your bookmarks and passwords from Chrome, Safari, or another
+          browser — one click, no files to export.
+        </div>
+      </div>
+      <a id="importCtaButton" href="molt://ai-settings/?section=import"
+          target="_blank"
+          title="Import bookmarks &amp; passwords from another browser">
+        <cr-button class="action-button">
+          Import from another browser
+        </cr-button>
+      </a>
+    </div>
+  </div>
+</template>
