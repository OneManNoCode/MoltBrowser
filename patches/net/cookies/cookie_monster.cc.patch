+    // Deleting the last cookie erases the partition, so neither it nor its
+    // map is used after that.
+    CookieMap& cookies = *partition_it->second;
+    CookieMap::iterator it = cookies.begin();
+    for (size_t left = cookies.size(); left > 0; --left) {
+      CookieMap::iterator current_it = it++;
