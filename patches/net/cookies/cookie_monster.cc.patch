+void CookieMonster::MoltDropNonceNow(const base::UnguessableToken& nonce,
+                                     bool refuse) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  molt_nonce_cookies_->SetRefused(nonce, refuse);
+  // The nonce's partitions are known without a pass over every partition.
+  for (const CookiePartitionKey& partition_key :
+       molt_nonce_cookies_->PartitionsOf(nonce)) {
