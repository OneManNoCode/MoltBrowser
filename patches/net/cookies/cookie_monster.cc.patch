+// MoltBrowser: see the header and molt_nonce_cookie_policy.h.
+size_t CookieMonster::MoltGarbageCollectNoncePartition(
+    base::Time current,
+    const CookiePartitionKey& cookie_partition_key,
+    const CanonicalCookie* keep) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  // A nonce's partition, or one without a nonce (its own total).
+  const std::optional<base::UnguessableToken>& nonce =
+      cookie_partition_key.nonce();
+  if (!molt_nonce_cookies_ ||
+      !molt_nonce_cookies_->OverLimits(nonce, cookie_partition_key)) {
+    return 0;
+  }
+  PartitionedCookieMap::iterator cookie_partition_it =
+      partitioned_cookies_.find(cookie_partition_key);
+  if (cookie_partition_it == partitioned_cookies_.end()) {
+    return 0;
+  }
+
+  // The partition's own cookies, other than `keep`: the expired ones go
+  // first. The partition is never emptied here, so `cookie_partition_it`
+  // stays valid (it holds `keep`, which isn't expired).
+  size_t num_deleted = 0;
+  CookieItVector candidates;
+  CookieMap& cookies = *cookie_partition_it->second;
+  for (CookieMap::iterator it = cookies.begin(); it != cookies.end();) {
+    CookieMap::iterator current_it = it++;
+    if (current_it->second.get() == keep) {
+      continue;
+    }
+    if (current_it->second->IsExpired(current) && cookies.size() > 1) {
+      InternalDeletePartitionedCookie(cookie_partition_it, current_it,
+                                      /*sync_to_store=*/true,
+                                      DELETE_COOKIE_EXPIRED);
+      ++num_deleted;
+    } else {
+      candidates.push_back(current_it);
+    }
+  }
+
+  // Then the least recently used, until neither the partition nor its nonce
+  // holds more than it may (a partition without a nonce: until it holds what
+  // its purge leaves).
+  std::sort(candidates.begin(), candidates.end(), LRACookieSorter);
+  for (CookieMap::iterator victim : candidates) {
+    if (!molt_nonce_cookies_->AboveTarget(nonce, cookie_partition_key) ||
+        cookies.size() <= 1) {
+      break;
+    }
+    InternalDeletePartitionedCookie(cookie_partition_it, victim,
+                                    /*sync_to_store=*/true,
+                                    DELETE_COOKIE_EVICTED_PER_PARTITION_DOMAIN);
+    ++num_deleted;
+  }
+  return num_deleted;
+}
