+// MoltBrowser: RFC 1929 request: VER(0x01) ULEN UNAME PLEN PASSWD.
+int SOCKS5ClientSocket::DoAuthWrite() {
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+  if (!write_buf_) {
+    std::vector<uint8_t> request;
+    request.reserve(3 + auth_username_.size() + auth_password_.size());
+    request.push_back(kSOCKS5UsernamePasswordVersion);
+    request.push_back(base::checked_cast<uint8_t>(auth_username_.size()));
+    request.insert(request.end(), auth_username_.begin(),
+                   auth_username_.end());
+    request.push_back(base::checked_cast<uint8_t>(auth_password_.size()));
+    request.insert(request.end(), auth_password_.begin(),
+                   auth_password_.end());
+    auto buffer = base::MakeRefCounted<VectorIOBuffer>(std::move(request));
+    const int size = buffer->size();
+    write_buf_ =
+        base::MakeRefCounted<DrainableIOBuffer>(std::move(buffer), size);
+  }
+  return transport_socket_->Write(write_buf_.get(),
+                                  write_buf_->BytesRemaining(), io_callback_,
+                                  traffic_annotation_);
+}
