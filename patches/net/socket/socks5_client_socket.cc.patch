+// MoltBrowser: see header. Invalid lengths leave auth disabled, so the
+// socket behaves exactly like upstream.
+void SOCKS5ClientSocket::SetUsernamePasswordAuth(std::string username,
+                                                 std::string password) {
+  DCHECK_EQ(STATE_NONE, next_state_);
+  DCHECK(!completed_handshake_);
+  if (username.empty() || username.size() > 0xFF || password.empty() ||
+      password.size() > 0xFF) {
+    auth_username_.clear();
+    auth_password_.clear();
+    return;
+  }
+  auth_username_ = std::move(username);
+  auth_password_ = std::move(password);
+}
