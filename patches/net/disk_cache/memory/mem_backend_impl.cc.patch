+bool MemBackendImpl::HasExceededStorageSize(const MemEntryImpl* entry) const {
+  if (!MoltHasBudget()) {
+    return HasExceededStorageSize();
+  }
+  return MoltCacheWriteRefused(MoltSiteSize(MoltSiteOf(entry)), current_size_,
