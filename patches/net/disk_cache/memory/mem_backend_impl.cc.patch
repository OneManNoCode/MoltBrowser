+std::string_view MemBackendImpl::MoltSiteOf(const MemEntryImpl* entry) {
+  const MemEntryImpl* parent =
+      entry->type() == MemEntryImpl::EntryType::kChild ? entry->parent()
+                                                       : entry;
+  return MoltHttpCacheSiteOfKey(parent->key());
+}
