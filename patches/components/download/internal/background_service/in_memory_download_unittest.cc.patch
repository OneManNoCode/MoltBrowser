+// MoltBrowser: a Background Fetch request of a site.
+RequestParams MoltNetFetchParams() {
+  RequestParams request_params;
+  request_params.url = GURL("https://cdn.example/movie");
+  const url::Origin site = url::Origin::Create(GURL("https://a.example"));
+  request_params.isolation_info = net::IsolationInfo::Create(
+      net::IsolationInfo::RequestType::kOther, site, site,
+      net::SiteForCookies::FromOrigin(site));
+  return request_params;
+}
+
+// MoltBrowser: in MoltNet the response counts against the blob share of the
+// site that started the fetch as it arrives, and then becomes the blob,
+// counted once.
+TEST_F(InMemoryDownloadTest, MoltNetResponseWithinTheSitesShare) {
+  MoltUseShares(1024 * 1024);
+  RequestParams request_params = MoltNetFetchParams();
+  CreateDownload(request_params);
+  const std::string data(300 * 1024, 'x');
+  url_loader_factory()->AddResponse(request_params.url.spec(), data);
+
+  download()->Start();
+  delegate()->WaitForCompletion();
+  EXPECT_EQ(InMemoryDownload::State::COMPLETE, download()->state());
+  auto blob = download()->ResultAsBlob();
+  VerifyBlobData(data, blob.get());
+  EXPECT_EQ(MoltBlobMemoryUsed(), data.size());
+}
+
+// MoltBrowser: a response past its site's share fails before it is all in
+// memory, as one its share can't hold as a blob does, and nothing of it
+// stays counted.
+TEST_F(InMemoryDownloadTest, MoltNetResponsePastTheSitesShareFails) {
+  MoltUseShares(128 * 1024);
+  RequestParams request_params = MoltNetFetchParams();
+  CreateDownload(request_params);
+  url_loader_factory()->AddResponse(request_params.url.spec(),
+                                    std::string(2 * 1024 * 1024, 'x'));
+
+  download()->Start();
+  delegate()->WaitForCompletion();
+  EXPECT_EQ(InMemoryDownload::State::FAILED, download()->state());
+  EXPECT_EQ(MoltBlobMemoryUsed(), 0u);
+}
