+// MoltBrowser: what freeing `area` frees at once: its map's items and bytes
+// if no other namespace's area shares the map and it isn't freed a chunk a
+// task anyway (molt_dom_storage_split_work.h).
+std::pair<size_t, size_t> MoltFreedAtOnce(SessionStorageAreaImpl& area) {
+  SessionStorageDataMap* map = area.data_map();
+  if (!map || !map->HasOneRef() || !map->storage_area()) {
+    return {0, 0};
+  }
+  const StorageAreaImpl& storage_area = *map->storage_area();
+  const size_t items = storage_area.molt_item_count();
+  const size_t bytes = storage_area.storage_used();
+  if (MoltDomStorageFreesInChunks(items, bytes)) {
+    return {0, 0};
+  }
+  return {items, bytes};
+}
