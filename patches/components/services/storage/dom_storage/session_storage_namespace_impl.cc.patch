+bool SessionStorageNamespaceImpl::MoltFreeAreasChunk() {
+  size_t areas = 0;
+  size_t items = 0;
+  size_t bytes = 0;
+  while (!storage_key_areas_.empty() &&
+         !MoltDomStorageFreeStepIsFull(areas, items, bytes)) {
+    auto first = storage_key_areas_.begin();
+    const auto [area_items, area_bytes] = MoltFreedAtOnce(*first->second);
+    storage_key_areas_.erase(first);
+    ++areas;
+    items += area_items;
+    bytes += area_bytes;
+  }
+  return !storage_key_areas_.empty();
