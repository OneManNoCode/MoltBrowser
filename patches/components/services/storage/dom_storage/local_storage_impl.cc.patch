+    if (MoltMayDrop(*it->second) &&
+        MoltDomStorageAreaExpired(
+            (now - it->second->molt_unused_since()).InSeconds())) {
+      it = areas_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
