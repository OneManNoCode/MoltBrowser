+  molt_idle_sweep_.Start(
+      FROM_HERE, base::Seconds(kMoltDomStorageSweepIntervalSeconds),
+      base::BindRepeating(&LocalStorageImpl::MoltSweepIdleAreas,
+                          base::Unretained(this)));
