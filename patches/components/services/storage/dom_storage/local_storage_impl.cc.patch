+void LocalStorageImpl::MoltAreaUnused(const blink::StorageKey& storage_key) {
+  if (!MoltDomStorageDropsUnusedArea(molt_caches_per_site_,
+                                     database_ != nullptr)) {
+    return;
+  }
+  scoped_refptr<base::SequencedTaskRunner> runner =
