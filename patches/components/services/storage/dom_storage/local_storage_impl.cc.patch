+// MoltBrowser:
+void LocalStorageImpl::MoltKeepCachesPerSiteOn(
+    scoped_refptr<MoltDomStorageFairScheduler> scheduler) {
+  if (molt_caches_per_site_) {
+    return;
+  }
+  molt_caches_per_site_ = true;
+  molt_scheduler_ =
+      scheduler ? std::move(scheduler)
