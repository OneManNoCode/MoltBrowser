+// MoltBrowser: see session_storage_control.mojom.
+void SessionStorageImpl::MoltDropNonce(const base::UnguessableToken& nonce,
+                                       bool closed) {
+  if (!molt_caches_per_site_ || !molt_scheduler_) {
