+  size_t site_unused_maps = 0;
+  size_t site_cache_bytes = 0;
+  for (const auto& [map_id, data_map] : data_maps_) {
+    if (MoltDomStorageSiteOf(data_map->map_locator().storage_key()) !=
+        site) {
