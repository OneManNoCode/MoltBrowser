+// MoltBrowser: true iff |host| is a name under the special-use ".onion"
+// domain (RFC 7686), i.e. ends in ".onion" after at least one label, ASCII
+// case-insensitively, ignoring trailing dots. Like
+// molt_ai::tor::IsOnionHost() (chrome/browser/molt_ai/tor/onion_util.h, which
+// components/ can't depend on), except that the bare word "onion" doesn't
+// count: it names no service, and people search for it.
+bool NamesOnionService(std::string_view host) {
+  while (!host.empty() && host.back() == '.') {
+    host.remove_suffix(1);
+  }
+  static constexpr std::string_view kDotOnion = ".onion";
+  return host.size() > kDotOnion.size() &&
+         base::EndsWith(host, kDotOnion, base::CompareCase::INSENSITIVE_ASCII);
+}
+
+// MoltBrowser: true iff |input| names a Tor onion service, judged by both the
+// canonicalized URL and the raw host the user typed.
+bool InputNamesOnionHost(const AutocompleteInput& input) {
+  if (input.canonicalized_url().is_valid() &&
+      NamesOnionService(input.canonicalized_url().host())) {
+    return true;
+  }
+  const std::u16string_view text = input.text();
+  const url::Component& host = input.parts().host;
+  if (!host.is_nonempty() || host.begin < 0 ||
+      static_cast<size_t>(host.end()) > text.size()) {
+    return false;
+  }
+  return NamesOnionService(base::UTF16ToUTF8(text.substr(
+      static_cast<size_t>(host.begin), static_cast<size_t>(host.len))));
+}
