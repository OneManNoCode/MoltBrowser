+// MoltBrowser:
+void BackgroundFetchScheduler::MoltSchedulePerSite(
+    base::RepeatingClosure on_growth_beyond_floor) {
+  if (molt_sites_) {
+    return;
+  }
+  molt_sites_ = std::make_unique<MoltBackgroundFetchSites>();
+  molt_on_growth_beyond_floor_ = std::move(on_growth_beyond_floor);
+  // No total for all sites: each site's own limits are the policy's.
+  max_running_downloads_ = std::numeric_limits<int>::max();
+}
+
+// MoltBrowser: as ScheduleDownload(), per site
+// (molt_background_fetch_site_policy.h), for `site` only: nothing another
+// site runs or keeps waiting changes what starts, or what this costs.
+void BackgroundFetchScheduler::MoltSchedule(const std::string& site) {
+  // 1. The site's pending registrations become active while it has room, in
+  //    the order they were made; as in Chromium, one per storage key.
+  for (const std::string& unique_id : molt_sites_->Activate(site)) {
+    auto job = job_controllers_.find(unique_id);
+    if (job == job_controllers_.end()) {
+      molt_sites_->Remove(unique_id);
+      continue;
+    }
+    active_controllers_.push_front(job->second.get());
+    ++num_active_registrations_;
+    LogBackgroundFetchEventForDevTools(Event::kFetchScheduled,
+                                       job->second->registration_id(),
+                                       /* request_info= */ nullptr);
+  }
+
+  // 2. Its requests start while it has room, from its active registrations
+  //    in turn (the one served least recently first).
+  const auto has_more = [this](const std::string& unique_id) {
+    auto job = job_controllers_.find(unique_id);
+    return job != job_controllers_.end() && job->second->HasMoreRequests();
+  };
+  while (std::optional<std::string> unique_id =
+             molt_sites_->NextToStart(site, has_more)) {
+    BackgroundFetchJobController* controller =
+        job_controllers_[*unique_id].get();
+    ++num_running_downloads_;
+    if (molt_sites_->Started(site) && molt_on_growth_beyond_floor_) {
+      molt_on_growth_beyond_floor_.Run();
+    }
+    controller->PopNextRequest(
+        base::BindOnce(&BackgroundFetchScheduler::DidStartRequest,
+                       weak_ptr_factory_.GetWeakPtr()),
+        base::BindOnce(&BackgroundFetchScheduler::DidCompleteRequest,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+}
