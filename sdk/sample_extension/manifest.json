{
  "manifest_version": 3,
  "name": "MoltBrowser AI Sample Extension",
  "version": "1.0.0",
  "description": "Sample extension demonstrating the browser.ai.* API",
  "permissions": [
    "ai",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
